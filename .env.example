# Environment variables for morphicsmusic.com (Cloudflare Pages Functions).
# Set real values via `wrangler pages secret put <NAME>` for production —
# never commit an actual .env with real secrets.

# --- Existing (magic-link auth, checkout, etc.) ---
AUTH_SECRET=                # HMAC key that signs session cookies. Generate: openssl rand -base64 32
RESEND_API_KEY=             # Resend API key for outbound transactional email
ORDER_FROM_EMAIL=           # From address for order/login emails (defaults to orders@morphicsmusic.com)
PUBLIC_SITE_URL=            # Canonical site origin, e.g. https://morphicsmusic.com
TURNSTILE_SECRET_KEY=       # Cloudflare Turnstile secret key (optional; challenge is skipped if unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTFUL_API_KEY=

# --- Username/password auth (functions/_lib/password.ts) ---
# Peppers every password hash. Deliberately SEPARATE from AUTH_SECRET so
# rotating session-signing keys never invalidates stored passwords.
# Generate: openssl rand -base64 32
# Fails closed: hashPassword/verifyPassword throw if this is missing rather
# than silently hashing unpeppered.
PASSWORD_PEPPER=

# PBKDF2-HMAC-SHA256 iteration count. Defaults to 12000 if unset. Measured at
# ~0.59ms per 1,000 iterations on this runtime, so 12000 ≈ 7ms — well inside
# Cloudflare Free's 10ms CPU-per-request cap, leaving headroom for JSON
# parsing, KV reads, and the pepper HMAC. Raise this later by bumping the
# number here; existing hashes keep verifying and transparently re-hash at
# the new cost on next successful login (see verifyPassword's needsRehash).
PASSWORD_KDF_ITERATIONS=12000
