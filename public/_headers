# Strict defaults for every response. Per-path blocks below override.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://checkout.stripe.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://*.bcbits.com https://files.cdn.printful.com https://www.tiktok.com https://*.tiktokcdn.com https://i1.sndcdn.com; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.tiktok.com https://bandcamp.com https://*.bandcamp.com https://js.stripe.com https://challenges.cloudflare.com; connect-src 'self' https://api.stripe.com https://challenges.cloudflare.com; frame-src 'self' https://www.tiktok.com https://bandcamp.com https://*.bandcamp.com https://checkout.stripe.com https://challenges.cloudflare.com; media-src 'self' https://*.bcbits.com https://*.tiktokcdn.com; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; upgrade-insecure-requests

# API responses must never be cached by browsers or intermediaries.
# Access-Control-Allow-Origin is intentionally NOT set here — each /api/*
# function applies it dynamically via functions/_lib/cors.ts so the value
# can be echoed back to the verified origin (with Vary: Origin), which is
# required when Allow-Credentials is true and what enables www. and
# preview deploys to call the API correctly.
/api/*
  Cache-Control: no-store

# Personalized / authenticated pages must never be cached by browsers or
# intermediaries — they contain per-user purchase data.
/library
  Cache-Control: no-store
/library/*
  Cache-Control: no-store
/download
  Cache-Control: no-store
/download/*
  Cache-Control: no-store
/order-complete
  Cache-Control: no-store
/order-complete/*
  Cache-Control: no-store
/login
  Cache-Control: no-store
/login/*
  Cache-Control: no-store
/signup
  Cache-Control: no-store
/signup/*
  Cache-Control: no-store
/account
  Cache-Control: no-store
/account/*
  Cache-Control: no-store

# Fan-only surfaces: never cached, never indexed. The API already returns 401
# to signed-out callers; X-Robots-Tag stops the shells being indexed too.
/community
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/community/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# scripts/subset-icon-font.mjs content-hashes this file's name, so a changed
# font is a new URL — the only way to get new bytes is a new filename, which
# is what makes a long-lived immutable cache safe here. (Before the hash, a
# stale unhashed URL is exactly how the "diversity_3" nav icon bug shipped:
# returning visitors kept the old font, which had no glyph for the icon, long
# after the deploy that added it.) Matches the immutable Cache-Control already
# used for /api/preview and /api/social-media/[key].
# SCOPED TO THE HASHED FILE ON PURPOSE. Only MaterialSymbols-Subset carries a
# content hash in its name, so only it can safely be pinned forever — a change
# produces a new URL. The other faces (Rubik, GeistMono, Inter, SpaceGrotesk,
# MorphianTrial) still have stable filenames, and a blanket /fonts/* immutable
# rule would freeze a stale copy in every returning visitor's browser for a
# year. That is precisely the bug this commit exists to fix; do not widen this
# glob until those fonts are hashed too.
/fonts/MaterialSymbols-Subset.*
  Cache-Control: public, max-age=31536000, immutable
