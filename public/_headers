# Strict defaults for every response. Per-path blocks below override.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://checkout.stripe.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.tiktok.com https://bandcamp.com https://*.bandcamp.com https://js.stripe.com; connect-src 'self' https://api.stripe.com; frame-src 'self' https://www.tiktok.com https://bandcamp.com https://*.bandcamp.com https://*.tiktokcdn.com https://checkout.stripe.com; media-src 'self' https://*.bcbits.com https://*.tiktokcdn.com; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'

# API responses must never be cached by browsers or intermediaries.
# Access-Control-Allow-Origin is intentionally NOT set here — each /api/*
# function applies it dynamically via functions/_lib/cors.ts so the value
# can be echoed back to the verified origin (with Vary: Origin), which is
# required when Allow-Credentials is true and what enables www. and
# preview deploys to call the API correctly.
/api/*
  Cache-Control: no-store

# Personalized / authenticated pages must never be cached by browsers or
# intermediaries — they contain per-user purchase data.
/library
  Cache-Control: no-store
/library/*
  Cache-Control: no-store
/download
  Cache-Control: no-store
/download/*
  Cache-Control: no-store
/order-complete
  Cache-Control: no-store
/order-complete/*
  Cache-Control: no-store
/login
  Cache-Control: no-store
/login/*
  Cache-Control: no-store
