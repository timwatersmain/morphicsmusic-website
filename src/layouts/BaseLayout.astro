---
import TopNav from '../components/TopNav.astro';
import CornerAccents from '../components/CornerAccents.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import Cart from '../components/Cart.astro';
import PlayerBar from '../components/PlayerBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  currentPage?: string;
  clean?: boolean;
}

const { title, currentPage = '', clean = false } = Astro.props;
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} // MORPHICS</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <!-- Both text fonts are self-hosted (see global.css) and preloaded, so
       everything that sets the page's text metrics is on our own origin and
       arrives with the CSS instead of after a third-party handshake — that
       round trip is what made the nav and headings reflow seconds after first
       paint. Space Grotesk was being requested here and used by nothing.
       Only the icon font still comes from Google, so warm that connection. -->
  <link rel="preload" href="/fonts/Rubik-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- display=block, not swap: these are ligature icons, so with swap the raw
       ligature text ("shopping_cart") lays out at word width first and then
       collapses to a glyph, which is the nav twitching a second in. block
       keeps them invisible until the font is there, so nothing reflows. -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet" />
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 24;
    }
  </style>
</head>
<body class="neural-bg min-h-screen font-body text-on-surface overflow-x-hidden">
  <ParticleBackground />
  <TopNav currentPage={currentPage} />
  {!clean && <CornerAccents />}

  <main class="relative z-10 pt-24 pb-24 px-8">
    <slot />
  </main>

  <Cart />
  <PlayerBar />

  <script>
    import '../scripts/preview-player.js';
  </script>
</body>
</html>
