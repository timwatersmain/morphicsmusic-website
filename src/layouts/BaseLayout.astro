---
import TopNav from '../components/TopNav.astro';
import SideNav from '../components/SideNav.astro';
import BottomNav from '../components/BottomNav.astro';
import CornerAccents from '../components/CornerAccents.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  currentPage?: string;
  showSidebar?: boolean;
}

const { title, currentPage = '', showSidebar = true } = Astro.props;
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} // MORPHICS</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=Geist+Mono:wght@100..900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 24;
    }
  </style>
</head>
<body class="neural-bg min-h-screen font-body text-on-surface overflow-x-hidden">
  <ParticleBackground />
  <TopNav currentPage={currentPage} />
  {showSidebar && <SideNav currentPage={currentPage} />}
  <CornerAccents />

  <main class:list={[
    "relative z-10",
    showSidebar ? "pt-32 pb-24 lg:pl-64 px-8" : ""
  ]}>
    <slot />
  </main>

  <BottomNav currentPage={currentPage} />
</body>
</html>
