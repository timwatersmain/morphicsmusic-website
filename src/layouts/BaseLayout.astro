---
import { ClientRouter } from 'astro:transitions';
import TopNav from '../components/TopNav.astro';
import Cart from '../components/Cart.astro';
import PlayerBar from '../components/PlayerBar.astro';
import LiquidBackground from '../components/LiquidBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  currentPage?: string;
  /**
   * Drop the breathing room reserved under the nav for a page title.
   *
   * That space exists so headings are not jammed against the bar, but the
   * landing page has no page title — it has a hero sized to the viewport, and
   * the extra padding pushed it past the fold and put a scrollbar on the
   * front page.
   */
  flushTop?: boolean;
  /** Overrides the shared description in the link preview and in search results. */
  description?: string;
  /** Site-root-relative path to a 1200x630 share image, if this page has its own. */
  ogImage?: string;
}

const {
  title,
  currentPage = '',
  flushTop = false,
  description = 'Electronic music, audiovisual work and releases from MORPHICS. The only constant is change.',
  ogImage = '/images/og/og-default.jpg',
} = Astro.props;

/* The canonical origin, written out rather than taken from Astro.site — there
   is no `site` in astro.config, so Astro.site is undefined and every absolute
   URL built from it would silently come out broken. og:image in particular
   MUST be absolute; a relative one is simply dropped by most scrapers. */
const SITE = 'https://morphicsmusic.com';

/* The landing page passes title="MORPHICS", and the old template appended the
   brand unconditionally — so the share card read "MORPHICS // MORPHICS". */
const pageTitle = title === 'MORPHICS' ? 'MORPHICS' : `${title} // MORPHICS`;
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonical} />

  <!-- Link preview / social card.
       The site had NO Open Graph tags at all, so iMessage, Slack, Discord and
       every other unfurler fell back to scraping the page: it took the <title>
       (which read "MORPHICS // MORPHICS") and picked the first sizeable image
       it found, which was the white-on-transparent wordmark PNG. Composited
       onto iMessage's white bubble that turned into pale grey on white, cropped
       at both ends, with no description under it.

       og:image is therefore a purpose-built 1200x630 JPEG with its own opaque
       dark background — a transparent PNG can never be safe here, because the
       colour behind it belongs to whatever app is drawing the card. -->
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MORPHICS" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="MORPHICS — the only constant is change" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <!-- Both text fonts are self-hosted (see global.css) and preloaded, so
       everything that sets the page's text metrics is on our own origin and
       arrives with the CSS instead of after a third-party handshake — that
       round trip is what made the nav and headings reflow seconds after first
       paint. Space Grotesk was being requested here and used by nothing.
       The icon font is now self-hosted too — see the note on .icon below. -->
  <link rel="preload" href="/fonts/Rubik-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/MaterialSymbols-Subset.f6cb80fd.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Morphian (avatar glyph face, src/styles/global.css) is only used inside
       inline SVGs on the community pages, but font-display: block means an
       unpreloaded first request would delay that block window even further —
       preload it here the same as the other self-hosted faces. -->
  <link rel="preload" href="/fonts/MorphianTrial-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Swaps the page in place instead of a full reload, so PlayerBar's
       <audio> (transition:persist, below) survives navigation instead of
       being torn down mid-track. Astro auto-disables the CSS transition
       animation itself for prefers-reduced-motion — nothing extra needed
       here for that. Every page script that assumed "runs once per real
       load" has been individually audited and re-wired onto astro:page-load
       / astro:before-swap (see preview-player.js, title-morph.js,
       ScrambleGrid.astro, TopNav.astro and each page's own script) rather
       than left to the old top-level-execution-once assumption, which the
       client router breaks silently (a script that already ran is never
       re-run just because its markup reappears). /login, /signup, /account
       and /library are exempted (data-astro-reload on the links that reach
       them) — see the note on TopNav's account link and login/signup's
       cross-links for why. -->
  <ClientRouter />
  <!-- is:global is REQUIRED, not stylistic. Astro scopes a plain <style> to the
       component it appears in, and every .material-symbols-outlined lives in
       TopNav / Cart / PlayerBar, never in this file — so a scoped rule matches
       nothing and the icons silently fall back to literal ligature text. (The
       old font-variation-settings block here was scoped too, and had therefore
       never applied; the font-family it needed came from Google's own global
       stylesheet.) -->
  <style is:global>
    /* Self-hosted and subset to the ~40 icons the site uses (1.1MB -> 10KB) by
       scripts/subset-icon-font.mjs. Previously this came from Google, and that
       round trip is what put "graphic_eqgrid_viewstorefrontsensors" across the
       top of the page on mobile: Material Symbols are LIGATURE icons, so the
       markup contains the literal words and any moment the font isn't ready is
       a moment those words are real text laid out in the fallback face.
       font-display: block only covers its own ~3s block period — on a slow
       connection the font missed that window and the fallback painted anyway. */
    @font-face {
      font-family: 'Material Symbols Outlined';
      font-style: normal;
      font-weight: 100 700;
      font-display: block;
      src: url('/fonts/MaterialSymbols-Subset.f6cb80fd.woff2') format('woff2');
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: normal;
      font-style: normal;
      font-size: 24px;
      line-height: 1;
      letter-spacing: normal;
      text-transform: none;
      display: inline-block;
      white-space: nowrap;
      word-wrap: normal;
      direction: ltr;
      font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 24;
    }

    /* Belt and braces: never let the ligature text paint, whatever the network
       does. The glyph is transparent until the font is confirmed loaded (see
       the inline script below), so a failure or a timeout degrades to a blank
       square rather than to a run-on line of code. Space is still reserved, so
       revealing the icons reflows nothing.
       :not(.fonts-ready) rather than a .fonts-pending class, so the icons are
       hidden from the very first paint without waiting for any script. */
    html:not(.fonts-ready) .material-symbols-outlined { color: transparent; }
  </style>
  <script is:inline data-astro-rerun>
    // Before first paint: if the previous page left a title behind, this page's
    // <h1> must start hidden so the word never flashes into place before the
    // particles have assembled it. title-morph.js clears the class when the
    // morph lands — or immediately, if it decides not to run.
    // data-astro-rerun: under the client router this must run again on every
    // swap (a fresh <h1> arrives each time), not just on the first real load
    // — is:inline scripts are otherwise only executed once, same as bundled
    // ones. See title-morph.js's own doc comment for the matching change on
    // the "record what's leaving" side.
    (function () {
      try {
        if (!sessionStorage.getItem('morphics:title-from')) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('title-morphing');
      } catch (e) { /* private mode: just show the title */ }
    })();
  </script>
  <script is:inline data-astro-rerun>
    // data-astro-rerun is LOAD-BEARING, not tidiness. The client router swaps
    // the document element, and `fonts-ready` is a class ON <html> — so every
    // in-app navigation arrives with the class gone. An is:inline script runs
    // only once without this attribute, so nothing ever put the class back:
    // icons were transparent on every page until the visitor hit reload, which
    // did a real document load and re-ran the script. Reproduced by diffing a
    // direct load against the same page reached by clicking the nav.
    //
    // Re-running is cheap and does not re-flash: the head survives the swap, so
    // the face is still loaded, `loaded()` is true on the first poll, and the
    // class is restored before the swapped document paints.
    //
    // Runs before first paint. Icons are revealed ONLY once the face is
    // confirmed usable — there is deliberately no timeout that reveals them
    // anyway. If the font never arrives, the icons stay blank forever, because
    // a blank slot next to a "MUSIC" label is a far better failure than the
    // nav spelling out "graphic_eqgrid_viewstorefront". The only unconditional
    // reveal is for a browser with no CSS Font Loading API, where we cannot
    // tell the two states apart.
    (function () {
      var FONT = '24px "Material Symbols Outlined"';
      var reveal = function () { document.documentElement.classList.add('fonts-ready'); };
      if (!document.fonts || !document.fonts.check) { reveal(); return; }
      // Poll rather than awaiting a single fonts.load(). This script runs before
      // Astro's bundled stylesheet, so at this point the @font-face is not yet
      // registered and a one-shot load() resolves with an empty list — it looks
      // identical to a failure, and the icons would stay hidden forever on a
      // perfectly good page. Polling check() waits for the face to appear AND
      // finish loading. It gives up after ~10s without revealing, so a genuinely
      // missing font still never paints ligature text.
      // The test is the FACE's own status, not fonts.check(): check() reports
      // whether text can be painted, and it answers true once a face has FAILED
      // and the browser has settled on the fallback — precisely the case we must
      // not reveal on.
      var loaded = function () {
        var ok = false;
        document.fonts.forEach(function (f) {
          if (f.family === 'Material Symbols Outlined' && f.status === 'loaded') ok = true;
        });
        return ok;
      };
      var t0 = Date.now();
      (function poll() {
        if (loaded()) { reveal(); return; }
        document.fonts.load(FONT, 'close').catch(function () {});
        if (Date.now() - t0 < 10000) setTimeout(poll, 100);
      })();
    })();
  </script>
  <!-- Per-page <head> additions (robots meta, page-specific tags). -->
  <slot name="head" />
</head>
<body class="neural-bg min-h-screen font-body text-on-surface overflow-x-hidden">
  <!-- First child of <body> and z-0, so it sits under <main> (z-10) and under
       the nav / cart / player bar without any of them needing a z-index change.
       neural-bg's flat #131313 stays as the ground beneath it, which is what
       paints if the canvas or its script never arrives.

       Mounted on EVERY page including the landing one, where it is hidden and
       stopped rather than absent — currentPage only suppresses its first
       paint. Rendering it conditionally would break it, see the component. -->
  <LiquidBackground currentPage={currentPage} />

  <TopNav currentPage={currentPage} />

  <!-- pt tracks the fixed header's height and has to be changed WITH it:
       the header is out of flow, so this padding is the only thing keeping
       content from starting underneath it. Mobile keeps pt-24; only the
       desktop bar got shorter. -->
  <main class={`relative z-10 pt-24 pb-24 px-8 ${flushTop ? "lg:pt-[5.4rem]" : "lg:pt-[7.3rem]"}`}>
    <slot />
  </main>

  <Cart />
  <PlayerBar />

  <script>
    import '../scripts/preview-player.js';
  </script>
  <!-- Its own module, deliberately. Sharing one with preview-player meant an
       import-time failure there would stop initTitleMorph() from ever running —
       and since the <h1> starts hidden when a morph is pending, that leaves the
       page title invisible. Separate modules fail independently. -->
  <script>
    import { initTitleMorph } from '../scripts/title-morph.js';
    initTitleMorph();
  </script>
  <!-- Its own module too, same isolation reasoning as title-morph above.
       Signed-out visitors cost nothing here — see the module doc comment. -->
  <script>
    import '../scripts/engagement-tracker.js';
  </script>
</body>
</html>
