---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="MY COMMUNITY" currentPage="/community">
  <div class="max-w-4xl mx-auto pb-24">
    <header class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="font-mono text-xs text-secondary uppercase tracking-widest">Community</span>
        <h1 class="font-headline font-bold text-5xl md:text-7xl text-primary uppercase tracking-tighter leading-none mt-2">YOUR PROFILE</h1>
        <p id="me-handle" class="font-mono text-[11px] text-white/50 mt-4"></p>
      </div>
      <div class="flex gap-3">
        <a href="/community" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">
          View fan wall
        </a>
      </div>
    </header>

    <div id="me-loading" class="font-mono text-[11px] text-white/40">Loading your profile…</div>

    <div id="me-signin" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
        Sign in to see your collection and pick your avatar.
      </p>
      <a href={`/login?redirect=${encodeURIComponent('/community/me')}`} data-astro-reload class="inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
        Sign in
      </a>
    </div>

    <div id="me-error" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p id="me-error-msg" class="font-mono text-[11px] text-white/40 leading-relaxed"></p>
    </div>

    <div id="me-content" class="hidden space-y-12">
      <section class="border border-white/5 p-6">
        <div class="flex items-center gap-6 mb-6">
          <!-- The creature (pixel-sprite) render is this fan's primary
               avatar, replacing the glyph medallion — see creature-avatar.js. -->
          <div id="me-creature"></div>
          <div class="flex-1">
            <label class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Display name</label>
            <div class="flex gap-2">
              <input
                id="me-name-input"
                type="text"
                maxlength="40"
                class="flex-1 px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-sm text-primary"
              >
              <button id="me-name-save" class="px-4 py-3 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
                Save
              </button>
            </div>
            <p id="me-name-status" class="font-mono text-[10px] text-white/30 mt-2 h-4"></p>

            <label class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mt-6 mb-2">Handle</label>
            <div class="flex gap-2">
              <span class="flex items-center px-3 font-mono text-sm text-white/30 select-none">@</span>
              <input
                id="me-handle-input"
                type="text"
                maxlength="32"
                class="flex-1 px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-sm text-primary"
              >
              <button id="me-handle-save" class="px-4 py-3 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
                Save
              </button>
            </div>
            <p id="me-handle-status" class="font-mono text-[10px] text-white/30 mt-2 h-4"></p>
          </div>
        </div>
        <p class="font-mono text-[11px] text-white/40">
          <span id="me-fan-since"></span>
        </p>

        <!-- Current rank: the whole Egg -> Larva -> Chrysalis -> Emergent
             ladder (stored as egg/grub/pupa/adult — see STAGE_LABELS) plus the
             XP bar for progress within the current stage. Both driven by
             src/scripts/community/xp-progress.ts (pure functions, unit
             tested) — this block only turns that output into markup. -->
        <div class="mt-8 pt-6 border-t border-white/5">
          <div class="flex items-baseline gap-3 mb-4">
            <span class="font-mono text-xs text-secondary uppercase tracking-widest">Current rank</span>
            <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
          </div>

          <!-- The whole ladder, always all four stages, so stages ahead stay
               visible — that visibility is the point (see brief). -->
          <ol id="me-rank-ladder" aria-label="Evolution stages" class="flex flex-wrap gap-2 mb-6"></ol>

          <div>
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <span id="me-xp-stage-label" class="font-mono text-[11px] text-primary uppercase tracking-widest"></span>
              <span id="me-xp-numbers" class="font-mono text-[10px] text-white/40 uppercase tracking-widest"></span>
            </div>
            <div class="h-3 w-full bg-surface-container-low border border-white/10 rounded-full overflow-hidden">
              <div
                id="me-xp-fill"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-labelledby="me-xp-stage-label"
                class="h-full bg-secondary rounded-full"
                style="width:0%"
              ></div>
            </div>
            <p id="me-xp-next" class="font-mono text-[10px] text-white/40 mt-2"></p>
          </div>
        </div>
      </section>

      <!-- Bio: the fan writes this, it shows on their public profile. Its
           length cap and sanitising live server-side in
           functions/_lib/community/bio.ts; the counter here mirrors that
           constant rather than hard-coding a second copy of it. -->
      <section class="border border-white/5 p-6">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase">Bio</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
          <span id="me-bio-count" class="font-mono text-[10px] text-white/30"></span>
        </div>
        <textarea
          id="me-bio-input"
          rows="4"
          class="w-full px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-body text-sm text-white/80 rounded-[var(--radius)] resize-y"
          placeholder="Tell the wall who you are."
        ></textarea>
        <div class="flex items-center gap-3 mt-3">
          <button id="me-bio-save" class="px-4 py-3 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
            Save bio
          </button>
          <p id="me-bio-status" class="font-mono text-[10px] text-white/30 h-4"></p>
        </div>
      </section>

      <!-- Colourway picker: the one part of the creature a fan actually
           chooses (species/sprite refs are fixed at signup). -->
      <section class="border border-white/5 p-6">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase">Creature colour</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <ul id="me-colourways" class="flex flex-wrap gap-3"></ul>
        <p id="me-colourway-status" class="font-mono text-[10px] text-white/30 mt-3 h-4"></p>
      </section>

      <!-- Admin-only: wear any of the 401 sprites, permanently, regardless
           of your own stage. Hidden entirely for a non-admin (profile.is_admin
           is false) — and the server refuses the write independently of
           this being hidden, see /api/community/update's override_sprite
           handling. -->
      <section id="me-admin-sprite-section" class="hidden border border-secondary/30 p-6">
        <div class="flex items-baseline gap-3 mb-2">
          <span class="font-mono text-xs text-secondary uppercase">Admin — wear any creature</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
          <button id="me-sprite-clear" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-3 py-1 rounded-full">
            Clear override
          </button>
        </div>
        <p class="font-mono text-[10px] text-white/30 mb-4">
          Browse all 401 sprites, each shown here full-grown in its own native colours. Picking one shows it everywhere your creature appears — the fan wall, this page, and public profiles — rendered at YOUR actual stage, XP and colourway. Your rank label is unaffected.
        </p>
        <p id="me-sprite-status" class="font-mono text-[10px] text-white/30 mb-4 h-4"></p>
        <div id="me-sprite-groups" class="space-y-8"></div>
      </section>

      <!-- Settings: the controls that are about the ACCOUNT-facing side of a
           profile rather than about the creature. Visibility and sign-out are
           reversible and sit together; deletion is separated below them by its
           own border and copy, so it can never be the button you hit while
           aiming for something else. -->
      <section class="border border-white/5 p-6">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase">Settings</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>

        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="max-w-md">
            <p class="font-mono text-[11px] text-white/60 uppercase tracking-widest">Show me on the fan wall</p>
            <p class="font-mono text-[10px] text-white/30 mt-2 leading-relaxed">
              Off means unlisted, not private: you stop appearing in the directory, but anyone signed in who has your link can still open your profile.
            </p>
          </div>
          <button
            id="me-wall-toggle"
            type="button"
            role="switch"
            aria-checked="false"
            class="shrink-0 w-14 h-8 rounded-full border border-white/15 bg-surface-container-low relative transition-colors"
          >
            <span id="me-wall-knob" class="absolute top-1 left-1 w-5 h-5 rounded-full bg-white/40 transition-all"></span>
          </button>
        </div>
        <p id="me-wall-status" class="font-mono text-[10px] text-white/30 mt-3 h-4"></p>

        <div class="mt-6 pt-6 border-t border-white/5">
          <button id="me-signout" class="px-4 py-3 border border-white/15 hover:border-secondary/40 hover:text-secondary font-mono text-[10px] tracking-widest uppercase text-white/60 rounded-full transition-colors">
            Sign out
          </button>
        </div>

        <div class="mt-6 pt-6 border-t border-error/20">
          <p class="font-mono text-[11px] text-error uppercase tracking-widest">Delete profile</p>
          <p class="font-mono text-[10px] text-white/30 mt-2 leading-relaxed max-w-md">
            Deletes your handle, bio, rank, EP and creature for good. Your account and everything you've bought stay exactly as they are — signing in again starts you a brand new profile from scratch.
          </p>
          <button id="me-delete-start" class="mt-4 px-4 py-3 border border-error/40 hover:bg-error/10 font-mono text-[10px] tracking-widest uppercase text-error rounded-full transition-colors">
            Delete my profile
          </button>

          <!-- Typed confirmation, not a second button: the fan has to
               reproduce their own handle, which no mis-click can do. -->
          <div id="me-delete-confirm" class="hidden mt-4 p-4 border border-error/30 rounded-[var(--radius-lg)]">
            <label for="me-delete-input" id="me-delete-prompt" class="block font-mono text-[10px] text-white/50 leading-relaxed mb-3"></label>
            <div class="flex flex-wrap gap-2">
              <input
                id="me-delete-input"
                type="text"
                autocomplete="off"
                class="flex-1 min-w-[12rem] px-4 py-3 bg-surface-container-low border border-white/10 focus:border-error outline-none font-mono text-sm text-white/80 rounded-[var(--radius)]"
              >
              <button id="me-delete-cancel" class="px-4 py-3 border border-white/15 hover:border-white/40 font-mono text-[10px] tracking-widest uppercase text-white/50 rounded-full">
                Cancel
              </button>
              <button id="me-delete-go" disabled class="px-4 py-3 border border-error/40 enabled:hover:bg-error/10 disabled:opacity-30 disabled:cursor-not-allowed font-mono text-[10px] tracking-widest uppercase text-error rounded-full transition-colors">
                Delete for good
              </button>
            </div>
            <p id="me-delete-status" class="font-mono text-[10px] text-white/30 mt-3 h-4"></p>
          </div>
        </div>
      </section>

      <!-- Free-song token picker. Shown only while /api/library reports a
           granted-but-unspent token (see loadLibrary below). Choosing is
           permanent, so it always routes through the confirm dialog below
           rather than spending on click. -->
      <section id="me-free-token" class="hidden mb-10">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase">Free song token</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
          Thanks for verifying your email — pick any one track below and it's yours to download, free, forever. You can only choose once, so choose carefully.
        </p>
        <ul id="me-free-token-list" class="divide-y divide-white/5 border-y border-white/5"></ul>
      </section>

      <!-- Populated from /api/library — the same endpoint /library uses — so
           a fan's purchases are reachable from their profile without a
           second API. Hidden until we know there's something (or nothing)
           to show; left hidden entirely on a 401 since /library itself
           already owns the signed-out UX. -->
      <div id="me-library" class="hidden"></div>
    </div>
  </div>

  <!-- One-time-choice confirm dialog for the free-song token. A native
       <dialog> keeps this out of the DOM's tab order until opened and needs
       no extra dependency. -->
  <dialog id="me-free-token-confirm" class="bg-surface border border-white/10 p-6 max-w-sm w-[90vw] rounded-lg backdrop:bg-black/70">
    <p class="font-mono text-[11px] text-white/70 leading-relaxed mb-1">You're about to spend your one free-song token on:</p>
    <p id="me-free-token-confirm-title" class="font-headline text-xl text-primary uppercase tracking-tight mb-4"></p>
    <p class="font-mono text-[10px] text-white/40 leading-relaxed mb-6">This cannot be changed afterward — you get exactly one free track, ever.</p>
    <div class="flex gap-3 justify-end">
      <button type="button" id="me-free-token-cancel" class="font-mono text-[10px] uppercase tracking-widest px-4 py-2 border border-white/10 hover:border-white/30 rounded-full">Cancel</button>
      <button type="button" id="me-free-token-confirm-btn" class="font-mono text-[10px] uppercase tracking-widest px-4 py-2 bg-primary text-on-primary hover:bg-secondary hover:text-on-secondary rounded-full">Confirm choice</button>
    </div>
  </dialog>

  <script>
    import { creatureAvatarHtml, spriteTileHtml } from '../../scripts/sprites/creature-avatar.js';
    import { initCreatureCanvases, initCreatureCanvasesLazy, loadSprites } from '../../scripts/sprites/renderer.js';
    import { COLORWAYS } from '../../scripts/sprites/vendor/colorways.js';
    import { NATIVE_COLOURWAY } from '../../scripts/sprites/native-palette.js';
    import { computeStageProgress, rankLadder, STAGE_LABELS, type RankStatus } from '../../scripts/community/xp-progress';
    // The cap is the SERVER's constant, imported rather than re-typed — a
    // counter that disagrees with the write path is worse than no counter.
    import { MAX_BIO_LENGTH } from '../../../functions/_lib/community/bio';

    // Wrapped for astro:page-load — see music.astro's doc comment. This page
    // fetches the signed-in fan's own data fresh on every arrival (and is
    // reachable from many places — nav, TopNav's account link, the sprite
    // picker save flow), so it must re-run every time, not just once.
    document.addEventListener('astro:page-load', () => {
    const loading = document.getElementById('me-loading')!;
    const signin = document.getElementById('me-signin')!;
    const errorBox = document.getElementById('me-error')!;
    const errorMsg = document.getElementById('me-error-msg')!;
    const content = document.getElementById('me-content')!;
    const handleEl = document.getElementById('me-handle')!;
    const creatureEl = document.getElementById('me-creature')!;
    const colourwaysEl = document.getElementById('me-colourways')!;
    const colourwayStatus = document.getElementById('me-colourway-status')!;
    const spriteSection = document.getElementById('me-admin-sprite-section')!;
    const spriteGroupsEl = document.getElementById('me-sprite-groups')!;
    const spriteStatus = document.getElementById('me-sprite-status')!;
    const spriteClearBtn = document.getElementById('me-sprite-clear') as HTMLButtonElement;
    const nameInput = document.getElementById('me-name-input') as HTMLInputElement;
    const nameSave = document.getElementById('me-name-save') as HTMLButtonElement;
    const nameStatus = document.getElementById('me-name-status')!;
    const handleInput = document.getElementById('me-handle-input') as HTMLInputElement;
    const handleSave = document.getElementById('me-handle-save') as HTMLButtonElement;
    const handleStatus = document.getElementById('me-handle-status')!;
    const fanSinceEl = document.getElementById('me-fan-since')!;
    const libraryEl = document.getElementById('me-library')!;
    const freeTokenSection = document.getElementById('me-free-token')!;
    const freeTokenList = document.getElementById('me-free-token-list')!;
    const freeTokenDialog = document.getElementById('me-free-token-confirm') as HTMLDialogElement;
    const freeTokenConfirmTitle = document.getElementById('me-free-token-confirm-title')!;
    const freeTokenCancelBtn = document.getElementById('me-free-token-cancel') as HTMLButtonElement;
    const freeTokenConfirmBtn = document.getElementById('me-free-token-confirm-btn') as HTMLButtonElement;
    const rankLadderEl = document.getElementById('me-rank-ladder')!;
    const xpStageLabelEl = document.getElementById('me-xp-stage-label')!;
    const xpNumbersEl = document.getElementById('me-xp-numbers')!;
    const xpFillEl = document.getElementById('me-xp-fill')!;
    const xpNextEl = document.getElementById('me-xp-next')!;
    const bioInput = document.getElementById('me-bio-input') as HTMLTextAreaElement;
    const bioSave = document.getElementById('me-bio-save') as HTMLButtonElement;
    const bioStatus = document.getElementById('me-bio-status')!;
    const bioCount = document.getElementById('me-bio-count')!;
    const wallToggle = document.getElementById('me-wall-toggle') as HTMLButtonElement;
    const wallKnob = document.getElementById('me-wall-knob')!;
    const wallStatus = document.getElementById('me-wall-status')!;
    const signoutBtn = document.getElementById('me-signout') as HTMLButtonElement;
    const deleteStart = document.getElementById('me-delete-start') as HTMLButtonElement;
    const deleteBox = document.getElementById('me-delete-confirm')!;
    const deletePrompt = document.getElementById('me-delete-prompt')!;
    const deleteInput = document.getElementById('me-delete-input') as HTMLInputElement;
    const deleteCancel = document.getElementById('me-delete-cancel') as HTMLButtonElement;
    const deleteGo = document.getElementById('me-delete-go') as HTMLButtonElement;
    const deleteStatus = document.getElementById('me-delete-status')!;

    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    // Copied verbatim from src/pages/library.astro so the two surfaces
    // render owned-file links identically.
    const safeImg = (s: any) => {
      const v = String(s ?? '');
      return /^(https?:|\/)/.test(v) ? v : '';
    };
    function fmtFileSize(b: number) {
      if (b > 1e9) return (b / 1e9).toFixed(2) + ' GB';
      if (b > 1e6) return (b / 1e6).toFixed(1) + ' MB';
      return Math.ceil(b / 1024) + ' KB';
    }

    function fmtDate(unix: number) {
      return new Date(unix * 1000).toLocaleDateString(undefined, { year: 'numeric', month: 'long' });
    }

    // 96px — an exact 3x multiple of the sprite's 32px grid, so the render
    // fills the frame edge to edge (see creature-avatar.js's scale choice).
    const CREATURE_SIZE = 96;

    function renderCreature(creature: any) {
      creatureEl.innerHTML = creatureAvatarHtml(creature, CREATURE_SIZE);
      initCreatureCanvases(creatureEl);
    }

    // Same visual treatment already used for the selected colourway swatch
    // (border-primary + scale-110), reused here so "current" reads as
    // unmistakably the loudest state — see colourway-pick above.
    const LADDER_STATUS_CLASSES: Record<RankStatus, string> = {
      passed: 'border-secondary/40 bg-secondary/5 text-secondary',
      current: 'border-primary bg-primary/10 text-primary scale-110 font-bold',
      ahead: 'border-white/10 text-white/30',
    };
    const LADDER_STATUS_HINT: Record<RankStatus, string> = {
      passed: ' — reached',
      current: ' — current stage',
      ahead: ' — not yet reached',
    };

    function renderRankLadder(stage: string) {
      const steps = rankLadder(stage as any);
      rankLadderEl.innerHTML = steps.map(step => `
        <li>
          <span
            class="inline-flex items-center px-3 py-1.5 rounded-full border font-mono text-[10px] uppercase tracking-widest transition-all ${LADDER_STATUS_CLASSES[step.status]}"
            ${step.status === 'current' ? 'aria-current="step"' : ''}
          >${esc(step.label)}<span class="sr-only">${esc(LADDER_STATUS_HINT[step.status])}</span></span>
        </li>
      `).join('');
    }

    function renderXpBar(creature: any) {
      const progress = computeStageProgress({
        ep: creature.ep || 0,
        stage: creature.stage,
        next_stage_ep: creature.next_stage_ep,
      });

      xpStageLabelEl.textContent = progress.stageLabel;
      xpFillEl.style.width = progress.pct + '%';
      xpFillEl.setAttribute('aria-valuenow', String(Math.round(progress.pct)));
      xpFillEl.setAttribute(
        'aria-valuetext',
        progress.isFinal
          ? `${progress.epInStage} EP — max stage reached`
          : `${progress.epInStage} of ${progress.epForStage} EP toward ${progress.nextLabel}`,
      );

      if (progress.isFinal) {
        // Achievement state, not an empty/broken bar — the bar itself is
        // forced full (see computeStageProgress) and the copy reads as
        // "done", not as a truncated "X of Y" that has no Y.
        xpNumbersEl.textContent = progress.epInStage + ' EP';
        xpNextEl.textContent = 'Fully evolved — max stage reached.';
      } else {
        // Both numbers are re-based to THIS stage's own band (not raw EP
        // against a fixed total) so they always agree with the bar's fill —
        // see computeStageProgress's doc comment for why that matters.
        xpNumbersEl.textContent = progress.epInStage + ' / ' + progress.epForStage + ' EP';
        xpNextEl.textContent = (progress.epForStage! - progress.epInStage) + ' EP to ' + progress.nextLabel;
      }
    }

    let currentColourway: string | null = null;

    // A conic sweep through the sprite's own 4 tones — visually distinct
    // from the 12 solid-colour discs, which is the point: this option isn't
    // "a 13th colour", it's "no recolouring at all". Falls back to a neutral
    // grey sweep while the sprite data hasn't loaded yet or has no ref.
    async function nativeSwatchStyle(creature: any): Promise<string> {
      const fallback = 'background:conic-gradient(#2a2a2a,#6a6a6a,#a8a8a8,#2a2a2a)';
      const ref = creature && creature.sprite_ref;
      if (!ref) return fallback;
      try {
        const sprites = await loadSprites();
        const palette = sprites.get(ref)?.palette;
        if (!palette) return fallback;
        return `background:conic-gradient(${palette['1']},${palette['2']},${palette['3']},${palette['1']})`;
      } catch {
        return fallback;
      }
    }

    async function renderColourwayPicker(creature: any) {
      // Set synchronously, before the swatch-style await below, so
      // renderSpritePicker (called right after this in load()) always sees
      // the up-to-date value even though this function itself is async.
      currentColourway = (creature && creature.colourway) || null;
      const nativeStyle = await nativeSwatchStyle(creature);
      const nativeBtn = `
        <li>
          <button
            type="button"
            data-colourway="${NATIVE_COLOURWAY}"
            title="ORIGINAL — as drawn"
            class="colourway-pick w-8 h-8 rounded-full border-2 transition-all ${NATIVE_COLOURWAY === currentColourway ? 'border-primary scale-110' : 'border-white/10 hover:border-white/40'}"
            style="${nativeStyle}"
          ></button>
        </li>
      `;
      colourwaysEl.innerHTML = nativeBtn + COLORWAYS.map((cw: any) => `
        <li>
          <button
            type="button"
            data-colourway="${cw.id}"
            title="${cw.name}"
            class="colourway-pick w-8 h-8 rounded-full border-2 transition-all ${cw.id === currentColourway ? 'border-primary scale-110' : 'border-white/10 hover:border-white/40'}"
            style="background:${cw.p[1]}"
          ></button>
        </li>
      `).join('');
      colourwaysEl.querySelectorAll<HTMLButtonElement>('.colourway-pick').forEach(btn => {
        btn.addEventListener('click', () => setColourway(btn.dataset.colourway!));
      });
    }

    function setColourway(colourway: string) {
      if (colourway === currentColourway) return;
      colourwayStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ colourway }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error || 'save failed');
          }
          colourwayStatus.textContent = 'Saved.';
          return load();
        })
        .catch(e => { colourwayStatus.textContent = 'Could not save: ' + e.message; });
    }

    // Admin sprite-override picker. Server-gated independently (see
    // /api/community/update's override_sprite handling) — hiding this
    // section for a non-admin is a UX nicety, not the security boundary.
    // Headings come from STAGE_LABELS, not hand-typed words, so the admin
    // picker can never drift from the ladder the fan sees.
    const SPRITE_STAGE_GROUPS = [
      { stage: 'egg', heading: STAGE_LABELS.egg },
      { stage: 'grub', heading: STAGE_LABELS.grub },
      { stage: 'pupa', heading: STAGE_LABELS.pupa },
      { stage: 'adult', heading: STAGE_LABELS.adult },
    ];
    const SPRITE_TILE_SIZE = 44;
    let currentOverride: string | null = null;

    function setOverride(ref: string | null) {
      spriteStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ override_sprite: ref }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error || 'save failed');
          }
          spriteStatus.textContent = 'Saved.';
          return load();
        })
        .catch(e => { spriteStatus.textContent = 'Could not save: ' + e.message; });
    }

    // The underlying sprite dataset is fetched once and cached by
    // loadSprites() itself (shared with renderer.js's own animation path),
    // so rebuilding this grid on every load() (e.g. after picking a sprite)
    // re-fetches nothing over the network — it just rebuilds 401 lightweight
    // placeholder canvases and re-defers their actual paint to scroll
    // visibility. Each tile always previews full-grown (XP 100) in its own
    // native palette — see spriteTileHtml/drawStaticOne — so this grid is
    // NOT affected by the viewer's colourway; only which ref is selected
    // (currentOverride) changes on rebuild.
    function renderSpritePicker(profile: any) {
      currentOverride = profile.override_sprite || null;
      if (!profile.is_admin) {
        spriteSection.classList.add('hidden');
        return;
      }
      spriteSection.classList.remove('hidden');
      spriteClearBtn.disabled = !currentOverride;

      loadSprites().then((sprites: Map<string, any>) => {
        const byStage = new Map<string, any[]>();
        for (const sprite of sprites.values()) {
          if (!byStage.has(sprite.stage)) byStage.set(sprite.stage, []);
          byStage.get(sprite.stage)!.push(sprite);
        }
        spriteGroupsEl.innerHTML = SPRITE_STAGE_GROUPS
          .map(({ stage, heading }) => ({ stage, heading, items: (byStage.get(stage) || []).sort((a, b) => a.ref.localeCompare(b.ref)) }))
          .filter(g => g.items.length)
          .map(({ stage, heading, items }) => `
            <div>
              <div class="flex items-baseline gap-3 mb-4">
                <span class="font-mono text-xs text-secondary uppercase">${esc(heading)} <span class="text-white/30">(${items.length})</span></span>
                <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
              </div>
              <ul class="grid grid-cols-6 sm:grid-cols-8 md:grid-cols-10 gap-3">
                ${items.map((s: any) => `
                  <li class="text-center">
                    <button type="button" data-ref="${esc(s.ref)}" class="sprite-pick inline-block cursor-pointer" title="${esc(s.name || s.ref)}">
                      ${spriteTileHtml(s.ref, SPRITE_TILE_SIZE, s.ref === currentOverride)}
                    </button>
                  </li>
                `).join('')}
              </ul>
            </div>
          `).join('');

        spriteGroupsEl.querySelectorAll<HTMLButtonElement>('.sprite-pick').forEach(btn => {
          btn.addEventListener('click', () => setOverride(btn.dataset.ref!));
        });
        // Static frame-0 draws deferred to scroll-into-view — mounting all
        // 401 canvases as placeholders is cheap, painting them all at once
        // is not (see initCreatureCanvasesLazy's doc comment).
        initCreatureCanvasesLazy(spriteGroupsEl);
      });
    }

    spriteClearBtn.addEventListener('click', () => setOverride(null));

    // Rendering approach copied from src/pages/library.astro (the section
    // markup, download-link construction, and esc()/safeImg() usage are all
    // taken verbatim) — this is an additional surface onto the same
    // /api/library data, not a rebuild of it. /library itself is untouched.
    // Free-song token picker. `pendingChoice` holds the track awaiting
    // confirmation in the dialog — nothing is spent until the fan clicks
    // "Confirm choice", since accidentally spending the one-time token on
    // the wrong track is exactly the mistake this dialog exists to prevent.
    let pendingChoice: { key: string; title: string } | null = null;

    function renderFreeTokenPicker(choices: any[]) {
      if (!choices.length) {
        freeTokenSection.classList.add('hidden');
        return;
      }
      freeTokenSection.classList.remove('hidden');
      freeTokenList.innerHTML = choices.map((c: any) => `
        <li class="flex items-center gap-4 py-3">
          <img src="${esc(safeImg(c.artwork))}" alt="" loading="lazy" class="w-10 h-10 object-cover bg-white/5" />
          <span class="flex-1 font-mono text-[11px] text-white/80 truncate">${esc(c.title)} — ${esc(c.filename)}</span>
          <button type="button" data-key="${esc(c.key)}" data-title="${esc(c.title)}"
            class="free-token-pick px-3 py-2 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
            Choose this one
          </button>
        </li>
      `).join('');
      freeTokenList.querySelectorAll<HTMLButtonElement>('.free-token-pick').forEach(btn => {
        btn.addEventListener('click', () => {
          pendingChoice = { key: btn.dataset.key!, title: btn.dataset.title! };
          freeTokenConfirmTitle.textContent = pendingChoice.title;
          freeTokenDialog.showModal();
        });
      });
    }

    freeTokenCancelBtn.addEventListener('click', () => {
      pendingChoice = null;
      freeTokenDialog.close();
    });

    freeTokenConfirmBtn.addEventListener('click', () => {
      if (!pendingChoice) return;
      const choice = pendingChoice;
      freeTokenConfirmBtn.disabled = true;
      fetch('/api/free-token', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: choice.key }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error || 'could not spend token');
          }
          freeTokenDialog.close();
          pendingChoice = null;
          loadLibrary();
        })
        .catch(e => {
          // Leave the dialog open with the error visible in the title area
          // rather than silently failing — a fan mid-spend needs to know
          // whether it worked before they walk away.
          freeTokenConfirmTitle.textContent = choice.title + ' — failed: ' + e.message;
        })
        .finally(() => { freeTokenConfirmBtn.disabled = false; });
    });

    function loadLibrary() {
      fetch('/api/library', { credentials: 'include' })
        .then(async r => {
          // 401 here just means the session lapsed between the profile call
          // and this one — /library already owns the signed-out experience,
          // so we simply leave this section out rather than show an error.
          if (r.status === 401) return null;
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          renderFreeTokenPicker(data.free_song_choices || []);
          if (!data.releases.length) {
            libraryEl.classList.remove('hidden');
            libraryEl.innerHTML = `
              <div class="flex items-baseline gap-3 mb-4">
                <span class="font-mono text-xs text-secondary uppercase">Your library</span>
                <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
              </div>
              <div class="p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
                <p class="font-mono text-[11px] text-white/40 leading-relaxed">
                  Nothing here yet. Browse the <a href="/store" class="text-secondary underline">store</a> — your library populates the moment you buy something.
                </p>
              </div>`;
            return;
          }
          const releasesHtml = data.releases.map((r: any) => `
            <section class="border border-white/5 p-6">
              <div class="flex items-center gap-4 mb-4">
                <img src="${esc(safeImg(r.artwork))}" alt="" loading="lazy" class="w-16 h-16 object-cover bg-white/5" />
                <div class="flex-1">
                  <div class="font-mono text-[10px] text-secondary uppercase tracking-widest">${esc(r.type)}</div>
                  <h2 class="font-headline text-2xl text-primary uppercase tracking-tight">${esc(r.title)}</h2>
                </div>
              </div>
              ${r.files.length === 0
                ? `<p class="font-mono text-[11px] text-white/30">Files coming soon — check back shortly.</p>`
                : `<ul class="divide-y divide-white/5 border-y border-white/5">
                    ${r.files.map((f: any) => `
                      <li class="flex items-center gap-4 py-3">
                        <span class="font-mono text-[10px] text-white/30 uppercase">${esc(f.ext)}</span>
                        <span class="flex-1 font-mono text-[11px] text-white/80 truncate">${esc(f.filename)}</span>
                        <span class="font-mono text-[10px] text-white/40">${esc(fmtFileSize(f.size))}</span>
                        <a href="/api/download?key=${encodeURIComponent(f.key)}"
                           class="px-3 py-2 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
                          Download
                        </a>
                      </li>
                    `).join('')}
                  </ul>`
              }
            </section>
          `).join('');
          libraryEl.classList.remove('hidden');
          libraryEl.innerHTML = `
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-mono text-xs text-secondary uppercase">Your library</span>
              <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
            </div>
            <div class="space-y-4">${releasesHtml}</div>`;
        })
        // Non-fatal: the rest of the profile still works without this section.
        .catch(() => {});
    }

    function load() {
      return fetch('/api/community/me', { credentials: 'include' })
        .then(async r => {
          if (r.status === 401) {
            loading.classList.add('hidden');
            signin.classList.remove('hidden');
            return null;
          }
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          loading.classList.add('hidden');
          content.classList.remove('hidden');

          const { profile } = data;
          handleEl.textContent = profile.handle ? '@' + profile.handle : '';
          nameInput.value = profile.display_name || '';
          handleInput.value = profile.handle || '';
          if (profile.can_change_handle) {
            handleSave.disabled = false;
            handleStatus.textContent = '';
          } else {
            handleSave.disabled = true;
            handleStatus.textContent = profile.handle_change_available_at
              ? 'You can change your handle again on ' + fmtDate(profile.handle_change_available_at) + '.'
              : '';
          }
          fanSinceEl.textContent = 'Morphics since ' + fmtDate(profile.fan_since);
          bioInput.value = profile.bio || '';
          updateBioCount();
          myHandle = profile.handle || '';
          setWallToggle(!profile.hidden_from_wall);
          renderCreature(profile.creature);
          renderRankLadder(profile.creature.stage);
          renderXpBar(profile.creature);
          renderColourwayPicker(profile.creature);
          renderSpritePicker(profile);
          loadLibrary();
        })
        .catch(e => {
          loading.classList.add('hidden');
          errorBox.classList.remove('hidden');
          errorMsg.textContent = 'Could not load your profile: ' + e.message;
        });
    }

    // ---- Bio -------------------------------------------------------------
    // Counts code points, matching isValidBio's [...bio].length, so an emoji
    // costs the fan the same one character here as it does server-side.
    function bioLength(): number {
      return [...bioInput.value].length;
    }

    function updateBioCount() {
      const used = bioLength();
      bioCount.textContent = used + ' / ' + MAX_BIO_LENGTH;
      // Over-length is shown, never silently truncated — trimming somebody's
      // sentence out from under them as they type is worse than refusing the
      // save with the count already red.
      bioCount.classList.toggle('text-error', used > MAX_BIO_LENGTH);
      bioCount.classList.toggle('text-white/30', used <= MAX_BIO_LENGTH);
      bioSave.disabled = used > MAX_BIO_LENGTH;
    }

    bioInput.addEventListener('input', updateBioCount);

    bioSave.addEventListener('click', () => {
      if (bioLength() > MAX_BIO_LENGTH) return;
      bioSave.disabled = true;
      bioStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        // The raw textarea value: sanitizeBio on the server is the one place
        // that decides what a bio becomes, so the client never pre-trims and
        // the two can never disagree about what was stored.
        body: JSON.stringify({ bio: bioInput.value }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error === 'bio_too_long'
              ? `Too long — keep it under ${body.max || MAX_BIO_LENGTH} characters.`
              : (body.error || 'save failed'));
          }
          bioStatus.textContent = bioInput.value.trim() ? 'Saved.' : 'Bio cleared.';
        })
        .catch(e => { bioStatus.textContent = 'Could not save: ' + e.message; })
        .finally(() => { bioSave.disabled = false; });
    });

    // ---- Fan wall visibility ---------------------------------------------
    let onWall = true;
    let myHandle = '';

    function setWallToggle(on: boolean) {
      onWall = on;
      wallToggle.setAttribute('aria-checked', String(on));
      wallToggle.classList.toggle('bg-primary/20', on);
      wallToggle.classList.toggle('border-primary/40', on);
      wallKnob.classList.toggle('left-1', !on);
      wallKnob.classList.toggle('left-8', on);
      wallKnob.classList.toggle('bg-primary', on);
      wallKnob.classList.toggle('bg-white/40', !on);
    }

    wallToggle.addEventListener('click', () => {
      const next = !onWall;
      // Optimistic, then reverted on failure: a switch that does not move
      // until a round trip completes reads as broken.
      setWallToggle(next);
      wallStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hidden_from_wall: !next }),
      })
        .then(async r => {
          if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'save failed');
          wallStatus.textContent = next ? 'Listed on the fan wall.' : 'Unlisted — direct links still work.';
        })
        .catch(e => {
          setWallToggle(!next);
          wallStatus.textContent = 'Could not save: ' + e.message;
        });
    });

    // ---- Sign out ---------------------------------------------------------
    signoutBtn.addEventListener('click', () => {
      signoutBtn.disabled = true;
      fetch('/api/auth/logout', { method: 'POST', credentials: 'include' })
        // Hard navigation, not the client router: the session cookie is gone,
        // so every cached view on this page is now somebody else's data. A
        // full load is the only way to be sure none of it survives.
        .finally(() => { location.href = '/'; });
    });

    // ---- Delete profile ---------------------------------------------------
    deleteStart.addEventListener('click', () => {
      deleteBox.classList.remove('hidden');
      deleteStart.classList.add('hidden');
      deletePrompt.textContent = `Type your handle (${myHandle}) to confirm. This cannot be undone.`;
      deleteInput.value = '';
      deleteGo.disabled = true;
      deleteInput.focus();
    });

    deleteCancel.addEventListener('click', () => {
      deleteBox.classList.add('hidden');
      deleteStart.classList.remove('hidden');
      deleteStatus.textContent = '';
    });

    deleteInput.addEventListener('input', () => {
      deleteGo.disabled = deleteInput.value.trim().toLowerCase() !== myHandle;
    });

    deleteGo.addEventListener('click', () => {
      deleteGo.disabled = true;
      deleteStatus.textContent = 'Deleting…';
      fetch('/api/community/delete', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirm_handle: deleteInput.value.trim().toLowerCase() }),
      })
        .then(async r => {
          if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'delete failed');
          // Same reasoning as sign-out: this page is now rendering a profile
          // that no longer exists, so leave rather than re-render it.
          location.href = '/community';
        })
        .catch(e => {
          deleteStatus.textContent = 'Could not delete: ' + e.message;
          deleteGo.disabled = false;
        });
    });

    nameSave.addEventListener('click', () => {
      const name = nameInput.value.trim();
      if (!name) { nameStatus.textContent = 'Name cannot be empty.'; return; }
      nameSave.disabled = true;
      nameStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ display_name: name }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error || 'save failed');
          }
          nameStatus.textContent = 'Saved.';
        })
        .catch(e => { nameStatus.textContent = 'Could not save: ' + e.message; })
        .finally(() => { nameSave.disabled = false; });
    });

    const HANDLE_ERROR_MESSAGES: Record<string, string> = {
      handle_taken: 'That handle is already taken.',
      blocked_handle: 'That handle is not available.',
    };

    handleSave.addEventListener('click', () => {
      const handle = handleInput.value.trim();
      if (!handle) { handleStatus.textContent = 'Handle cannot be empty.'; return; }
      handleSave.disabled = true;
      handleStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            if (body.error === 'handle_cooldown' && body.next_change_at) {
              throw new Error('you can change it again on ' + fmtDate(body.next_change_at));
            }
            throw new Error(HANDLE_ERROR_MESSAGES[body.error] || body.error || 'save failed');
          }
          handleStatus.textContent = 'Saved.';
          return load();
        })
        .catch(e => { handleStatus.textContent = 'Could not save: ' + e.message; })
        .finally(() => { handleSave.disabled = false; });
    });

    load();
    }); // end astro:page-load
  </script>
</BaseLayout>
