---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="MY COMMUNITY" currentPage="/community">
  <!-- pb-24 (96px) clears the fixed player bar (72px tall + 1px border), which
       otherwise overlaps the last row of the avatar catalogue grid once a
       preview is playing. See src/components/PlayerBar.astro .pb-inner height. -->
  <div class="max-w-4xl mx-auto pb-24">
    <header class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="font-mono text-xs text-secondary uppercase tracking-widest">Your profile</span>
        <h1 class="font-headline font-bold text-5xl md:text-7xl text-primary uppercase tracking-tighter leading-none mt-2">COMMUNITY</h1>
        <p id="me-handle" class="font-mono text-[11px] text-white/50 mt-4"></p>
      </div>
      <div class="flex gap-3">
        <a href="/account" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">
          Sign-in details
        </a>
        <a href="/community" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">
          View fan wall
        </a>
      </div>
    </header>

    <div id="me-loading" class="font-mono text-[11px] text-white/40">Loading your profile…</div>

    <div id="me-signin" class="hidden p-8 border border-white/10 text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
        Sign in to see your collection and pick your avatar.
      </p>
      <a href={`/login?redirect=${encodeURIComponent('/community/me')}`} class="inline-block px-6 py-3 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
        Sign in
      </a>
    </div>

    <div id="me-error" class="hidden p-8 border border-white/10 text-center">
      <p id="me-error-msg" class="font-mono text-[11px] text-white/40 leading-relaxed"></p>
    </div>

    <div id="me-content" class="hidden space-y-12">
      <div id="me-unlocked-banner" class="hidden p-6 border border-secondary/40 bg-secondary/5">
        <p class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-3">Just unlocked</p>
        <ul id="me-unlocked-list" class="flex flex-wrap gap-6"></ul>
      </div>

      <section class="border border-white/5 p-6">
        <div class="flex items-center gap-6 mb-6">
          <!-- The creature (pixel-sprite) render is this fan's primary
               avatar, replacing the glyph medallion — see creature-avatar.js.
               The tier-ladder avatar picker further down the page is a
               separate collectible system and is untouched by this. -->
          <div id="me-creature"></div>
          <div class="flex-1">
            <label class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Display name</label>
            <div class="flex gap-2">
              <input
                id="me-name-input"
                type="text"
                maxlength="40"
                class="flex-1 px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-sm text-primary"
              >
              <button id="me-name-save" class="px-4 py-3 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
                Save
              </button>
            </div>
            <p id="me-name-status" class="font-mono text-[10px] text-white/30 mt-2 h-4"></p>

            <label class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mt-6 mb-2">Handle</label>
            <div class="flex gap-2">
              <span class="flex items-center px-3 font-mono text-sm text-white/30 select-none">@</span>
              <input
                id="me-handle-input"
                type="text"
                maxlength="32"
                class="flex-1 px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-sm text-primary"
              >
              <button id="me-handle-save" class="px-4 py-3 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
                Save
              </button>
            </div>
            <p id="me-handle-status" class="font-mono text-[10px] text-white/30 mt-2 h-4"></p>
          </div>
        </div>
        <p class="font-mono text-[11px] text-white/40">
          <span id="me-fan-since"></span> · <span id="me-count"></span> collected
        </p>
      </section>

      <!-- Colourway picker: the one part of the creature a fan actually
           chooses (species/sprite refs are fixed at signup). -->
      <section class="border border-white/5 p-6">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase">Creature colour</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <ul id="me-colourways" class="flex flex-wrap gap-3"></ul>
        <p id="me-colourway-status" class="font-mono text-[10px] text-white/30 mt-3 h-4"></p>
      </section>

      <!-- Populated from /api/library — the same endpoint /library uses — so
           a fan's purchases are reachable from their profile without a
           second API. Hidden until we know there's something (or nothing)
           to show; left hidden entirely on a 401 since /library itself
           already owns the signed-out UX. -->
      <div id="me-library" class="hidden"></div>

      <div id="me-catalogue" class="space-y-10"></div>
    </div>
  </div>

  <script>
    import { avatarHtml } from '../../scripts/avatar.js';
    import { creatureAvatarHtml } from '../../scripts/sprites/creature-avatar.js';
    import { initCreatureCanvases } from '../../scripts/sprites/renderer.js';
    import { COLORWAYS } from '../../scripts/sprites/vendor/colorways.js';

    const loading = document.getElementById('me-loading')!;
    const signin = document.getElementById('me-signin')!;
    const errorBox = document.getElementById('me-error')!;
    const errorMsg = document.getElementById('me-error-msg')!;
    const content = document.getElementById('me-content')!;
    const handleEl = document.getElementById('me-handle')!;
    const unlockedBanner = document.getElementById('me-unlocked-banner')!;
    const unlockedList = document.getElementById('me-unlocked-list')!;
    const creatureEl = document.getElementById('me-creature')!;
    const colourwaysEl = document.getElementById('me-colourways')!;
    const colourwayStatus = document.getElementById('me-colourway-status')!;
    const nameInput = document.getElementById('me-name-input') as HTMLInputElement;
    const nameSave = document.getElementById('me-name-save') as HTMLButtonElement;
    const nameStatus = document.getElementById('me-name-status')!;
    const handleInput = document.getElementById('me-handle-input') as HTMLInputElement;
    const handleSave = document.getElementById('me-handle-save') as HTMLButtonElement;
    const handleStatus = document.getElementById('me-handle-status')!;
    const fanSinceEl = document.getElementById('me-fan-since')!;
    const countEl = document.getElementById('me-count')!;
    const catalogueEl = document.getElementById('me-catalogue')!;
    const libraryEl = document.getElementById('me-library')!;

    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    // Copied verbatim from src/pages/library.astro so the two surfaces
    // render owned-file links identically.
    const safeImg = (s: any) => {
      const v = String(s ?? '');
      return /^(https?:|\/)/.test(v) ? v : '';
    };
    function fmtFileSize(b: number) {
      if (b > 1e9) return (b / 1e9).toFixed(2) + ' GB';
      if (b > 1e6) return (b / 1e6).toFixed(1) + ' MB';
      return Math.ceil(b / 1024) + ' KB';
    }

    function fmtDate(unix: number) {
      return new Date(unix * 1000).toLocaleDateString(undefined, { year: 'numeric', month: 'long' });
    }

    // 84px — the picker's showcase size, big enough to tell colourways apart
    // in a 6-wide grid. The single large hero slot up top now shows the
    // creature (see CREATURE_SIZE below), not a tier avatar — equipping one
    // still highlights it in this grid.
    const TILE_SIZE = 84;

    // This is the reward moment the whole feature exists for: `newly_unlocked`
    // is a list of avatar ids granted THIS load (computed server-side in
    // /api/community/me against the shelf as it stood before granting), so it
    // is only ever non-empty for the one visit where the unlock happened.
    function renderNewlyUnlocked(ids: string[] | undefined, avatars: any[]) {
      const won = (ids || [])
        .map(id => avatars.find(a => a.id === id))
        .filter(Boolean);
      if (!won.length) {
        unlockedBanner.classList.add('hidden');
        unlockedList.innerHTML = '';
        return;
      }
      unlockedBanner.classList.remove('hidden');
      unlockedList.innerHTML = won.map(a => `
        <li class="text-center">
          ${avatarHtml(a, TILE_SIZE)}
          <p class="font-mono text-[10px] text-primary uppercase tracking-widest mt-2">${esc(a.name)}</p>
        </li>
      `).join('');
    }

    let currentEquippedId: string | null = null;

    // 96px — an exact 3x multiple of the sprite's 32px grid, so the render
    // fills the frame edge to edge (see creature-avatar.js's scale choice).
    const CREATURE_SIZE = 96;

    function renderCreature(creature: any) {
      creatureEl.innerHTML = creatureAvatarHtml(creature, CREATURE_SIZE);
      initCreatureCanvases(creatureEl);
    }

    let currentColourway: string | null = null;

    function renderColourwayPicker(creature: any) {
      currentColourway = (creature && creature.colourway) || null;
      colourwaysEl.innerHTML = COLORWAYS.map((cw: any) => `
        <li>
          <button
            type="button"
            data-colourway="${cw.id}"
            title="${cw.name}"
            class="colourway-pick w-8 h-8 rounded-full border-2 transition-all ${cw.id === currentColourway ? 'border-primary scale-110' : 'border-white/10 hover:border-white/40'}"
            style="background:${cw.p[1]}"
          ></button>
        </li>
      `).join('');
      colourwaysEl.querySelectorAll<HTMLButtonElement>('.colourway-pick').forEach(btn => {
        btn.addEventListener('click', () => setColourway(btn.dataset.colourway!));
      });
    }

    function setColourway(colourway: string) {
      if (colourway === currentColourway) return;
      colourwayStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ colourway }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error || 'save failed');
          }
          colourwayStatus.textContent = 'Saved.';
          return load();
        })
        .catch(e => { colourwayStatus.textContent = 'Could not save: ' + e.message; });
    }

    // Tier 1 is always available (the "six options" every fan gets on day
    // one); tier 2 unlocks by finishing account setup; tiers 3-4 are granted
    // by hand, never earned by a task, which is why their catalogue hint
    // copy (set server-side, tools/d1/seed-avatar-tiers.sql) reads as an
    // award ("A gift, for the loyal") rather than an instruction — nothing
    // is more deflating than a goal with no path, and there IS no path here.
    const TIER_GROUPS: Array<{ tier: number | null; heading: string }> = [
      { tier: 1, heading: 'Tier 1' },
      { tier: 2, heading: 'Tier 2' },
      { tier: 3, heading: 'Tier 3' },
      { tier: 4, heading: 'Tier 4' },
      // Pre-existing release/special avatars (earned by owning a record)
      // sit on their own axis — see migrations/0005_avatar_tiers.sql — and
      // keep their own group at the end so they don't vanish from the picker.
      { tier: null, heading: 'Releases' },
    ];

    function avatarTile(a: any) {
      return `
        <li class="text-center">
          <button
            type="button"
            data-avatar-id="${esc(a.id)}"
            data-unlocked="${a.unlocked ? '1' : '0'}"
            class="avatar-pick inline-block ${a.unlocked ? 'cursor-pointer' : 'cursor-default'} ${a.id === currentEquippedId ? 'drop-shadow-[0_0_8px_#00F0FF]' : ''}"
          >
            ${avatarHtml(a, TILE_SIZE, { locked: !a.unlocked, rarity: a.rarity })}
          </button>
          <p class="font-mono text-[9px] text-white/40 uppercase tracking-widest mt-2 leading-tight">
            ${a.unlocked ? esc(a.name) : esc(a.hint || 'Locked')}
          </p>
        </li>
      `;
    }

    function renderCatalogue(avatars: any[]) {
      const byTier = new Map<number | null, any[]>();
      for (const a of avatars) {
        const key = typeof a.tier === 'number' ? a.tier : null;
        if (!byTier.has(key)) byTier.set(key, []);
        byTier.get(key)!.push(a);
      }

      catalogueEl.innerHTML = TIER_GROUPS
        .map(({ tier, heading }) => ({ tier, heading, items: byTier.get(tier) || [] }))
        .filter(g => g.items.length)
        .map(({ heading, items }) => `
          <div>
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-mono text-xs text-secondary uppercase">${esc(heading)}</span>
              <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
            </div>
            <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-6">
              ${items.map(avatarTile).join('')}
            </ul>
          </div>
        `).join('');

      catalogueEl.querySelectorAll<HTMLButtonElement>('.avatar-pick').forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.dataset.unlocked !== '1') return;
          equip(btn.dataset.avatarId!);
        });
      });
    }

    function equip(avatarId: string) {
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ equipped_avatar_id: avatarId }),
      })
        .then(r => { if (!r.ok) throw new Error('save failed'); return load(); })
        .catch(() => { nameStatus.textContent = 'Could not equip that avatar.'; });
    }

    // Rendering approach copied from src/pages/library.astro (the section
    // markup, download-link construction, and esc()/safeImg() usage are all
    // taken verbatim) — this is an additional surface onto the same
    // /api/library data, not a rebuild of it. /library itself is untouched.
    function loadLibrary() {
      fetch('/api/library', { credentials: 'include' })
        .then(async r => {
          // 401 here just means the session lapsed between the profile call
          // and this one — /library already owns the signed-out experience,
          // so we simply leave this section out rather than show an error.
          if (r.status === 401) return null;
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          if (!data.releases.length) {
            libraryEl.classList.remove('hidden');
            libraryEl.innerHTML = `
              <div class="flex items-baseline gap-3 mb-4">
                <span class="font-mono text-xs text-secondary uppercase">Your library</span>
                <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
              </div>
              <div class="p-8 border border-white/10 text-center">
                <p class="font-mono text-[11px] text-white/40 leading-relaxed">
                  Nothing here yet. Browse the <a href="/store" class="text-secondary underline">store</a> — your library populates the moment you buy something.
                </p>
              </div>`;
            return;
          }
          const releasesHtml = data.releases.map((r: any) => `
            <section class="border border-white/5 p-6">
              <div class="flex items-center gap-4 mb-4">
                <img src="${esc(safeImg(r.artwork))}" alt="" loading="lazy" class="w-16 h-16 object-cover bg-white/5" />
                <div class="flex-1">
                  <div class="font-mono text-[10px] text-secondary uppercase tracking-widest">${esc(r.type)}</div>
                  <h2 class="font-headline text-2xl text-primary uppercase tracking-tight">${esc(r.title)}</h2>
                </div>
              </div>
              ${r.files.length === 0
                ? `<p class="font-mono text-[11px] text-white/30">Files coming soon — check back shortly.</p>`
                : `<ul class="divide-y divide-white/5 border-y border-white/5">
                    ${r.files.map((f: any) => `
                      <li class="flex items-center gap-4 py-3">
                        <span class="font-mono text-[10px] text-white/30 uppercase">${esc(f.ext)}</span>
                        <span class="flex-1 font-mono text-[11px] text-white/80 truncate">${esc(f.filename)}</span>
                        <span class="font-mono text-[10px] text-white/40">${esc(fmtFileSize(f.size))}</span>
                        <a href="/api/download?key=${encodeURIComponent(f.key)}"
                           class="px-3 py-2 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
                          Download
                        </a>
                      </li>
                    `).join('')}
                  </ul>`
              }
            </section>
          `).join('');
          libraryEl.classList.remove('hidden');
          libraryEl.innerHTML = `
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-mono text-xs text-secondary uppercase">Your library</span>
              <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
            </div>
            <div class="space-y-4">${releasesHtml}</div>`;
        })
        // Non-fatal: the rest of the profile still works without this section.
        .catch(() => {});
    }

    function load() {
      return fetch('/api/community/me', { credentials: 'include' })
        .then(async r => {
          if (r.status === 401) {
            loading.classList.add('hidden');
            signin.classList.remove('hidden');
            return null;
          }
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          loading.classList.add('hidden');
          content.classList.remove('hidden');

          const { profile, avatars, newly_unlocked } = data;
          currentEquippedId = profile.avatar ? profile.avatar.id : null;
          handleEl.textContent = profile.handle ? '@' + profile.handle : '';
          nameInput.value = profile.display_name || '';
          handleInput.value = profile.handle || '';
          if (profile.can_change_handle) {
            handleSave.disabled = false;
            handleStatus.textContent = '';
          } else {
            handleSave.disabled = true;
            handleStatus.textContent = profile.handle_change_available_at
              ? 'You can change your handle again on ' + fmtDate(profile.handle_change_available_at) + '.'
              : '';
          }
          fanSinceEl.textContent = 'Morphics since ' + fmtDate(profile.fan_since);
          countEl.textContent = String(profile.collection_count);
          renderCreature(profile.creature);
          renderColourwayPicker(profile.creature);
          renderCatalogue(avatars);
          renderNewlyUnlocked(newly_unlocked, avatars);
          loadLibrary();
        })
        .catch(e => {
          loading.classList.add('hidden');
          errorBox.classList.remove('hidden');
          errorMsg.textContent = 'Could not load your profile: ' + e.message;
        });
    }

    nameSave.addEventListener('click', () => {
      const name = nameInput.value.trim();
      if (!name) { nameStatus.textContent = 'Name cannot be empty.'; return; }
      nameSave.disabled = true;
      nameStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ display_name: name }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            throw new Error(body.error || 'save failed');
          }
          nameStatus.textContent = 'Saved.';
        })
        .catch(e => { nameStatus.textContent = 'Could not save: ' + e.message; })
        .finally(() => { nameSave.disabled = false; });
    });

    const HANDLE_ERROR_MESSAGES: Record<string, string> = {
      handle_taken: 'That handle is already taken.',
      blocked_handle: 'That handle is not available.',
    };

    handleSave.addEventListener('click', () => {
      const handle = handleInput.value.trim();
      if (!handle) { handleStatus.textContent = 'Handle cannot be empty.'; return; }
      handleSave.disabled = true;
      handleStatus.textContent = 'Saving…';
      fetch('/api/community/update', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle }),
      })
        .then(async r => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            if (body.error === 'handle_cooldown' && body.next_change_at) {
              throw new Error('you can change it again on ' + fmtDate(body.next_change_at));
            }
            throw new Error(HANDLE_ERROR_MESSAGES[body.error] || body.error || 'save failed');
          }
          handleStatus.textContent = 'Saved.';
          return load();
        })
        .catch(e => { handleStatus.textContent = 'Could not save: ' + e.message; })
        .finally(() => { handleSave.disabled = false; });
    });

    load();
  </script>
</BaseLayout>
