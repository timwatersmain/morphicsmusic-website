---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="FAN PROFILE" currentPage="/community">
  <!-- pb-24 (96px) clears the fixed player bar (72px tall + 1px border), which
       otherwise overlaps the bottom of this page's content once a preview is
       playing. See src/components/PlayerBar.astro .pb-inner height. -->
  <div class="max-w-4xl mx-auto pb-24">
    <div id="prof-loading" class="font-mono text-[11px] text-white/40">Loading profile…</div>

    <div id="prof-signin" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
        Sign in to view fan profiles.
      </p>
      <a id="prof-signin-link" href="/login" data-astro-reload class="inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
        Sign in
      </a>
    </div>

    <div id="prof-error" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p id="prof-error-msg" class="font-mono text-[11px] text-white/40 leading-relaxed">No such fan.</p>
      <a href="/community" class="inline-block mt-4 font-mono text-[10px] text-secondary uppercase tracking-widest">Back to the fan wall</a>
    </div>

    <div id="prof-content" class="hidden">
      <header class="mb-12 flex items-center gap-6">
        <div id="prof-avatar"></div>
        <div>
          <span class="font-mono text-xs text-secondary uppercase tracking-widest" id="prof-since"></span>
          <h1 id="prof-name" class="font-headline font-bold text-4xl md:text-6xl text-primary uppercase tracking-tighter leading-none mt-2"></h1>
          <p id="prof-handle" class="font-mono text-[11px] text-white/50 mt-2"></p>
        </div>
      </header>

      <!-- Rank: one chip for the stage this fan has reached plus their EP.
           The full four-step ladder stays on /community/me — on somebody
           else's profile the interesting fact is where they ARE, not how far
           they have left to go. -->
      <div class="mb-10">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase tracking-widest">Rank</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <span id="prof-rank" class="inline-flex items-center px-3 py-1.5 rounded-full border border-primary/40 bg-primary/10 text-primary font-mono text-[10px] uppercase tracking-widest"></span>
          <span id="prof-ep" class="font-mono text-[10px] text-white/40 uppercase tracking-widest"></span>
        </div>
      </div>

      <div>
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase tracking-widest">About</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <!-- whitespace-pre-line: the bio is stored with its newlines (see
             bio.ts, which caps consecutive ones at two) and set via
             textContent, never innerHTML — so a fan's line breaks survive
             without any markup ever coming from fan input. -->
        <p id="prof-bio" class="font-body text-sm text-white/70 leading-relaxed whitespace-pre-line max-w-2xl"></p>
        <p id="prof-bio-empty" class="hidden font-mono text-[11px] text-white/30">This fan hasn't written a bio yet.</p>
        <a
          id="prof-edit"
          href="/community/me"
          class="hidden inline-block mt-8 px-6 py-3 rounded-full border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary transition-colors"
        >
          Edit your profile
        </a>
      </div>
    </div>
  </div>

  <script>
    import { creatureAvatarHtml } from '../../scripts/sprites/creature-avatar.js';
    import { STAGE_LABELS } from '../../scripts/community/xp-progress';
    import { initCreatureCanvases } from '../../scripts/sprites/renderer.js';

    // Wrapped for astro:page-load — see music.astro's doc comment. This is
    // also a dynamic route (one script shared by every /community/u/:handle
    // page), so without this, browsing from one fan's profile to another's
    // via the client router would leave the second one completely unwired —
    // the same bundled-script-runs-once problem, just reached by navigating
    // between two different handles instead of by revisiting one page.
    document.addEventListener('astro:page-load', () => {
    const loading = document.getElementById('prof-loading')!;
    const signin = document.getElementById('prof-signin')!;
    const signinLink = document.getElementById('prof-signin-link') as HTMLAnchorElement;
    const errorBox = document.getElementById('prof-error')!;
    const errorMsg = document.getElementById('prof-error-msg')!;
    const content = document.getElementById('prof-content')!;
    const avatarEl = document.getElementById('prof-avatar')!;
    const nameEl = document.getElementById('prof-name')!;
    const sinceEl = document.getElementById('prof-since')!;
    const handleEl = document.getElementById('prof-handle')!;
    const rankEl = document.getElementById('prof-rank')!;
    const epEl = document.getElementById('prof-ep')!;
    const bioEl = document.getElementById('prof-bio')!;
    const bioEmpty = document.getElementById('prof-bio-empty')!;
    const editLink = document.getElementById('prof-edit')!;

    function fmtDate(unix: number) {
      return new Date(unix * 1000).toLocaleDateString(undefined, { year: 'numeric', month: 'long' });
    }

    function showError(message: string) {
      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');
      errorMsg.textContent = message;
    }

    const handle = location.pathname.replace(/^\/community\/u\//, '').replace(/\/$/, '');
    const redirectTarget = location.pathname;
    signinLink.href = '/login?redirect=' + encodeURIComponent(redirectTarget);

    if (!/^[a-z0-9-]{1,32}$/.test(handle)) {
      showError('No such fan.');
    } else {
      fetch(`/api/community/profile?handle=${encodeURIComponent(handle)}`, { credentials: 'include' })
        .then(async r => {
          if (r.status === 401) {
            loading.classList.add('hidden');
            signin.classList.remove('hidden');
            return null;
          }
          if (r.status === 404) { showError('No such fan.'); return null; }
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          loading.classList.add('hidden');
          content.classList.remove('hidden');

          const { profile } = data;
          nameEl.textContent = profile.display_name || profile.handle;
          sinceEl.textContent = 'Morphics since ' + fmtDate(profile.fan_since);
          handleEl.textContent = '@' + profile.handle;

          const stage = (profile.creature && profile.creature.stage) || 'egg';
          rankEl.textContent = (STAGE_LABELS as Record<string, string>)[stage] || STAGE_LABELS.egg;
          epEl.textContent = ((profile.creature && profile.creature.ep) || 0) + ' EP';

          // textContent, never innerHTML: the bio is fan-written text and the
          // only escaping that can never be got wrong is the one the DOM does
          // for you.
          if (profile.bio) {
            bioEl.textContent = profile.bio;
          } else {
            bioEl.classList.add('hidden');
            bioEmpty.classList.remove('hidden');
          }

          if (profile.is_self) editLink.classList.remove('hidden');
          // The creature (pixel-sprite) render replaces the glyph medallion
          // as this fan's primary avatar — see creature-avatar.js. 96px is
          // an exact 3x multiple of the sprite's 32px grid.
          avatarEl.innerHTML = creatureAvatarHtml(profile.creature, 96);
          initCreatureCanvases(avatarEl);
        })
        .catch(e => showError('Could not load this profile: ' + e.message));
    }
    }); // end astro:page-load
  </script>
</BaseLayout>
