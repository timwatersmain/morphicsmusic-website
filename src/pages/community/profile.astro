---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="FAN PROFILE" currentPage="/community">
  <div class="max-w-4xl mx-auto">
    <div id="prof-loading" class="font-mono text-[11px] text-white/40">Loading profile…</div>

    <div id="prof-signin" class="hidden p-8 border border-white/10 text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
        Sign in to view fan profiles.
      </p>
      <a id="prof-signin-link" href="/login" class="inline-block px-6 py-3 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
        Sign in
      </a>
    </div>

    <div id="prof-error" class="hidden p-8 border border-white/10 text-center">
      <p id="prof-error-msg" class="font-mono text-[11px] text-white/40 leading-relaxed">No such fan.</p>
      <a href="/community" class="inline-block mt-4 font-mono text-[10px] text-secondary uppercase tracking-widest">Back to the fan wall</a>
    </div>

    <div id="prof-content" class="hidden">
      <header class="mb-12 flex items-center gap-6">
        <div id="prof-avatar"></div>
        <div>
          <span class="font-mono text-xs text-secondary uppercase tracking-widest" id="prof-since"></span>
          <h1 id="prof-name" class="font-headline font-bold text-4xl md:text-6xl text-primary uppercase tracking-tighter leading-none mt-2"></h1>
          <p id="prof-count" class="font-mono text-[11px] text-white/50 mt-2"></p>
        </div>
      </header>

      <div>
        <div class="flex items-baseline gap-3 mb-4">
          <span class="font-mono text-xs text-secondary uppercase">Collection</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <ul id="prof-shelf" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-6"></ul>
        <p id="prof-shelf-empty" class="hidden font-mono text-[11px] text-white/30">No avatars collected yet.</p>
      </div>
    </div>
  </div>

  <script>
    const loading = document.getElementById('prof-loading')!;
    const signin = document.getElementById('prof-signin')!;
    const signinLink = document.getElementById('prof-signin-link') as HTMLAnchorElement;
    const errorBox = document.getElementById('prof-error')!;
    const errorMsg = document.getElementById('prof-error-msg')!;
    const content = document.getElementById('prof-content')!;
    const avatarEl = document.getElementById('prof-avatar')!;
    const nameEl = document.getElementById('prof-name')!;
    const sinceEl = document.getElementById('prof-since')!;
    const countEl = document.getElementById('prof-count')!;
    const shelfEl = document.getElementById('prof-shelf')!;
    const shelfEmpty = document.getElementById('prof-shelf-empty')!;

    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    const safeImg = (s: any) => {
      const v = String(s ?? '');
      return /^(https?:|\/)/.test(v) ? v : '';
    };

    function fmtDate(unix: number) {
      return new Date(unix * 1000).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
    }

    // Mirrors AvatarMedallion.astro — rebuilt here by hand because this
    // markup is assembled from a client-side fetch, not server-rendered.
    function medallionHtml(art: string | null | undefined, name: string, opts: { rarity?: number; size?: 'sm' | 'md' | 'lg' } = {}) {
      const { rarity, size = 'md' } = opts;
      const dim = { sm: 'w-10 h-10', md: 'w-16 h-16', lg: 'w-28 h-28' }[size];
      const img = safeImg(art);
      const inner = img
        ? `<img src="${esc(img)}" alt="${esc(name)}" width="112" height="112" loading="lazy" decoding="async" class="w-full h-full object-cover" />`
        : `<div class="w-full h-full bg-surface-container-high"></div>`;
      const rarityBadge = (typeof rarity === 'number' && rarity > 0 && rarity <= 0.1)
        ? `<span class="absolute -bottom-1 left-1/2 -translate-x-1/2 font-mono text-[8px] uppercase tracking-widest bg-secondary text-on-secondary px-1">${esc(Math.max(1, Math.round(rarity * 100)))}%</span>`
        : '';
      return `
        <div class="relative inline-block">
          <div class="${dim} rounded-full overflow-hidden border-2 border-primary/60 transition-colors">${inner}</div>
          ${rarityBadge}
        </div>`;
    }

    function showError(message: string) {
      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');
      errorMsg.textContent = message;
    }

    const handle = location.pathname.replace(/^\/community\/u\//, '').replace(/\/$/, '');
    const redirectTarget = location.pathname;
    signinLink.href = '/login?redirect=' + encodeURIComponent(redirectTarget);

    if (!/^[a-z0-9-]{1,32}$/.test(handle)) {
      showError('No such fan.');
    } else {
      fetch(`/api/community/profile?handle=${encodeURIComponent(handle)}`, { credentials: 'include' })
        .then(async r => {
          if (r.status === 401) {
            loading.classList.add('hidden');
            signin.classList.remove('hidden');
            return null;
          }
          if (r.status === 404) { showError('No such fan.'); return null; }
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          loading.classList.add('hidden');
          content.classList.remove('hidden');

          const { profile, shelf } = data;
          nameEl.textContent = profile.display_name || profile.handle;
          sinceEl.textContent = 'Fan since ' + fmtDate(profile.fan_since);
          countEl.textContent = `${profile.collection_count} collected`;
          avatarEl.innerHTML = medallionHtml(profile.avatar && profile.avatar.art_path, profile.display_name || profile.handle, { size: 'lg' });

          if (!shelf.length) {
            shelfEmpty.classList.remove('hidden');
          } else {
            shelfEl.innerHTML = shelf.map((a: any) => `
              <li class="text-center">
                ${medallionHtml(a.art_path, a.name, { rarity: a.rarity })}
                <p class="font-mono text-[9px] text-white/40 uppercase tracking-widest mt-2 leading-tight">${esc(a.name)}</p>
              </li>
            `).join('');
          }
        })
        .catch(e => showError('Could not load this profile: ' + e.message));
    }
  </script>
</BaseLayout>
