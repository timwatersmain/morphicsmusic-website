---
import PageTitle from '../components/PageTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { INTENTS, INTENT_ORDER } from '../../functions/_lib/contact';
import eventsData from '../data/events.json';
import epk from '../data/epk.json';

// Sorted here, at build time, rather than in the browser: the list is small
// and static, so shipping JS to reorder it would be pure overhead.
const upcoming = [...(eventsData.upcoming || [])].sort((a: any, b: any) => a.date.localeCompare(b.date));
const past = [...(eventsData.past || [])].sort((a: any, b: any) => b.date.localeCompare(a.date));

const hasEvents = upcoming.length > 0 || past.length > 0;

const pressPhotos = (epk.press_photos || []) as Array<{ src: string; full: string; width?: number; height?: number }>;
const liveVideos = (epk.live_videos || []) as Array<{ label: string; url: string }>;
// Derived from the show history, not listed separately: a hand-kept venue
// array is how this page came to print 23 rooms while the one-sheet PDF
// printed 19. The exclusions in epk.json are the single curation both read.
const notARoom = new Set((epk.not_a_room || []) as string[]);
// How many past shows stay visible before the disclosure. Four fills the
// section without the page becoming a scrolling archive.
const SHOWN = 4;
// The venue roll-call moved off this page — it belongs on the one-sheet,
// where a promoter is reading credentials, not on a page whose job is "what
// is coming up". The derivation stays because `hasEpk` still uses it: a kit
// that is nothing BUT a venue list is still a kit worth linking, and dropping
// it from that test would hide the section for a catalogue that has one.
const pastVenues = [...new Set(past.map((e: any) => e.venue).filter(Boolean) as string[])]
  .filter((v) => !notARoom.has(v));
// The EPK block is worth building but not worth showing empty — a heading
// with nothing under it reads as neglect, which is the opposite of what a
// press kit is for.
const hasEpk = !!(epk.bio_short || epk.bio_long || pressPhotos.length || epk.one_sheet_url
  || epk.rider_url || epk.logo || liveVideos.length || pastVenues.length);

const fmtDate = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  return Number.isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
  });
};
---

<BaseLayout title="EVENTS" currentPage="/events" ogImage="/images/og/og-events.jpg">
  <div class="max-w-5xl">

    <PageTitle title="EVENTS" class="mb-6" />
    <!-- mb-6/mt-0: the paragraph that used to sit between the title and this
         button is gone, and its two margins were still holding the gap open. -->
    <header class="mb-10">
      <a href="#contact" class="inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
        Booking &amp; enquiries
      </a>
    </header>

    {upcoming.length > 0 && (
      <section class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span class="font-mono text-xs text-secondary uppercase tracking-widest">Upcoming</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <ul class="space-y-3">
          {upcoming.map((e: any) => (
            <li class="border border-white/10 hover:border-secondary/30 transition-colors p-5 flex flex-wrap items-baseline gap-x-6 gap-y-2">
              <time datetime={e.date} class="font-mono text-[11px] text-secondary tabular-nums w-28 shrink-0">{fmtDate(e.date)}</time>
              <div class="flex-1 min-w-[14rem]">
                <h2 class="font-headline text-2xl text-primary uppercase tracking-tight leading-none">{e.venue}</h2>
                <p class="font-mono text-[11px] text-white/50 mt-1">
                  {e.city}{e.with ? ` · ${e.with}` : ''}{e.title ? ` · ${e.title}` : ''}
                </p>
                {e.note && <p class="font-mono text-[10px] text-white/30 mt-2 leading-relaxed">{e.note}</p>}
              </div>
              {e.sold_out
                ? <span class="font-mono text-[10px] uppercase tracking-widest text-white/30 border border-white/10 px-4 py-2 rounded-full">Sold out</span>
                : e.ticket_url
                  ? <a href={e.ticket_url} rel="noopener" class="font-mono text-[10px] uppercase tracking-widest text-primary border border-primary/20 hover:border-primary/60 hover:bg-primary/5 px-4 py-2 rounded-full transition-colors">Tickets</a>
                  : null}
            </li>
          ))}
        </ul>
      </section>
    )}

    {past.length > 0 && (
      <section class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span class="font-mono text-xs text-secondary uppercase tracking-widest">Selected shows</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <!-- The first few, then the rest behind a disclosure. A back
             catalogue of shows is reference material: worth having on the
             page, not worth spending the whole page on. <details> because it
             needs no JavaScript, survives the client router with no wiring,
             and is open to find-in-page in every current browser. -->
        <ul class="divide-y divide-white/5 border-y border-white/5">
          {past.slice(0, SHOWN).map((e: any) => (
            <li class="grid grid-cols-1 sm:grid-cols-[7rem_1fr_auto] items-baseline gap-x-6 gap-y-1 py-4">
              <time datetime={e.date} class="font-mono text-[10px] text-white/30 tabular-nums whitespace-nowrap">
                {e.date_display || fmtDate(e.date)}
              </time>
              <div class="min-w-0">
                <span class="font-mono text-[12px] text-white/80">{e.title}</span>
                <span class="block font-mono text-[10px] text-white/40 mt-0.5">
                  {[e.venue, e.city].filter(Boolean).join(' · ')}
                </span>
              </div>
              {e.role && (
                <span class="font-mono text-[9px] uppercase tracking-widest text-white/30 border border-white/10 px-3 py-1 rounded-full justify-self-start sm:justify-self-end whitespace-nowrap">
                  {e.role}
                </span>
              )}
            </li>
          ))}
        </ul>

        {past.length > SHOWN && (
          <details class="shows-more group">
            <!-- FIRST child, because a <summary> that is not the first child of
                 its <details> stops being the disclosure control and renders as
                 ordinary content. It is moved visually below the rows with
                 flex order instead, so the toggle sits under what it reveals
                 rather than making you scroll back up to collapse. -->
            <summary class="shows-toggle font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest cursor-pointer py-4">
              <span class="group-open:hidden">Show {past.length - SHOWN} more</span>
              <span class="hidden group-open:inline">Show fewer</span>
            </summary>
            <ul class="divide-y divide-white/5 border-b border-white/5">
              {past.slice(SHOWN).map((e: any) => (
                <li class="grid grid-cols-1 sm:grid-cols-[7rem_1fr_auto] items-baseline gap-x-6 gap-y-1 py-4">
                  <time datetime={e.date} class="font-mono text-[10px] text-white/30 tabular-nums whitespace-nowrap">
                    {e.date_display || fmtDate(e.date)}
                  </time>
                  <div class="min-w-0">
                    <span class="font-mono text-[12px] text-white/80">{e.title}</span>
                    <span class="block font-mono text-[10px] text-white/40 mt-0.5">
                      {[e.venue, e.city].filter(Boolean).join(' · ')}
                    </span>
                  </div>
                  {e.role && (
                    <span class="font-mono text-[9px] uppercase tracking-widest text-white/30 border border-white/10 px-3 py-1 rounded-full justify-self-start sm:justify-self-end whitespace-nowrap">
                      {e.role}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    )}

    {!hasEvents && (
      <section class="mb-16 p-8 border border-white/10 rounded-[var(--radius-lg)]">
        <p class="font-mono text-[11px] text-white/50 leading-relaxed max-w-[58ch]">
          No dates announced right now. Bookings are open — if you run a venue,
          a night or a festival, the form below reaches me directly.
        </p>
        <p class="font-mono text-[10px] text-white/30 mt-4 leading-relaxed max-w-[58ch]">
          Fans: <a href="/community" class="text-secondary underline">join the community</a> and
          you'll hear about dates before they go anywhere else.
        </p>
      </section>
    )}

    {hasEpk && (
      <section class="mb-16">
        {epk.bio_short && (
          <p class="font-body text-white/70 leading-relaxed max-w-[62ch] mb-4">{epk.bio_short}</p>
        )}
        {epk.bio_long && (
          <details class="mb-6">
            <summary class="font-mono text-[10px] text-secondary uppercase tracking-widest cursor-pointer">Long bio</summary>
            <p class="font-body text-white/60 leading-relaxed max-w-[62ch] mt-3 whitespace-pre-line">{epk.bio_long}</p>
          </details>
        )}

        {pressPhotos.length > 0 && (
          <div class="mb-6">
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
              {pressPhotos.map(photo => (
                <a
                  href={photo.full}
                  download
                  rel="noopener"
                  class="group block border border-white/10 hover:border-secondary/40 transition-colors relative"
                  aria-label={`Download press photo, ${photo.width}×${photo.height}`}
                >
                  <img src={photo.src} alt="" loading="lazy" class="w-full aspect-[4/3] object-cover" />
                  {/* The dimensions ARE the useful label here — a press desk
                      is deciding whether it prints, not admiring a caption. */}
                  <span class="absolute bottom-0 right-0 bg-black/70 px-2 py-1 font-mono text-[9px] text-white/60 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity">
                    {photo.width}×{photo.height}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="flex flex-wrap gap-3">
          {epk.one_sheet_url && <a href={epk.one_sheet_url} download rel="noopener" class="font-mono text-[10px] uppercase tracking-widest text-primary border border-primary/20 hover:border-primary/60 px-4 py-2 rounded-full">One-sheet (PDF)</a>}
          {epk.rider_url && <a href={epk.rider_url} download rel="noopener" class="font-mono text-[10px] uppercase tracking-widest text-primary border border-primary/20 hover:border-primary/60 px-4 py-2 rounded-full">Rider (PDF)</a>}
          {epk.logo && <a href={epk.logo} download rel="noopener" class="font-mono text-[10px] uppercase tracking-widest text-primary border border-primary/20 hover:border-primary/60 px-4 py-2 rounded-full">Logo</a>}
          {liveVideos.map((v: any) => (
            <a href={v.url} rel="noopener" class="font-mono text-[10px] uppercase tracking-widest text-white/60 border border-white/10 hover:border-secondary/40 px-4 py-2 rounded-full">{v.label}</a>
          ))}
        </div>

      </section>
    )}

    <!-- The portal. One route, four intents: the branching question comes
         first and only the matching fields are revealed, because a talent
         buyer and a fan need completely different forms and showing both to
         everyone loses both. Field lists come from functions/_lib/contact.ts
         so the markup and the server-side validation cannot drift. -->
    <section id="contact" class="scroll-mt-28">
      <div class="flex items-baseline gap-3 mb-6">
        <span class="font-mono text-xs text-secondary uppercase tracking-widest">Get in touch</span>
        <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
      </div>

      <p class="font-mono text-[11px] text-white/50 mb-6">What brings you here?</p>

      <div id="intent-picker" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-10">
        {INTENT_ORDER.map(key => (
          <button
            type="button"
            class="intent-btn text-left p-5 border border-white/10 hover:border-secondary/40 hover:bg-secondary/5 transition-colors rounded-[var(--radius-lg)]"
            data-intent={key}
            aria-pressed="false"
          >
            <span class="block font-headline text-lg text-primary uppercase tracking-tight leading-none">{INTENTS[key].label}</span>
            <span class="block font-mono text-[10px] text-white/40 mt-2 leading-relaxed">{INTENTS[key].blurb}</span>
          </button>
        ))}
      </div>

      <form id="contact-form" class="hidden space-y-5" novalidate>
        <p id="contact-intro" class="font-mono text-[11px] text-white/50 leading-relaxed"></p>
        <div id="contact-fields" class="grid grid-cols-1 md:grid-cols-2 gap-5"></div>

        <!-- Honeypot. Hidden from sight AND from assistive tech, and never
             autofilled, so only a script fills it in. -->
        <div class="absolute w-px h-px overflow-hidden -left-[9999px]" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button type="submit" id="contact-submit" class="px-8 py-4 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30">
            Send
          </button>
          <button type="button" id="contact-back" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest">
            Change subject
          </button>
        </div>

        <p id="contact-status" role="status" aria-live="polite" class="font-mono text-[11px] text-white/50 min-h-5 leading-relaxed"></p>
      </form>

      <div id="contact-done" class="hidden p-8 border border-secondary/30 bg-secondary/5 rounded-[var(--radius-lg)]">
        <p class="font-headline text-2xl text-primary uppercase tracking-tight">Message sent</p>
        <p id="contact-done-msg" class="font-mono text-[11px] text-white/60 mt-3 leading-relaxed"></p>
      </div>
    </section>
  </div>

  <script>
    import { INTENTS, INTENT_ORDER, type IntentKey } from '../../functions/_lib/contact';

    document.addEventListener('astro:page-load', () => {
      const picker = document.getElementById('intent-picker');
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!picker || !form) return;

      const fieldsEl = document.getElementById('contact-fields')!;
      const introEl = document.getElementById('contact-intro')!;
      const statusEl = document.getElementById('contact-status')!;
      const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
      const backBtn = document.getElementById('contact-back')!;
      const doneEl = document.getElementById('contact-done')!;
      const doneMsg = document.getElementById('contact-done-msg')!;

      let intent: IntentKey | null = null;
      // Stamped when the form is revealed, not on page load: the elapsed
      // check is about how long someone spent FILLING the form, and a
      // visitor who reads the events list for five minutes first is not
      // more human for it.
      let shownAt = 0;

      const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g,
        c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

      function renderFields(key: IntentKey) {
        const spec = INTENTS[key];
        introEl.textContent = `${spec.label} — you'll hear back ${spec.replyWithin}.`;
        fieldsEl.innerHTML = spec.fields.map(f => {
          const id = 'f-' + f.name;
          const wide = f.type === 'textarea' ? ' md:col-span-2' : '';
          const control = f.type === 'textarea'
            ? `<textarea id="${id}" name="${esc(f.name)}" rows="5" maxlength="${f.maxLength ?? 500}"
                 class="w-full px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-body text-sm text-white/80 rounded-[var(--radius)] resize-y"
                 ${f.placeholder ? `placeholder="${esc(f.placeholder)}"` : ''}></textarea>`
            : `<input id="${id}" name="${esc(f.name)}" type="${esc(f.type || 'text')}" maxlength="${f.maxLength ?? 500}"
                 ${f.name === 'email' ? 'autocomplete="email"' : ''}
                 ${f.name === 'name' ? 'autocomplete="name"' : ''}
                 class="w-full px-4 py-3 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-sm text-primary"
                 ${f.placeholder ? `placeholder="${esc(f.placeholder)}"` : ''} />`;
          return `
            <div class="${wide}">
              <label for="${id}" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">
                ${esc(f.label)}${f.required ? '' : ' <span class="text-white/20 normal-case tracking-normal">(optional)</span>'}
              </label>
              ${control}
              <p class="field-error font-mono text-[10px] text-error mt-2 min-h-4" data-for="${esc(f.name)}"></p>
            </div>`;
        }).join('');
      }

      function choose(key: IntentKey) {
        intent = key;
        shownAt = Date.now();
        renderFields(key);
        picker.querySelectorAll<HTMLButtonElement>('.intent-btn').forEach(b => {
          const on = b.dataset.intent === key;
          b.setAttribute('aria-pressed', String(on));
          b.classList.toggle('border-primary', on);
          b.classList.toggle('bg-primary/10', on);
        });
        form!.classList.remove('hidden');
        statusEl.textContent = '';
        (fieldsEl.querySelector('input, textarea') as HTMLElement | null)?.focus();
      }

      picker.querySelectorAll<HTMLButtonElement>('.intent-btn').forEach(btn => {
        btn.addEventListener('click', () => choose(btn.dataset.intent as IntentKey));
      });

      backBtn.addEventListener('click', () => {
        form!.classList.add('hidden');
        intent = null;
        picker.querySelectorAll<HTMLButtonElement>('.intent-btn').forEach(b => {
          b.setAttribute('aria-pressed', 'false');
          b.classList.remove('border-primary', 'bg-primary/10');
        });
        picker.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      function clearErrors() {
        form!.querySelectorAll<HTMLElement>('.field-error').forEach(p => { p.textContent = ''; });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!intent) return;
        clearErrors();
        submitBtn.disabled = true;
        statusEl.textContent = 'Sending…';

        const payload: Record<string, unknown> = {
          intent,
          website: (document.getElementById('website') as HTMLInputElement).value,
          elapsed_seconds: Math.round((Date.now() - shownAt) / 1000),
        };
        for (const f of INTENTS[intent].fields) {
          const el = form!.elements.namedItem(f.name) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el) payload[f.name] = el.value;
        }

        try {
          const r = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await r.json().catch(() => ({}));

          if (r.status === 400 && data.errors) {
            // Errors land ON their fields, not in one lump at the bottom —
            // a long booking form is exactly where a summary makes you hunt.
            for (const [name, msg] of Object.entries(data.errors as Record<string, string>)) {
              const p = form!.querySelector<HTMLElement>(`.field-error[data-for="${CSS.escape(name)}"]`);
              if (p) p.textContent = msg;
            }
            statusEl.textContent = 'Some details need a look.';
            const first = form!.querySelector<HTMLElement>('.field-error:not(:empty)');
            first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
          if (r.status === 429) { statusEl.textContent = 'That is a lot of messages — try again in a few minutes.'; return; }
          if (!r.ok) throw new Error(data.error || 'send failed');

          form!.classList.add('hidden');
          picker.classList.add('hidden');
          doneEl.classList.remove('hidden');
          doneMsg.textContent = `You'll hear back ${data.reply_within || 'shortly'}. A copy is on its way to your inbox.`;
          doneEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err: any) {
          statusEl.textContent = 'That did not send — check your connection and try again, or email morphicsmusic@gmail.com directly.';
        } finally {
          submitBtn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .shows-more { display: flex; flex-direction: column; }
  .shows-toggle { order: 2; list-style: none; }
  /* Safari still paints its own triangle without this. */
  .shows-toggle::-webkit-details-marker { display: none; }
</style>
