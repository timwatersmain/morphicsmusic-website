---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrambleGrid from '../components/ScrambleGrid.astro';
---

<BaseLayout title="MORPHICS" currentPage="/">
  <!-- Hero — fills the viewport between the top nav and the bottom edge,
       centers the wordmark + tagline on every device. No accents, no
       footer line, no decoration: the landing is the cleanest page. -->
  <section class="relative min-h-[calc(100dvh-12rem)] w-full flex flex-col items-center justify-center px-6 overflow-hidden">
    <ScrambleGrid />
    <!-- Centred on the BUTTON, not on the block: the wordmark is much shorter
         on mobile than desktop, so centring the pair together put ENTER at a
         different height on each. The wordmark hangs above it instead, which
         keeps the button in the same place on every screen. -->
    <div class="relative z-10 flex items-center justify-center text-center px-4">
      <h1 data-no-vt class="absolute bottom-full left-1/2 -translate-x-1/2 mb-10 md:mb-12">
        <img
          src="/images/logos/morphics-text-white.png"
          alt="MORPHICS"
          class="max-h-24 md:h-36 lg:h-44 w-auto max-w-[86vw] mx-auto"
        />
      </h1>
      <a href="/music" data-resolve-trigger class="group relative inline-block px-12 py-4 overflow-hidden border border-primary/20 hover:border-primary/60 transition-all duration-500 hover:scale-105 active:scale-95 rounded-full">
        <div class="absolute inset-0 bg-primary/5 group-hover:bg-primary/10 transition-colors"></div>
        <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-primary group-hover:w-full transition-all duration-700"></div>
        <span class="relative z-10 font-headline font-bold text-primary tracking-[0.4em] text-sm uppercase">ENTER</span>
      </a>
    </div>
  </section>
</BaseLayout>
