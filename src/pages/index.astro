---
import BaseLayout from '../layouts/BaseLayout.astro';
import releases from '../data/releases.json';
import visuals from '../data/visuals.json';

const featuredRelease = releases.find(r => r.featured);
const recentVisuals = visuals.slice(0, 4);
---

<BaseLayout title="MORPHICS" currentPage="/">
  <!-- Hero Section -->
  <section class="relative h-screen w-full flex flex-col items-center justify-center px-6 overflow-hidden">
    <div class="relative z-10 text-center max-w-4xl px-4">
      <h1 class="mb-6">
        <img
          src="/images/logos/morphics-text-white.png"
          alt="MORPHICS"
          class="h-24 md:h-36 lg:h-44 w-auto mx-auto"
        />
      </h1>
      <p class="font-body text-lg md:text-xl text-on-surface-variant font-light tracking-wide max-w-lg mx-auto mb-12">
        The only constant is change.
      </p>
      <a href="#below-fold" class="group relative inline-block px-12 py-4 overflow-hidden border border-primary/20 hover:border-primary/60 transition-all duration-500 hover:scale-105 active:scale-95">
        <div class="absolute inset-0 bg-primary/5 group-hover:bg-primary/10 transition-colors"></div>
        <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-primary group-hover:w-full transition-all duration-700"></div>
        <span class="relative z-10 font-headline font-bold text-primary tracking-[0.4em] text-sm uppercase">ENTER</span>
      </a>
    </div>
  </section>

  <!-- Below the Fold -->
  <section id="below-fold" class="max-w-[1400px] mx-auto px-8 pb-32">
    <!-- Latest Release -->
    {featuredRelease && (
      <div class="mb-32">
        <div class="flex items-baseline gap-4 mb-8">
          <span class="font-mono text-xs text-secondary uppercase">Latest Release</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="relative">
            <img src="/images/brand/morph-line-a.png" alt="" style="width: 115%; max-width: none; position: absolute; bottom: -5rem; left: 50%; transform: translateX(-50%);" class="invert opacity-15 pointer-events-none" loading="lazy" />
            <div class="group relative overflow-hidden border border-white/5 terminal-glow">
              <img
                src={featuredRelease.artwork}
                alt={featuredRelease.title}
                class="w-full aspect-square object-cover grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700"
              />
            </div>
          </div>
          <div>
            <h2 class="font-headline text-5xl font-bold text-primary tracking-tighter mb-4">{featuredRelease.title}</h2>
            <div class="flex gap-6 font-mono text-[10px] text-white/40 mb-6">
              <span>TYPE: <span class="text-secondary">{featuredRelease.type.toUpperCase()}</span></span>
            </div>
            <div class="flex flex-wrap gap-2 mb-8">
              {featuredRelease.genre.map(g => (
                <span class="px-2 py-1 bg-white/5 text-[9px] font-mono text-primary border border-primary/10">#{g.toUpperCase()}</span>
              ))}
            </div>
            <div class="flex flex-wrap gap-4">
              {Object.entries(featuredRelease.links).map(([platform, url]) => (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener"
                  class="px-6 py-3 border border-primary/20 hover:bg-primary hover:text-on-primary font-mono text-[10px] tracking-widest transition-all uppercase"
                >
                  {platform.toUpperCase()}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}


    <!-- Recent Visuals -->
    <div>
      <div class="flex items-baseline gap-4 mb-8">
        <span class="font-mono text-xs text-secondary uppercase">Recent Visuals</span>
        <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
        <a href="/visuals" class="font-mono text-[10px] text-primary/50 hover:text-primary tracking-widest transition-colors uppercase">View All &rarr;</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {recentVisuals.map(v => (
          <a href="/visuals" class="group relative overflow-hidden border border-outline-variant card-glow transition-all duration-500 hover:scale-[1.02]">
            <img
              src={v.image}
              alt={v.title}
              class="w-full aspect-square object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-90 transition-all duration-500"
            />
          </a>
        ))}
      </div>
    </div>

    <!-- Visuals shelf -->
    <div class="brand-divider brand-divider--wide mt-8 mb-0">
      <img src="/images/brand/morph-line-t.png" alt="" style="max-width: none; width: 80%; transform: scaleY(-1);" class="invert opacity-15" loading="lazy" />
    </div>
  </section>

  <!-- Footer -->
  <footer class="max-w-[1400px] mx-auto px-8 py-12 flex flex-col md:flex-row justify-between items-center gap-6 border-t border-outline-variant/30">
    <div class="font-mono text-[10px] tracking-widest uppercase text-secondary/40">
      &copy;2025 MORPHICS
    </div>
    <div class="flex gap-8">
      <a class="font-mono text-[10px] tracking-widest uppercase text-secondary/40 hover:text-primary transition-all duration-500" href="https://morphics.bandcamp.com/" target="_blank" rel="noopener">BANDCAMP</a>
      <a class="font-mono text-[10px] tracking-widest uppercase text-secondary/40 hover:text-primary transition-all duration-500" href="https://www.instagram.com/morphicsmusic/" target="_blank" rel="noopener">INSTAGRAM</a>
      <a class="font-mono text-[10px] tracking-widest uppercase text-secondary/40 hover:text-primary transition-all duration-500" href="https://www.twitter.com/MorphicsMusic" target="_blank" rel="noopener">TWITTER</a>
      <a class="font-mono text-[10px] tracking-widest uppercase text-secondary/40 hover:text-primary transition-all duration-500" href="https://www.tiktok.com/@skratchwax" target="_blank" rel="noopener">TIKTOK</a>
      <a class="font-mono text-[10px] tracking-widest uppercase text-secondary/40 hover:text-primary transition-all duration-500" href="https://www.pinterest.com/morphicsmusic/" target="_blank" rel="noopener">PINTEREST</a>
    </div>
  </footer>
</BaseLayout>
