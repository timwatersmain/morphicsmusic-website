---
import PageTitle from '../components/PageTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import signalData from '../data/signal.json';

// Cap each column so the feed stays a tidy, evenly-sized grid.
const videoPosts = signalData.filter(p => p.type === 'video').slice(0, 2);
const photoPosts = signalData.filter(p => p.type === 'image' || p.type === 'visual' || p.type === 'photo').slice(0, 4);
// Only true text/track posts — never let a media post fall through here just
// because its mediaUrl is empty (TikTok video URLs aren't directly embeddable
// by file, but they're still videos and belong in the video column).
const textPosts = signalData.filter(p => p.type === 'text' || p.type === 'track').slice(0, 4);

function tiktokVideoId(url: string): string | null {
  const m = url.match(/\/video\/(\d+)/);
  return m ? m[1] : null;
}

const platforms = [
  { name: 'BANDCAMP', icon: 'album', url: 'https://morphics.bandcamp.com/' },
  { name: 'SPOTIFY', icon: 'music_note', url: 'https://open.spotify.com/artist/morphics' },
  { name: 'AUDIUS', icon: 'headphones', url: 'https://audius.co/morphics' },
  { name: 'INSTAGRAM', icon: 'photo_camera', url: 'https://www.instagram.com/morphicsmusic/' },
  { name: 'TWITTER', icon: 'tag', url: 'https://www.twitter.com/MorphicsMusic' },
  { name: 'FACEBOOK', icon: 'group', url: 'https://www.facebook.com/morphicsmusic/' },
  { name: 'TIKTOK', icon: 'slow_motion_video', url: 'https://www.tiktok.com/@skratchwax' },
  { name: 'PINTEREST', icon: 'push_pin', url: 'https://www.pinterest.com/morphicsmusic/' },
  // Uses the shared constant, not a second copy of the URL — a stale invite
  // fails silently, so there must only ever be one to update.
  { name: 'DISCORD', icon: 'forum', url: INVITE_URL },
  { name: 'KICK', icon: 'live_tv', url: 'https://kick.com/morphicsmusic' },
];

const platformIcons: Record<string, string> = {
  youtube: 'play_circle',
  spotify: 'music_note',
  soundcloud: 'cloud',
  instagram: 'photo_camera',
  bandcamp: 'album',
  twitter: 'tag',
  facebook: 'group',
  audius: 'headphones',
  tiktok: 'slow_motion_video',
  pinterest: 'push_pin',
};

const typeIcons: Record<string, string> = {
  video: 'videocam',
  track: 'graphic_eq',
  visual: 'image',
};
import { INVITE_URL } from '../components/DiscordInvite.astro';
---

<BaseLayout title="SOCIAL" currentPage="/social">
  <PageTitle title="SOCIAL" />

  <!-- Platform Nodes (Particle Array) -->
  <div class="mb-4 relative">
    <div class="flex flex-wrap items-center justify-center gap-12 relative py-2">
      {platforms.map((platform, i) => (
        <a
          href={platform.url}
          class="group relative flex flex-col items-center gap-3 transition-all duration-[400ms] hover:scale-110"
        >
          <div class="w-16 h-16 border border-outline-variant/30 flex items-center justify-center bg-surface-container-low rounded-[var(--radius-lg)] hover:border-primary/60 hover:bg-primary/5 transition-all duration-[400ms] shadow-[0_0_40px_rgba(0,219,233,0.06)]">
            <span class="material-symbols-outlined text-2xl text-primary/60 group-hover:text-primary transition-colors">{platform.icon}</span>
          </div>
          <span class="font-mono text-[9px] tracking-widest text-white/30 group-hover:text-primary transition-colors">{platform.name}</span>
          {i < platforms.length - 1 && (
            <div class="absolute top-8 left-full w-12 h-[0.5px] bg-outline-variant/30 hidden lg:block"></div>
          )}
        </a>
      ))}
    </div>
  </div>


  <!-- Feed divider -->
  <div class="brand-divider brand-divider--wide mt-2 mb-6">
    <img src="/images/brand/morph-line-n.png" alt="" loading="lazy" />
  </div>

  <!-- Feed: 3-column by media type -->
  <div class="signal-feed">
    <!-- Video Posts -->
    <div class="signal-column">
      <div class="signal-column-header">
        <span class="material-symbols-outlined text-sm text-secondary">videocam</span>
        <span class="font-mono text-[10px] text-secondary uppercase tracking-widest">Video</span>
        <span class="font-mono text-[9px] text-white/20">{videoPosts.length}</span>
      </div>
      {videoPosts.length > 0 ? videoPosts.map(post => (
        <a href={post.url} class="signal-card group block" target="_blank" rel="noopener">
          <div class="relative overflow-hidden bg-black tiktok-frame">
            {post.platform === 'tiktok' && tiktokVideoId(post.url) ? (
              <div class="relative w-full h-full bg-[#0A0A0A]">
                <iframe
                  src={`https://www.tiktok.com/embed/v2/${tiktokVideoId(post.url)}`}
                  class="absolute inset-0 w-full h-full"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
                <!-- Solid masks covering TikTok's internal white pillarbox + top hairline (iframe is cross-origin so we can't restyle it). -->
                <div class="pointer-events-none absolute inset-y-0 left-0 w-[22%] bg-[#0A0A0A]"></div>
                <div class="pointer-events-none absolute inset-y-0 right-0 w-[22%] bg-[#0A0A0A]"></div>
                <div class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[#0A0A0A]"></div>
              </div>
            ) : (
              <!-- #t=0.1 is a media fragment, and it is what stops these cards
                   being black rectangles. Every one of these posts has an empty
                   `thumbnail` and there is no poster to fall back on, so a
                   preload="metadata" video paints nothing until it is hovered.
                   Seeking to 0.1s makes the browser render that frame as a de
                   facto poster — and it costs one range request for the head of
                   the file, not the whole video, so preload stays at metadata. -->
              <video
                src={`${post.mediaUrl}#t=0.1`}
                class="w-full aspect-video object-cover opacity-60 group-hover:opacity-90 transition-all duration-500"
                muted loop playsinline preload="metadata" data-hover-play
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent pointer-events-none"></div>
            <div class="absolute top-3 right-3">
              <div class="bg-background/80 px-2 py-1 backdrop-blur-md flex items-center gap-1.5 rounded-full">
                <span class="material-symbols-outlined text-sm text-primary">{platformIcons[post.platform]}</span>
                <span class="font-mono text-[8px] text-primary uppercase">{post.platform}</span>
              </div>
            </div>
          </div>
          <div class="p-4">
            <p class="font-mono text-[11px] text-white/50 leading-relaxed mb-3">{post.caption}</p>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[9px] text-white/20">{post.date}</span>
              <div class="flex gap-1">
                {post.originalPlatforms.map(p => (
                  <span class="w-1.5 h-1.5 bg-primary/30 rounded-full" title={p}></span>
                ))}
              </div>
            </div>
          </div>
        </a>
      )) : (
        <div class="signal-empty">
          <span class="material-symbols-outlined text-2xl text-white/10">videocam_off</span>
          <span class="font-mono text-[9px] text-white/15 uppercase">No recent videos</span>
        </div>
      )}
    </div>

    <!-- Photo Posts -->
    <div class="signal-column">
      <div class="signal-column-header">
        <span class="material-symbols-outlined text-sm text-secondary">image</span>
        <span class="font-mono text-[10px] text-secondary uppercase tracking-widest">Photo</span>
        <span class="font-mono text-[9px] text-white/20">{photoPosts.length}</span>
      </div>
      {photoPosts.length > 0 ? photoPosts.map(post => (
        <a href={post.url} class="signal-card group block" target="_blank" rel="noopener">
          <div class="relative overflow-hidden">
            <!-- alt="" is deliberate. The caption is rendered as real text
                 directly below this image, so repeating it in alt is duplicate
                 content for a screen reader — and when the image fails to
                 load, that duplicate is what paints, at body size, straight
                 across the card. Decorative image, captioned in the DOM. -->
            <img
              src={post.thumbnail || post.mediaUrl || ''}
              alt=""
              loading="lazy"
              decoding="async"
              class="w-full aspect-square object-cover opacity-60 group-hover:opacity-90 transition-all duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent"></div>
            <div class="absolute top-3 right-3">
              <div class="bg-background/80 px-2 py-1 backdrop-blur-md flex items-center gap-1.5 rounded-full">
                <span class="material-symbols-outlined text-sm text-primary">{platformIcons[post.platform]}</span>
                <span class="font-mono text-[8px] text-primary uppercase">{post.platform}</span>
              </div>
            </div>
          </div>
          <div class="p-4">
            <p class="font-mono text-[11px] text-white/50 leading-relaxed mb-3">{post.caption}</p>
            <span class="font-mono text-[9px] text-white/20">{post.date}</span>
          </div>
        </a>
      )) : (
        <div class="signal-empty">
          <span class="material-symbols-outlined text-2xl text-white/10">image</span>
          <span class="font-mono text-[9px] text-white/15 uppercase">No recent photos</span>
        </div>
      )}
    </div>

    <!-- Text Posts -->
    <div class="signal-column">
      <div class="signal-column-header">
        <span class="material-symbols-outlined text-sm text-secondary">chat</span>
        <span class="font-mono text-[10px] text-secondary uppercase tracking-widest">Text</span>
        <span class="font-mono text-[9px] text-white/20">{textPosts.length}</span>
      </div>
      {textPosts.length > 0 ? textPosts.map(post => (
        <a href={post.url} class="signal-card signal-card--text group block" target="_blank" rel="noopener">
          <div class="p-5">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-sm text-primary">{platformIcons[post.platform]}</span>
              <span class="font-mono text-[8px] text-primary uppercase">{post.platform}</span>
            </div>
            <p class="font-body text-sm text-white/70 leading-relaxed mb-4 group-hover:text-white/90 transition-colors">{post.caption}</p>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[9px] text-white/20">{post.date}</span>
              <div class="flex gap-1">
                {post.originalPlatforms.map(p => (
                  <span class="w-1.5 h-1.5 bg-primary/30 rounded-full" title={p}></span>
                ))}
              </div>
            </div>
          </div>
        </a>
      )) : (
        <div class="signal-empty">
          <span class="material-symbols-outlined text-2xl text-white/10">chat_bubble</span>
          <span class="font-mono text-[9px] text-white/15 uppercase">No recent text posts</span>
        </div>
      )}
    </div>
  </div>

</BaseLayout>

<style>
  .signal-feed {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .signal-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* Deliberately NO min-height. It used to be 920px, with the cards below
       set to flex:1 1 0 so they divided it between them. That is what put a
       200px void under every short post — "Never been more locked in" is one
       line of text in a 260px card. Forcing three columns of unrelated content
       to the same height can only be paid for out of whitespace inside the
       cards. Columns now end where their content ends. */
  }

  .signal-column-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--outline-variant);
    margin-bottom: 0.25rem;
  }

  .signal-card {
    border: 1px solid rgba(255,255,255,0.05);
    /* NO background here on purpose. It used to hard-code
       var(--surface-container-low), which is why these cards stayed opaque
       when every other panel on the site went glass: a scoped Astro rule
       carries a [data-astro-cid] attribute and outranks the global one. The
       fill now comes from the shared glass block in global.css, which also
       gets these cards the mobile no-blur path and the
       prefers-reduced-transparency fallback for free. */
    transition: all 0.4s;
    /* Rounded on the same role scale as every other card surface
       (--radius-lg, see global.css). overflow:hidden is what actually clips
       the media inside to the corner, so the radius has to live on the card
       itself, not on the image. */
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Content-sized, not stretched. See the note on .signal-column. */
    flex: 0 0 auto;
  }
  /* Media area takes the top portion, caption locked to bottom. */
  .signal-card > .relative {
    flex: 0 0 auto;
    /* Safari drops the parent's overflow clip for an iframe/video inside a
       composited layer, so the media wrapper carries the top corners too. */
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
  }
  /* Images hold a square. They previously had height:100% + aspect-ratio:auto
     so they could fill whatever height the flex stretch handed them — with the
     stretch gone, that would collapse them. */
  .signal-card > .relative > img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0;
  }
  .signal-card > .relative > video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    /* The global img/video rule rounds all four corners; inside a card the
       bottom two would float above a square caption block. The card clips. */
    border-radius: 0;
  }
  .signal-card > .p-4,
  .signal-card > .p-5 {
    flex: 0 0 auto;
  }
  .signal-card p {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .signal-card--text p {
    -webkit-line-clamp: 5;
  }
  .signal-card:hover {
    border-color: rgba(var(--primary-rgb, 0, 204, 168), 0.3);
  }

  .tiktok-frame,
  .tiktok-frame > .relative {
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
  }

  .signal-card--text {
    border-left: 2px solid rgba(var(--primary-rgb, 0, 204, 168), 0.2);
  }
  .signal-card--text:hover {
    border-left-color: var(--primary);
  }

  .signal-empty {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    border: 1px dashed rgba(255,255,255,0.06);
    border-radius: var(--radius-lg);
    min-height: 200px;
  }

  @media (max-width: 768px) {
    .signal-feed {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Bundled scripts execute once per session under the client router, so
  // this has to re-run on every arrival (fresh cards each time) rather than
  // only the first — astro:page-load covers the first load too.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-hover-play]').forEach(video => {
      const card = video.closest('a');
      if (!card) return;
      card.addEventListener('mouseenter', () => { (video as HTMLVideoElement).play().catch(() => {}); });
      // Back to 0.1, not 0 — 0 is the black frame these files start on, and
      // resetting there would undo the poster the media fragment set.
      card.addEventListener('mouseleave', () => { (video as HTMLVideoElement).pause(); (video as HTMLVideoElement).currentTime = 0.1; });
    });
  });
</script>
