---
import Artwork from '../../../components/Artwork.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import catalog from '../../../data/music-catalog.json';
import previews from '../../../data/previews.json';

export function getStaticPaths() {
  return catalog.releases.map(r => ({ params: { slug: r.slug }, props: { release: r } }));
}

const { release } = Astro.props;
const minPriceDollars = (release.min_price_cents / 100).toFixed(0);

// track_number → preview R2 key for this release (if a preview exists).
const previewByTrack: Record<number, string> = {};
for (const p of ((previews as any).previews?.[release.slug] || [])) {
  if (p.track_number != null && p.key) previewByTrack[p.track_number] = p.key;
}
// Fall back to first preview for the release-level quick play.
const firstPreview = ((previews as any).previews?.[release.slug] || [])[0];
const firstPreviewKey = firstPreview?.key || null;
const firstTrackTitle =
  release.tracks.find((t: any) => t.track_number === firstPreview?.track_number)?.title || release.title;

const buyable =
  !!release.has_masters && (!release.release_date || new Date(release.release_date) <= new Date());

function fmtDuration(seconds: number | null) {
  if (!seconds) return '—';
  const m = Math.floor(seconds / 60);
  const s = String(seconds % 60).padStart(2, '0');
  return `${m}:${s}`;
}
---

<BaseLayout title={release.title} currentPage="/store">
  <div class="max-w-[1400px] mx-auto">
    <a href="/store" class="inline-flex items-center gap-2 font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest mb-8">
      <span class="material-symbols-outlined text-sm">arrow_back</span> Back to store
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="relative bg-surface-container-low border border-white/5 rounded-lg overflow-hidden overflow-hidden group">
        <Artwork src={release.artwork} alt={release.title} priority sizes="(max-width: 767px) 100vw, 460px" class="w-full aspect-square object-cover" />
        {firstPreviewKey && (
          <button
            type="button"
            data-preview-key={firstPreviewKey}
            data-preview-title={firstTrackTitle}
            data-preview-sub={release.title}
            data-preview-art={release.artwork}
            data-cart-slug={release.slug}
            data-cart-title={release.title}
            data-cart-type={release.type}
            data-cart-count={release.track_count}
            data-cart-cents={release.min_price_cents}
            data-cart-buyable={buyable ? '1' : '0'}
            data-track-num={firstPreview?.track_number || 1}
            aria-label="Play preview"
            class="preview-btn absolute bottom-4 right-4 w-14 h-14 flex items-center justify-center bg-primary/90 text-on-primary hover:bg-secondary hover:text-on-secondary backdrop-blur-sm transition-colors shadow-lg"
          >
            <span class="material-symbols-outlined text-3xl leading-none">play_arrow</span>
          </button>
        )}
      </div>

      <div>
        <span class="font-mono text-[10px] text-secondary uppercase tracking-widest">{release.type}</span>
        <h1 class="font-headline font-bold text-4xl md:text-5xl text-primary uppercase tracking-tight mt-2 mb-4 leading-none">
          {release.title}
        </h1>
        {release.description && (
          <p class="font-mono text-[11px] text-white/50 leading-relaxed mb-6">{release.description}</p>
        )}
        <div class="flex flex-wrap gap-2 mb-8">
          {release.genre.map(g => (
            <span class="px-2 py-1 bg-white/5 text-[9px] font-mono text-primary border border-primary/10 uppercase rounded-full">#{g}</span>
          ))}
        </div>

        <form id="release-form" class="space-y-6">
          <div>
            <label class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-3">
              Name your price · Minimum ${minPriceDollars}
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 font-mono text-secondary">$</span>
              <input
                type="number"
                name="price"
                min={minPriceDollars}
                step="1"
                value={minPriceDollars}
                class="w-full pl-10 pr-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-2xl text-primary"
                required
              />
            </div>
            <p class="font-mono text-[9px] text-white/30 mt-2">FLAC + MP3 download · Delivered by email after purchase</p>
          </div>
          <button
            id="release-submit"
            type="submit"
            class="w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
            disabled={!release.has_masters || (!!release.release_date && new Date(release.release_date) > new Date())}
          >
            {release.has_masters ? 'Add to Cart' : 'Coming soon'}
          </button>
          {release.release_date && new Date(release.release_date) > new Date() && (
            <p id="release-countdown" class="font-mono text-[10px] text-secondary uppercase tracking-widest mt-2" data-release-date={release.release_date}>
              Releases {release.release_date}
            </p>
          )}
          {!release.has_masters && (
            <p class="font-mono text-[10px] text-white/40">Master files not yet uploaded for this release.</p>
          )}
        </form>

        {release.bandcamp_url && (
          <a href={release.bandcamp_url} target="_blank" rel="noopener" class="block mt-4 text-center py-3 border border-white/10 hover:border-secondary/40 font-mono text-[10px] text-white/60 hover:text-secondary uppercase tracking-widest transition-colors rounded-full">
            Or get on Bandcamp →
          </a>
        )}
      </div>
    </div>

    {release.tracks.length > 0 && (
      <section class="mt-16">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="font-mono text-xs text-secondary uppercase">Tracks</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
          <span class="font-mono text-[10px] text-white/30">{release.tracks.length}</span>
        </div>
        <ol class="divide-y divide-white/5">
          {release.tracks.map(t => {
            const pkey = previewByTrack[t.track_number];
            const playAttrs = pkey ? {
              'data-preview-key': pkey,
              'data-preview-title': t.title,
              'data-preview-sub': release.title,
              'data-preview-art': release.artwork,
              'data-cart-slug': release.slug,
              'data-cart-title': release.title,
              'data-cart-type': release.type,
              'data-cart-count': release.track_count,
              'data-cart-cents': release.min_price_cents,
              'data-cart-buyable': buyable ? '1' : '0',
              'data-track-num': t.track_number,
              'role': 'button',
              'tabindex': '0',
              'aria-label': `Play ${t.title}`,
            } : {};
            return (
              <li
                id={`track-${t.track_number}`}
                {...playAttrs}
                class:list={[
                  'track-row flex items-center gap-4 py-3 px-3 -mx-3 scroll-mt-28 transition-colors target:bg-secondary/10',
                  pkey && 'is-playable cursor-pointer hover:bg-white/[0.05]',
                ]}
              >
                <span class="track-ctrl shrink-0 w-8 h-8 flex items-center justify-center relative">
                  <span class="track-num font-mono text-[10px] text-white/30">{String(t.track_number).padStart(2, '0')}</span>
                  {pkey && (
                    <span class="track-icon material-symbols-outlined text-primary text-xl leading-none absolute inset-0 flex items-center justify-center">play_arrow</span>
                  )}
                </span>
                <span class:list={['flex-1 font-headline uppercase tracking-tight transition-colors', pkey ? 'text-primary' : 'text-white/40']}>{t.title}</span>
                <span class="shrink-0 font-mono text-[10px] text-white/40">{fmtDuration(t.duration_seconds)}</span>
              </li>
            );
          })}
        </ol>
        <style is:global>
          .track-row .track-icon { opacity: 0; transition: opacity 150ms ease; }
          .track-row .track-num { opacity: 1; transition: opacity 150ms ease; }
          .track-row.is-playable:hover .track-icon,
          .track-row.preview-playing .track-icon { opacity: 1; }
          .track-row.is-playable:hover .track-num,
          .track-row.preview-playing .track-num { opacity: 0; }
          .track-row.is-playable:hover .font-headline { color: var(--color-secondary); }
          .track-row.preview-playing .font-headline { color: var(--color-secondary); }
        </style>
      </section>
    )}
  </div>

  <script type="application/json" id="release-data" set:html={JSON.stringify({
    slug: release.slug,
    title: release.title,
    image: release.artwork,
    min_cents: release.min_price_cents,
    track_count: release.track_count,
    type: release.type,
    release_date: release.release_date,
  })} />

  <script>
    import '../../../scripts/cart.js';
    import '../../../scripts/preview-player.js';
    import { goLiveUtcMs, isReleased } from '../../../../functions/_lib/release-gate.mjs';
    const release = JSON.parse(document.getElementById('release-data')!.textContent || '{}');
    const form = document.getElementById('release-form') as HTMLFormElement;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalLabel = submitBtn.textContent;

    const cdEl = document.getElementById('release-countdown');
    const liveAt = goLiveUtcMs(release.release_date || '');
    if (cdEl && Number.isFinite(liveAt)) {
      const tick = () => {
        if (isReleased(release.release_date)) {
          cdEl.style.display = 'none';
          if (submitBtn) submitBtn.disabled = false;
          clearInterval(timer);
          return;
        }
        const s = Math.max(0, Math.floor((liveAt - Date.now()) / 1000));
        const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
        cdEl.textContent = `Releases in ${d}d ${h}h ${m}m`;
      };
      var timer = setInterval(tick, 1000);
      tick();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const dollars = parseFloat(String(fd.get('price') || '0'));
      const cents = Math.round(dollars * 100);
      if (cents < release.min_cents) return;

      (window as any).morphicsCart.add({
        type: 'music',
        sku: `music:${release.slug}`,
        title: release.title,
        subtitle: `${release.type.toUpperCase()} · ${release.track_count} track${release.track_count === 1 ? '' : 's'} · digital`,
        image: release.image,
        unit_amount: cents,
        qty: 1,
        metadata: { release_slug: release.slug },
      });

      // Confirm to the user without hijacking focus to the drawer.
      submitBtn.textContent = '✓ Added — view cart';
      submitBtn.classList.add('bg-secondary', 'text-on-secondary');
      setTimeout(() => {
        submitBtn.textContent = originalLabel;
        submitBtn.classList.remove('bg-secondary', 'text-on-secondary');
      }, 2000);
    });
  </script>
</BaseLayout>
