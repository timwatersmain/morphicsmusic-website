---
import Artwork from '../../../components/Artwork.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import catalog from '../../../data/music-catalog.json';
import previews from '../../../data/previews.json';
import { isPreorderable } from '../../../../functions/_lib/preorder.mjs';

export function getStaticPaths() {
  return catalog.releases.map(r => ({ params: { slug: r.slug }, props: { release: r } }));
}

const { release } = Astro.props;
const minPriceDollars = (release.min_price_cents / 100).toFixed(0);

// track_number → preview R2 key for this release (if a preview exists).
const previewByTrack: Record<number, string> = {};
for (const p of ((previews as any).previews?.[release.slug] || [])) {
  if (p.track_number != null && p.key) previewByTrack[p.track_number] = p.key;
}
// Fall back to first preview for the release-level quick play.
const firstPreview = ((previews as any).previews?.[release.slug] || [])[0];
const firstPreviewKey = firstPreview?.key || null;
const firstTrackTitle =
  release.tracks.find((t: any) => t.track_number === firstPreview?.track_number)?.title || release.title;

const buyable =
  !!release.has_masters && (!release.release_date || new Date(release.release_date) <= new Date());
// Evaluated at BUILD time, like `buyable` above it. That is fine in one
// direction only: a page built while the release was still pending goes stale
// the moment the date passes, so the countdown script below re-enables the
// button and rewrites its label at runtime rather than trusting this.
// Its own card if one was generated (every release with artwork has one), the
// site card otherwise. The same `artwork` field decides both here and in
// scripts/generate-og-cards.mjs, so the two cannot disagree.
const ogImage = release.artwork
  ? `/images/og/release-${release.slug}.jpg`
  : '/images/og/og-default.jpg';
const preorder = !!release.has_masters && isPreorderable(release.slug, release.release_date);

function fmtDuration(seconds: number | null) {
  if (!seconds) return '—';
  const m = Math.floor(seconds / 60);
  const s = String(seconds % 60).padStart(2, '0');
  return `${m}:${s}`;
}
---

<BaseLayout title={release.title} currentPage="/store" ogImage={ogImage}>
  <div class="max-w-[1400px] mx-auto">
    <a href="/store" class="inline-flex items-center gap-2 font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest mb-8">
      <span class="material-symbols-outlined text-sm">arrow_back</span> Back to store
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="relative bg-surface-container-low border border-white/5 rounded-lg overflow-hidden overflow-hidden group">
        <Artwork src={release.artwork} alt={release.title} priority sizes="(max-width: 767px) 100vw, 460px" class="w-full aspect-square object-cover" />
        {firstPreviewKey && (
          <button
            type="button"
            data-preview-key={firstPreviewKey}
            data-preview-title={firstTrackTitle}
            data-preview-sub={release.title}
            data-preview-art={release.artwork}
            data-cart-slug={release.slug}
            data-cart-title={release.title}
            data-cart-type={release.type}
            data-cart-count={release.track_count}
            data-cart-cents={release.min_price_cents}
            data-cart-buyable={buyable ? '1' : '0'}
            data-track-num={firstPreview?.track_number || 1}
            aria-label="Play preview"
            class="preview-btn absolute bottom-4 right-4 w-14 h-14 flex items-center justify-center bg-primary/90 text-on-primary hover:bg-secondary hover:text-on-secondary backdrop-blur-sm transition-colors shadow-lg"
          >
            <span class="material-symbols-outlined text-3xl leading-none">play_arrow</span>
          </button>
        )}
      </div>

      <div>
        <span class="font-mono text-[10px] text-secondary uppercase tracking-widest">{release.type}</span>
        <h1 class="font-headline font-bold text-4xl md:text-5xl text-primary uppercase tracking-tight mt-2 mb-4 leading-none">
          {release.title}
        </h1>
        {release.description && (
          <p class="font-mono text-[11px] text-white/50 leading-relaxed mb-6">{release.description}</p>
        )}
        <div class="flex flex-wrap gap-2 mb-8">
          {release.genre.map(g => (
            <span class="px-2 py-1 bg-white/5 text-[9px] font-mono text-primary border border-primary/10 uppercase rounded-full">#{g}</span>
          ))}
        </div>

        <form id="release-form" class="space-y-6">
          <div>
            <label class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-3">
              Name your price · Minimum ${minPriceDollars}
            </label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 font-mono text-secondary">$</span>
              <input
                type="number"
                name="price"
                min={minPriceDollars}
                step="1"
                value={minPriceDollars}
                class="w-full pl-10 pr-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-2xl text-primary"
                required
              />
            </div>
            <p class="font-mono text-[9px] text-white/30 mt-2">
              {preorder
                ? `FLAC + MP3 · Unlocks in your library on ${release.release_date}`
                : 'FLAC + MP3 download · Delivered by email after purchase'}
            </p>
          </div>
          <button
            id="release-submit"
            type="submit"
            class="w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
            disabled={!release.has_masters || (!preorder && !!release.release_date && new Date(release.release_date) > new Date())}
          >
            {!release.has_masters ? 'Coming soon' : preorder ? 'Pre-order' : 'Add to Cart'}
          </button>
          {release.release_date && new Date(release.release_date) > new Date() && (
            <p id="release-countdown" class="font-mono text-[10px] text-secondary uppercase tracking-widest mt-2" data-release-date={release.release_date} data-preorder={preorder ? '1' : null}>
              {preorder ? `Unlocks ${release.release_date}` : `Releases ${release.release_date}`}
            </p>
          )}
          {!release.has_masters && (
            <p class="font-mono text-[10px] text-white/40">Master files not yet uploaded for this release.</p>
          )}
        </form>

        <!-- The free-song token, offered AT THE POINT OF PAYMENT. It is
             granted on email verification and, until now, could only be spent
             from a picker on the profile page — so a fan who had one met it
             nowhere near the moment they would actually want it. Hidden by
             default and revealed only when /api/free-token says there is an
             unspent one, so a signed-out or already-spent visitor sees nothing
             and the panel never flashes in and out. -->
        <div id="free-token-panel" class="hidden mt-4 p-4 border border-secondary/25 bg-secondary/[0.06] rounded-[var(--radius-lg)]">
          <div class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">You have a free track</div>
          <p class="font-mono text-[10px] text-white/40 leading-relaxed mb-3">
            One track, once, yours to keep. Pick one from this release instead of paying — or save it for another.
          </p>
          <label class="sr-only" for="free-token-track">Track</label>
          <div class="flex flex-wrap gap-2">
            <!-- Populated from /api/free-token?slug=, which returns the real
                 master keys. The catalogue's track list is NOT used here: the
                 master filenames do not map onto track numbers, so the value
                 posted back has to be the key itself. -->
            <select id="free-token-track" class="flex-1 min-w-[12rem] px-3 py-2 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-[11px] text-primary rounded-[var(--radius)]"></select>
            <button type="button" id="free-token-redeem" class="px-4 py-2 border border-secondary/40 bg-secondary/10 hover:bg-secondary hover:text-on-secondary text-secondary font-mono text-[10px] tracking-widest uppercase rounded-full transition-colors">
              Get it free
            </button>
          </div>
          <p id="free-token-msg" class="font-mono text-[10px] text-white/40 mt-3 min-h-[1rem]" role="status" aria-live="polite"></p>
        </div>

        {release.bandcamp_url && (
          <a href={release.bandcamp_url} target="_blank" rel="noopener" class="block mt-4 text-center py-3 border border-white/10 hover:border-secondary/40 font-mono text-[10px] text-white/60 hover:text-secondary uppercase tracking-widest transition-colors rounded-full">
            Or get on Bandcamp →
          </a>
        )}
      </div>
    </div>

    {release.tracks.length > 0 && (
      <section class="mt-16">
        <div class="flex items-baseline gap-4 mb-6">
          <span class="font-mono text-xs text-secondary uppercase">Tracks</span>
          <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
          <span class="font-mono text-[10px] text-white/30">{release.tracks.length}</span>
        </div>
        <ol class="divide-y divide-white/5">
          {release.tracks.map(t => {
            const pkey = previewByTrack[t.track_number];
            const playAttrs = pkey ? {
              'data-preview-key': pkey,
              'data-preview-title': t.title,
              'data-preview-sub': release.title,
              'data-preview-art': release.artwork,
              'data-cart-slug': release.slug,
              'data-cart-title': release.title,
              'data-cart-type': release.type,
              'data-cart-count': release.track_count,
              'data-cart-cents': release.min_price_cents,
              'data-cart-buyable': buyable ? '1' : '0',
              'data-track-num': t.track_number,
              'role': 'button',
              'tabindex': '0',
              'aria-label': `Play ${t.title}`,
            } : {};
            return (
              <li
                id={`track-${t.track_number}`}
                {...playAttrs}
                class:list={[
                  'track-row flex items-center gap-4 py-3 px-3 -mx-3 scroll-mt-28 transition-colors target:bg-secondary/10',
                  pkey && 'is-playable cursor-pointer hover:bg-white/[0.05]',
                ]}
              >
                <span class="track-ctrl shrink-0 w-8 h-8 flex items-center justify-center relative">
                  <span class="track-num font-mono text-[10px] text-white/30">{String(t.track_number).padStart(2, '0')}</span>
                  {pkey && (
                    <span class="track-icon material-symbols-outlined text-primary text-xl leading-none absolute inset-0 flex items-center justify-center">play_arrow</span>
                  )}
                </span>
                <span class:list={['flex-1 font-headline uppercase tracking-tight transition-colors', pkey ? 'text-primary' : 'text-white/40']}>{t.title}</span>
                <span class="shrink-0 font-mono text-[10px] text-white/40">{fmtDuration(t.duration_seconds)}</span>
              </li>
            );
          })}
        </ol>
        <style is:global>
          .track-row .track-icon { opacity: 0; transition: opacity 150ms ease; }
          .track-row .track-num { opacity: 1; transition: opacity 150ms ease; }
          .track-row.is-playable:hover .track-icon,
          .track-row.preview-playing .track-icon { opacity: 1; }
          .track-row.is-playable:hover .track-num,
          .track-row.preview-playing .track-num { opacity: 0; }
          .track-row.is-playable:hover .font-headline { color: var(--color-secondary); }
          .track-row.preview-playing .font-headline { color: var(--color-secondary); }
        </style>
      </section>
    )}
  </div>

  <script type="application/json" id="release-data" set:html={JSON.stringify({
    slug: release.slug,
    title: release.title,
    image: release.artwork,
    min_cents: release.min_price_cents,
    track_count: release.track_count,
    type: release.type,
    release_date: release.release_date,
    preorder,
  })} />

  <script>
    import '../../../scripts/cart.js';
    import '../../../scripts/preview-player.js';
    import { goLiveUtcMs, isReleased } from '../../../../functions/_lib/release-gate.mjs';

    // This is a dynamic route ([slug].astro): every release shares the same
    // compiled script, so a bundled-script-runs-once client router would
    // otherwise leave the SECOND release page you visit completely
    // unwired (no countdown, no working "add to cart" form) — the script
    // already ran once, for the first slug. astro:page-load fires again for
    // every navigation (including the first), so wrapping the whole setup in
    // it re-reads the fresh #release-data / #release-form each time instead
    // of relying on top-level execution. timer is tracked at module scope
    // (this outer scope only runs once, same reasoning as
    // ScrambleGrid.astro) so astro:before-swap can always clear whatever the
    // MOST RECENT navigation started, even though the countdown values
    // themselves are re-read fresh on every page-load.
    let timer: ReturnType<typeof setInterval> | null = null;

    document.addEventListener('astro:page-load', () => {
      if (timer) { clearInterval(timer); timer = null; }

      const release = JSON.parse(document.getElementById('release-data')!.textContent || '{}');
      const form = document.getElementById('release-form') as HTMLFormElement;

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalLabel = submitBtn.textContent;

      const cdEl = document.getElementById('release-countdown');
      const liveAt = goLiveUtcMs(release.release_date || '');
      if (cdEl && Number.isFinite(liveAt)) {
        const tick = () => {
          if (isReleased(release.release_date)) {
            // The page was built before the release date and is now being
            // viewed after it. Undo everything the build-time state decided:
            // the countdown, the disabled button, AND the label — a page that
            // silently keeps saying "Pre-order" after the release is out is
            // the failure mode this branch exists to prevent.
            cdEl.style.display = 'none';
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Add to Cart';
            }
            if (timer) { clearInterval(timer); timer = null; }
            return;
          }
          const s = Math.max(0, Math.floor((liveAt - Date.now()) / 1000));
          const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
          cdEl.textContent = release.preorder
            ? `Unlocks in ${d}d ${h}h ${m}m`
            : `Releases in ${d}d ${h}h ${m}m`;
        };
        timer = setInterval(tick, 1000);
        tick();
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const dollars = parseFloat(String(fd.get('price') || '0'));
        const cents = Math.round(dollars * 100);
        if (cents < release.min_cents) return;

        (window as any).morphicsCart.add({
          type: 'music',
          sku: `music:${release.slug}`,
          title: release.title,
          subtitle: release.preorder
            ? `${release.type.toUpperCase()} · ${release.track_count} track${release.track_count === 1 ? '' : 's'} · digital · pre-order, unlocks ${release.release_date}`
            : `${release.type.toUpperCase()} · ${release.track_count} track${release.track_count === 1 ? '' : 's'} · digital`,
          image: release.image,
          unit_amount: cents,
          qty: 1,
          metadata: { release_slug: release.slug },
        });

        // Confirm to the user without hijacking focus to the drawer.
        submitBtn.textContent = '✓ Added — view cart';
        submitBtn.classList.add('bg-secondary', 'text-on-secondary');
        setTimeout(() => {
          submitBtn.textContent = originalLabel;
          submitBtn.classList.remove('bg-secondary', 'text-on-secondary');
        }, 2000);
      });

    // ── free-song token ────────────────────────────────────────────────
    // Offered AT THE POINT OF PAYMENT. The token is granted on email
    // verification and could previously only be spent from a picker on the
    // profile page, so a fan who had one met it nowhere near the moment they
    // would want it.
    //
    // Revealed only on a definite yes. A 401 (signed out), a spent token, and
    // a release with no masters all leave it hidden — "signed in" is not the
    // same as "still holds an unspent token", which is why this asks the
    // server rather than reading a cached auth state.
    const ftPanel = document.getElementById('free-token-panel');
    if (ftPanel) {
      const ftSelect = document.getElementById('free-token-track') as HTMLSelectElement;
      const ftBtn = document.getElementById('free-token-redeem') as HTMLButtonElement;
      const ftMsg = document.getElementById('free-token-msg')!;

      fetch(`/api/free-token?slug=${encodeURIComponent(release.slug)}`, { credentials: 'include' })
        .then(r => (r.ok ? r.json() : null))
        .then(d => {
          if (!d?.available || !d.tracks?.length) return;
          // Options carry the KEY as their value. The master filenames do not
          // map onto catalogue track numbers — most are named by title, some
          // inconsistently — so anything that resolved a number to a file
          // would eventually spend the one free track on the wrong song.
          ftSelect.innerHTML = d.tracks
            .map((t: any) => `<option value="${String(t.key).replace(/"/g, '&quot;')}">${String(t.label).replace(/</g, '&lt;')}</option>`)
            .join('');
          ftPanel.classList.remove('hidden');
        })
        .catch(() => {});

      let armed = false;
      ftBtn?.addEventListener('click', async () => {
        // Two-step, deliberately. This is one track EVER, and an irreversible
        // choice behind a single click is how someone spends it by accident on
        // whatever release they happened to be looking at.
        if (!armed) {
          armed = true;
          ftBtn.textContent = 'Tap again to confirm';
          ftMsg.textContent = 'This uses your one free track, permanently.';
          setTimeout(() => {
            if (!armed) return;
            armed = false;
            ftBtn.textContent = 'Get it free';
            ftMsg.textContent = '';
          }, 6000);
          return;
        }
        armed = false;
        ftBtn.disabled = true;
        ftBtn.textContent = 'Claiming…';
        try {
          const res = await fetch('/api/free-token', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key: ftSelect.value }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            ftBtn.disabled = false;
            ftBtn.textContent = 'Get it free';
            ftMsg.textContent = data?.error === 'already spent'
              ? 'You have already used your free track.'
              : data?.error === 'no token'
                ? 'Verify your email first — the free track arrives with it.'
                : 'Could not claim that one. Try again.';
            return;
          }
          ftBtn.textContent = '✓ Yours';
          ftMsg.innerHTML = 'Saved to <a href="/library" class="text-secondary underline">your library</a>, permanently.';
        } catch {
          ftBtn.disabled = false;
          ftBtn.textContent = 'Get it free';
          ftMsg.textContent = 'Network error — try again.';
        }
      });
    }
    });

    // Stop the countdown tick before this page's markup is swapped away.
    document.addEventListener('astro:before-swap', () => {
      if (timer) { clearInterval(timer); timer = null; }
    });
  </script>
</BaseLayout>
