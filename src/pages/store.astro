---
import PageTitle from '../components/PageTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import merchItems from '../data/merch.json';
import pluginItems from '../data/plugins.json';
import digitalItems from '../data/digital.json';
import { isDigitalPreorderable } from '../../functions/_lib/preorder.mjs';

// The card used to hardcode TYPEFACE / text_fields, which was true while a
// typeface was the only digital product. `kind` drives it now.
const KIND_LABEL: Record<string, { label: string; icon: string }> = {
  font: { label: 'TYPEFACE', icon: 'text_fields' },
  plugin: { label: 'PLUGIN', icon: 'memory' },
  pack: { label: 'PACK', icon: 'folder_zip' },
};
const kindOf = (k?: string) => KIND_LABEL[k || ''] || { label: 'DOWNLOAD', icon: 'download' };

// Build-time. A card that goes stale after the release date self-corrects on
// the product page, which re-checks at runtime.
const sellableDigital = digitalItems
  .map(item => ({ item, preorder: isDigitalPreorderable(item.slug, (item as any).release_date) }))
  .filter(({ item, preorder }) => item.available || preorder);

// plugins.json is the teaser list for things with no price yet. A plugin that
// becomes purchasable moves into digital.json, so the count has to span both
// or it reads 0 the moment the first one ships.
const pluginCount =
  pluginItems.length + digitalItems.filter(d => (d as any).kind === 'plugin').length;

const formatPrice = (lo: number | null, hi: number | null) => {
  if (lo == null) return '';
  if (hi == null || hi === lo) return `$${lo.toFixed(0)}`;
  return `$${lo.toFixed(0)}–$${hi.toFixed(0)}`;
};
---

<BaseLayout title="STORE" currentPage="/store">
  <PageTitle title="STORE" />

  <!-- Catalog grid: plugins and merch share the same row so a card sits
       beside its neighbour rather than stacked in two separate sections. -->
  <section class="max-w-[1400px] mx-auto mb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sellableDigital.map(({ item, preorder }) => (
        <a
          href={`/store/digital/${item.slug}`}
          class="group relative bg-surface-container-low border border-white/5 rounded-lg overflow-hidden transition-all duration-500 hover:border-secondary/30 terminal-glow block"
        >
          <div class="relative overflow-hidden">
            <img
              src={item.thumbnail}
              alt={item.name}
              class="w-full aspect-square object-cover group-hover:scale-[1.03] transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent opacity-70"></div>
            {preorder && (
              <div class="absolute top-4 right-4 font-mono text-[9px] tracking-[0.25em] uppercase px-2 py-1 bg-secondary/15 text-secondary border border-secondary/30 backdrop-blur-md rounded-full">
                Pre-order
              </div>
            )}
            <div class="absolute bottom-4 left-4 font-mono text-[10px] space-y-1">
              <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-secondary rounded-full">
                <span class="material-symbols-outlined text-sm">{kindOf((item as any).kind).icon}</span>
                {kindOf((item as any).kind).label}
              </div>
              <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-primary rounded-full">
                ${item.price_cents % 100 === 0 ? item.price_cents / 100 : (item.price_cents / 100).toFixed(2)}
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-headline text-xl text-primary uppercase tracking-tight mb-1">{item.name}</h3>
            <p class="font-mono text-[11px] text-white/50 uppercase tracking-widest mb-4">{item.tagline}</p>
            <div class="w-full py-3 border border-secondary/30 font-mono text-[10px] tracking-widest uppercase text-center text-secondary group-hover:bg-secondary/10 transition-colors rounded-full">
              {preorder ? `Pre-order · unlocks ${(item as any).release_date}` : 'Instant Download'}
            </div>
          </div>
        </a>
      ))}

      {pluginItems.map(item => (
        <div class="group relative bg-surface-container-low border border-white/5 rounded-lg overflow-hidden transition-all duration-500 hover:border-secondary/30 terminal-glow block cursor-default">
          <div class="relative overflow-hidden">
            <img
              src={item.thumbnail}
              alt={item.name}
              class="w-full aspect-square object-cover blur-md scale-110 grayscale opacity-60 group-hover:blur-[6px] group-hover:opacity-80 transition-all duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background via-background/30 to-transparent opacity-90"></div>
            <div class="absolute bottom-4 left-4 font-mono text-[10px] space-y-1">
              <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-secondary rounded-full">
                <span class="material-symbols-outlined text-sm">memory</span>
                PLUGIN
              </div>
              <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-primary rounded-full">
                {item.price_display}
              </div>
            </div>
            <div class="absolute top-4 right-4 font-mono text-[9px] tracking-[0.25em] uppercase px-2 py-1 bg-secondary/15 text-secondary border border-secondary/30 backdrop-blur-md rounded-full">
              Coming Soon
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-headline text-xl text-primary uppercase tracking-tight mb-1">{item.name}</h3>
            <p class="font-mono text-[11px] text-white/50 uppercase tracking-widest mb-4">{item.tagline}</p>
            <div class="w-full py-3 border border-white/10 font-mono text-[10px] tracking-widest uppercase text-center text-white/40 rounded-full">
              In Development
            </div>
          </div>
        </div>
      ))}

      {merchItems.map(item => {
        const available = Array.isArray((item as any).variants) && (item as any).variants.length > 0;
        const inner = (
          <div class="relative">
            <div class="relative overflow-hidden">
              <img
                src={item.thumbnail}
                alt={item.name}
                class:list={[
                  "w-full aspect-square object-cover transition-all duration-700",
                  available
                    ? "grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 group-hover:opacity-100"
                    : "grayscale opacity-30",
                ]}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60"></div>
              <div class="absolute bottom-4 left-4 font-mono text-[10px] space-y-1">
                <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-secondary rounded-full">
                  <span class="material-symbols-outlined text-sm">checkroom</span>
                  MERCH
                </div>
                <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-primary rounded-full">
                  {formatPrice(item.price_low, item.price_high)}
                </div>
              </div>
              {!available && (
                <div class="absolute top-4 right-4 font-mono text-[9px] tracking-[0.25em] uppercase px-2 py-1 bg-secondary/15 text-secondary border border-secondary/30 backdrop-blur-md rounded-full">
                  Restocking
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class:list={["font-headline text-xl uppercase tracking-tight mb-2 transition-colors", available ? "text-primary group-hover:text-secondary" : "text-primary"]}>{item.name}</h3>
              <div class="flex flex-wrap gap-2 mb-4">
                {item.sizes.slice(0, 6).map(s => (
                  <span class="px-2 py-1 bg-white/5 text-[9px] font-mono text-primary border border-primary/10 rounded-full">{s}</span>
                ))}
                {item.colors.slice(0, 4).map(c => (
                  <span class="px-2 py-1 bg-white/5 text-[9px] font-mono text-secondary border border-secondary/10 rounded-full">{c}</span>
                ))}
              </div>
              {available ? (
                <div class="w-full py-3 border border-primary/20 group-hover:border-primary/60 group-hover:bg-primary/5 font-mono text-[10px] tracking-widest transition-all uppercase text-center text-primary rounded-full">
                  View · Pick size
                </div>
              ) : (
                <div class="w-full py-3 border border-white/10 font-mono text-[10px] tracking-widest uppercase text-center text-white/40 rounded-full">
                  Restocking soon
                </div>
              )}
            </div>
          </div>
        );
        return available ? (
          <a href={`/store/merch/${item.slug}`} class="group relative bg-surface-container-low border border-white/5 rounded-lg overflow-hidden transition-all duration-500 hover:border-secondary/30 terminal-glow block">{inner}</a>
        ) : (
          <div class="group relative bg-surface-container-low border border-white/5 rounded-lg overflow-hidden block cursor-default">{inner}</div>
        );
      })}
    </div>
  </section>

  <div class="brand-divider brand-divider--wide mt-12 mb-0 max-w-[1400px] mx-auto">
    <img src="/images/brand/morph-line-j.png" alt="" loading="lazy" />
  </div>

  <footer class="max-w-[1400px] mx-auto mt-4 pt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="flex gap-12">
      <div>
        <div class="font-mono text-[9px] text-white/20 uppercase mb-1">Plugins</div>
        <div class="font-headline text-lg text-primary">{pluginCount}</div>
      </div>
      <div>
        <div class="font-mono text-[9px] text-white/20 uppercase mb-1">Merch</div>
        <div class="font-headline text-lg text-primary">{merchItems.length}</div>
      </div>
    </div>
    <div class="flex gap-4">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Store Online</span>
    </div>
  </footer>
</BaseLayout>
