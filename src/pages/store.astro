---
import BaseLayout from '../layouts/BaseLayout.astro';
import storeData from '../data/store.json';

const musicItems = storeData.filter(item => item.type === 'music');
const merchItems = storeData.filter(item => item.type === 'merch');

const platformIcons: Record<string, string> = {
  bandcamp: 'album',
  store: 'storefront',
};
---

<BaseLayout title="STORE" currentPage="/store">
  <header class="mb-20 max-w-[1400px] mx-auto">
    <div class="flex items-baseline gap-4 mb-2">
      <span class="font-mono text-xs text-secondary">[ ACQUISITION_TERMINAL ]</span>
      <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
    </div>
    <h1 class="text-6xl md:text-8xl font-headline font-bold text-primary tracking-tighter leading-none mb-6">
      STORE
    </h1>
    <p class="max-w-xl text-on-surface-variant font-body leading-relaxed">
      Acquire neural transmissions and physical artifacts. All music available as lossless digital downloads. Merch ships worldwide.
    </p>
  </header>

  <!-- Filter Buttons -->
  <div class="max-w-[1400px] mx-auto mb-12">
    <div class="flex flex-wrap gap-3 font-mono text-[10px] tracking-widest uppercase">
      <button class="filter-btn px-6 py-3 border border-primary text-primary bg-primary/5 hover:bg-primary/20 transition-all" data-filter="all">ALL</button>
      <button class="filter-btn px-6 py-3 border border-outline-variant text-white/40 hover:text-white/80 hover:border-white/40 transition-all" data-filter="music">MUSIC</button>
      <button class="filter-btn px-6 py-3 border border-outline-variant text-white/40 hover:text-white/80 hover:border-white/40 transition-all" data-filter="merch">MERCH</button>
    </div>
  </div>

  <!-- Music Section -->
  <section class="max-w-[1400px] mx-auto mb-24 store-section" data-type="music">
    <div class="flex items-baseline gap-4 mb-8">
      <span class="font-mono text-xs text-secondary">[ DIGITAL_TRANSMISSIONS ]</span>
      <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {musicItems.map(item => (
        <a href={item.url} class="group relative bg-surface-container-low border border-white/5 transition-all duration-500 hover:border-secondary/30 terminal-glow block">
          <div class="flex items-center justify-between px-4 py-2 bg-surface-container-high/50 border-b border-white/5">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-error/40"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-secondary/40"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-primary/40"></div>
            </div>
            <span class="font-mono text-[9px] text-white/20 uppercase tracking-widest">{item.category}</span>
          </div>
          <div class="relative overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="w-full aspect-square object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60"></div>
            <div class="absolute bottom-4 left-4 font-mono text-[10px] space-y-1">
              <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-secondary">
                <span class="material-symbols-outlined text-sm">{platformIcons[item.platform]}</span>
                {item.platform.toUpperCase()}
              </div>
              <div class="flex items-center gap-2 bg-background/80 px-2 py-1 backdrop-blur-md text-primary">
                {item.price}
              </div>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-headline text-xl text-primary group-hover:text-secondary transition-colors uppercase tracking-tight mb-2">{item.title}</h3>
            <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">{item.description}</p>
            <div class="flex flex-wrap gap-2 mb-6">
              {item.tags.map(t => (
                <span class="px-2 py-1 bg-white/5 text-[9px] font-mono text-primary border border-primary/10">#{t.toUpperCase()}</span>
              ))}
            </div>
            <button class="w-full py-3 border border-primary/20 hover:bg-primary hover:text-on-primary font-mono text-[10px] tracking-widest transition-all uppercase group-hover:border-primary/40">
              ACQUIRE_ON_{item.platform.toUpperCase()}
            </button>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Merch Section -->
  <section class="max-w-[1400px] mx-auto mb-24 store-section" data-type="merch">
    <div class="flex items-baseline gap-4 mb-8">
      <span class="font-mono text-xs text-secondary">[ PHYSICAL_ARTIFACTS ]</span>
      <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {merchItems.map(item => (
        <a href={item.url} class="group relative bg-surface-container-low border border-white/5 transition-all duration-500 hover:border-primary/30 terminal-glow block">
          <div class="relative overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="w-full aspect-[4/3] object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60"></div>
            <div class="absolute top-4 right-4">
              <div class="bg-background/80 px-3 py-1.5 backdrop-blur-md font-mono text-[11px] text-secondary font-bold">
                {item.price}
              </div>
            </div>
            {item.tags.includes('limited') && (
              <div class="absolute top-4 left-4">
                <div class="bg-secondary/20 px-3 py-1.5 backdrop-blur-md font-mono text-[9px] text-secondary uppercase tracking-widest">
                  LIMITED
                </div>
              </div>
            )}
          </div>
          <div class="p-6">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="font-headline text-lg text-primary group-hover:text-secondary transition-colors uppercase tracking-tight">{item.title}</h3>
              <span class="font-mono text-[9px] text-white/20 uppercase">{item.category}</span>
            </div>
            <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-6">{item.description}</p>
            <button class="w-full py-3 border border-primary/20 hover:bg-primary hover:text-on-primary font-mono text-[10px] tracking-widest transition-all uppercase group-hover:border-primary/40">
              ADD_TO_CART
            </button>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Footer Stats -->
  <footer class="max-w-[1400px] mx-auto mt-12 pt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="flex gap-12">
      <div>
        <div class="font-mono text-[9px] text-white/20 uppercase mb-1">Catalog Items</div>
        <div class="font-headline text-lg text-primary">{storeData.length}</div>
      </div>
      <div>
        <div class="font-mono text-[9px] text-white/20 uppercase mb-1">Digital Formats</div>
        <div class="font-headline text-lg text-primary">FLAC / WAV / MP3</div>
      </div>
      <div>
        <div class="font-mono text-[9px] text-white/20 uppercase mb-1">Shipping</div>
        <div class="font-headline text-lg text-secondary">WORLDWIDE</div>
      </div>
    </div>
    <div class="flex gap-4">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Store Online...</span>
    </div>
  </footer>
</BaseLayout>

<script>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('border-primary', 'text-primary', 'bg-primary/5');
        b.classList.add('border-outline-variant', 'text-white/40');
      });
      btn.classList.remove('border-outline-variant', 'text-white/40');
      btn.classList.add('border-primary', 'text-primary', 'bg-primary/5');

      document.querySelectorAll('.store-section').forEach(section => {
        const type = section.getAttribute('data-type');
        if (filter === 'all' || type === filter) {
          section.style.display = '';
        } else {
          section.style.display = 'none';
        }
      });
    });
  });
</script>
