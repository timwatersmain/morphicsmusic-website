---
import BaseLayout from '../layouts/BaseLayout.astro';

// Turnstile site key is public — fine to ship in HTML. The matching
// secret key lives in Cloudflare Pages env var TURNSTILE_SECRET_KEY and
// is verified server-side in functions/api/auth/login.ts. If unset, the
// widget falls back to a no-op so the site still works in local dev.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

// EXEMPTED FROM THE CLIENT ROUTER (see BaseLayout.astro's ClientRouter for
// the site-wide picture), along with /signup and /account. Reasons, together
// rather than worth separating per page:
//   - All three load a third-party script (Turnstile, on this page and
//     /signup) with a plain <script src> tag that isn't part of Astro's own
//     bundle. The client router's script-execution rules ("bundled module
//     scripts run once, everything else is whatever the diff happens to do")
//     are documented for Astro's own scripts, not for a third party's
//     widget-render lifecycle across a soft-swapped DOM — not worth staking
//     working payment/auth-adjacent UI on an unverified assumption there.
//   - The signed-in-vs-form panel toggle, the redirect-target logic and the
//     magic-link fallback all assume "this page's own fetch() to
//     /api/auth/me settles once, on this exact load" — reachable, but not
//     free, to make navigation-safe, and these pages are low-traffic
//     (visited deliberately, not part of casual browsing) so the payoff for
//     doing so is small next to the risk of a subtle miss in a security-
//     adjacent flow.
// Net effect: navigating to any of the three interrupts playback if a
// preview was running (a real page load tears down the persisted
// <audio>) — an accepted, minor, explainable exception; every internal link
// that reaches one of them carries data-astro-reload to force it.
---

<BaseLayout title="SIGN IN" currentPage="">
  <div class="max-w-md mx-auto pt-12">
    <!-- Shown only after /api/auth/me confirms a live session. The form
         below stays in the DOM and hidden by default — never assumed
         signed-out until the check resolves that way. -->
    <div id="signed-in-panel" class="hidden">
      <header class="mb-12">
        <span class="font-mono text-xs text-secondary uppercase tracking-widest">Account</span>
        <h1 class="font-headline font-bold text-5xl md:text-6xl text-primary uppercase tracking-tighter leading-none mt-2">YOU'RE SIGNED IN</h1>
        <p class="font-mono text-[11px] text-white/50 mt-4 leading-relaxed">
          Signed in as <span id="signed-in-email" class="text-white/80"></span>
        </p>
      </header>
      <a
        href="/library"
        data-astro-reload
        class="block text-center w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors"
      >
        Go to library
      </a>
      <a
        href="/account"
        data-astro-reload
        class="block text-center w-full mt-4 py-3 font-mono text-[10px] tracking-widest uppercase text-white/40 hover:text-white/70 transition-colors"
      >
        Manage sign-in details
      </a>
      <button
        type="button"
        id="signed-in-logout"
        class="w-full mt-4 py-3 font-mono text-[10px] tracking-widest uppercase text-white/40 hover:text-white/70 transition-colors"
      >
        Not you? Sign out
      </button>
    </div>

    <div id="login-form-panel">
    <header class="mb-12">
      <span class="font-mono text-xs text-secondary uppercase tracking-widest">Account</span>
      <h1 class="font-headline font-bold text-5xl md:text-6xl text-primary uppercase tracking-tighter leading-none mt-2">SIGN IN</h1>
      <p class="font-mono text-[11px] text-white/50 mt-4 leading-relaxed">
        Username or email, plus your password.
      </p>
    </header>

    <!-- Shown when arriving from a successful /signup via ?created=1. Text
         content is set via textContent in the script below, never
         innerHTML — the query string is attacker-controllable. -->
    <div id="created-banner" role="status" class="hidden mb-8 p-6 border border-secondary/30 bg-secondary/5 font-mono text-[11px] text-white/70 leading-relaxed"></div>

    <!-- Primary path: username/email + password. -->
    <form id="password-login-form" class="space-y-4">
      <div>
        <label for="li-identifier" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Username or email</label>
        <input
          id="li-identifier"
          type="text"
          name="identifier"
          required
          autocomplete="username"
          placeholder="you or you@example.com"
          class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
        >
      </div>
      <div>
        <label for="li-password" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Password</label>
        <input
          id="li-password"
          type="password"
          name="password"
          required
          autocomplete="current-password"
          placeholder="••••••••••"
          class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
        >
      </div>
      <label class="flex items-center gap-2 font-mono text-[10px] text-white/40 uppercase tracking-widest cursor-pointer">
        <input type="checkbox" name="remember" class="accent-secondary w-4 h-4">
        Keep me signed in
      </label>
      {TURNSTILE_SITE_KEY && (
        <div
          class="cf-turnstile flex justify-center"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-theme="dark"
          data-size="flexible"
        ></div>
      )}
      <button
        type="submit"
        id="password-submit-btn"
        class="w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
      >
        Sign in
      </button>
    </form>

    <div id="password-error" role="alert" aria-live="assertive" class="hidden mt-6 p-6 border border-red-500/30 bg-red-500/5 font-mono text-[11px] text-red-300"></div>

    <p class="mt-6 font-mono text-[10px] text-white/30 leading-relaxed">
      <button type="button" id="show-magic-link" class="text-white/60 hover:text-white underline">Email me a sign-in link instead</button>
      · Forgot password? <button type="button" id="forgot-password" class="text-white/60 hover:text-white underline">Use a sign-in link</button>
    </p>

    <p class="mt-4 font-mono text-[10px] text-white/30 leading-relaxed">
      New here? <a href="/signup" data-astro-reload class="text-white/60 hover:text-white underline">Create an account</a>
    </p>

    <!-- Secondary path: the original magic-link flow, demoted but preserved
         in full — it's also the recovery path for a forgotten password. -->
    <div id="magic-link-panel" class="hidden mt-10 pt-10 border-t border-white/10">
      <h2 class="font-mono text-[10px] text-white/40 uppercase tracking-widest mb-4">Email me a link</h2>
      <p class="font-mono text-[11px] text-white/50 mb-4 leading-relaxed">
        We'll email a one-time link. No password — click the link to access your library.
      </p>
      <form id="login-form" class="space-y-4">
        <div>
          <label for="li-email" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Email</label>
          <input
            id="li-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
          >
        </div>
        {/* No "cf-turnstile" class here on purpose — that class is what
            Turnstile's implicit auto-render picks up on script load, and
            this container starts hidden (parent panel is display:none
            until revealMagicLink() runs). A managed challenge can't be
            completed inside a hidden element, so this widget is rendered
            explicitly, on demand, once the panel is actually visible. */}
        {TURNSTILE_SITE_KEY && (
          <div
            id="magic-turnstile"
            class="flex justify-center"
            data-sitekey={TURNSTILE_SITE_KEY}
            data-theme="dark"
            data-size="flexible"
          ></div>
        )}
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
        >
          Send sign-in link
        </button>
      </form>

      <div id="status" class="hidden mt-8 p-6 border border-secondary/30 bg-secondary/5">
        <div class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Check your email</div>
        <p class="font-mono text-[11px] text-white/70 leading-relaxed">
          If the address is on file, a sign-in link is on its way. Click the link in the email to access your library.
        </p>
      </div>

      <div id="error" role="alert" aria-live="assertive" class="hidden mt-8 p-6 border border-red-500/30 bg-red-500/5 font-mono text-[11px] text-red-300"></div>
    </div>

    {TURNSTILE_SITE_KEY && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <div id="expired-banner" class="hidden mt-8 p-4 border border-secondary/20 bg-secondary/5 font-mono text-[10px] text-white/60 uppercase tracking-widest">
      That link expired — request a fresh one.
    </div>
    </div>
  </div>

  <script>
    import { decideAuthStateFromFetch } from '../scripts/auth-state.js';
    import { parseCreatedState } from '../scripts/auth-flow.js';

    const formPanel = document.getElementById('login-form-panel')!;
    const signedInPanel = document.getElementById('signed-in-panel')!;
    const signedInEmail = document.getElementById('signed-in-email')!;
    const logoutBtn = document.getElementById('signed-in-logout') as HTMLButtonElement;

    // Failing toward the form is the recoverable direction: if the check
    // errors out, the worst case is a signed-in user sees the form (and
    // can no-op through it), not a signed-out user stuck on a dead panel.
    decideAuthStateFromFetch(fetch('/api/auth/me', { credentials: 'include' })).then(({ state, email }) => {
      if (state === 'signed-in' && email) {
        signedInEmail.textContent = email;
        formPanel.classList.add('hidden');
        signedInPanel.classList.remove('hidden');
      }
      // 'signed-out' and 'unknown' both leave the form showing, which is
      // already the default markup state.
    });

    logoutBtn.addEventListener('click', async () => {
      logoutBtn.disabled = true;
      try {
        await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      } catch {
        // Best-effort — even if the request fails, reload so the user sees
        // current reality rather than a stale "signed in" panel.
      }
      location.reload();
    });

    const params = new URLSearchParams(location.search);
    if (params.get('expired') === '1') {
      document.getElementById('expired-banner')!.classList.remove('hidden');
    }

    // Arrived from a successful /signup. `username` is attacker-controllable
    // URL input — always textContent, never innerHTML.
    const { created, username: createdUsername } = parseCreatedState(location.search);
    if (created) {
      const banner = document.getElementById('created-banner')!;
      banner.textContent = 'Account created. Sign in to continue.';
      banner.classList.remove('hidden');
      const identifierInput = document.getElementById('li-identifier') as HTMLInputElement;
      if (createdUsername) identifierInput.value = createdUsername;
      document.getElementById('li-password')?.focus();
    }

    // Magic-link panel is demoted to a secondary option, opened either by
    // its own toggle or by "Forgot password?" — same panel either way,
    // since a mailed link is also the account-recovery path.
    const magicLinkPanel = document.getElementById('magic-link-panel')!;
    const showMagicLinkBtn = document.getElementById('show-magic-link') as HTMLButtonElement;
    const forgotPasswordBtn = document.getElementById('forgot-password') as HTMLButtonElement;

    // The magic-link Turnstile widget is deliberately NOT auto-rendered by
    // the implicit "cf-turnstile" class (see the markup comment) — it lives
    // inside a panel that starts hidden, and a managed challenge can't be
    // completed inside display:none. Render it explicitly, once, the first
    // time the panel actually becomes visible. window.turnstile may not be
    // loaded yet (the script tag is async), so retry briefly rather than
    // assuming it's ready.
    let magicWidgetRendered = false;
    function renderMagicWidgetWhenReady(attempts = 0) {
      const turnstile = (window as any).turnstile;
      const container = document.getElementById('magic-turnstile');
      if (!container || magicWidgetRendered) return;
      if (turnstile) {
        turnstile.render(container, {
          sitekey: container.dataset.sitekey,
          theme: 'dark',
          size: 'flexible',
        });
        magicWidgetRendered = true;
        return;
      }
      if (attempts < 40) setTimeout(() => renderMagicWidgetWhenReady(attempts + 1), 250);
    }

    function revealMagicLink() {
      magicLinkPanel.classList.remove('hidden');
      renderMagicWidgetWhenReady();
      document.getElementById('li-email')?.focus();
    }
    showMagicLinkBtn.addEventListener('click', revealMagicLink);
    forgotPasswordBtn.addEventListener('click', revealMagicLink);

    // Primary path: username/email + password.
    const pwForm = document.getElementById('password-login-form') as HTMLFormElement;
    const pwBtn = document.getElementById('password-submit-btn') as HTMLButtonElement;
    const pwErr = document.getElementById('password-error')!;

    pwForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      pwErr.classList.add('hidden');
      pwBtn.disabled = true;
      pwBtn.textContent = 'Signing in…';
      const fd = new FormData(pwForm);
      const identifier = String(fd.get('identifier') || '').trim();
      const password = String(fd.get('password') || '');
      const remember = fd.get('remember') === 'on';
      const turnstileToken = String(fd.get('cf-turnstile-response') || '');
      try {
        const r = await fetch('/api/auth/password-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, password, remember, turnstile: turnstileToken }),
        });
        if (!r.ok) {
          // The server deliberately returns the same generic failure for
          // "no such account" and "wrong password" — never guess which one
          // it was, that would undo the server-side work.
          throw new Error('Those details didn’t match. Try again.');
        }
        location.href = params.get('redirect') || '/library';
      } catch (e: any) {
        pwErr.textContent = e.message;
        pwErr.classList.remove('hidden');
        pwBtn.disabled = false;
        pwBtn.textContent = 'Sign in';
      }
    });

    const form = document.getElementById('login-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const status = document.getElementById('status')!;
    const err = document.getElementById('error')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      // Turnstile drops a hidden cf-turnstile-response input into the form
      // when the widget is present; if not (no site key) we just send an
      // empty token and the server treats it as "challenge disabled".
      const turnstileToken = String(fd.get('cf-turnstile-response') || '');
      try {
        const r = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            redirect: params.get('redirect') || '/library',
            turnstile: turnstileToken,
          }),
        });
        if (!r.ok) {
          const data = await r.json().catch(() => ({}));
          throw new Error(data.error || 'Could not send link');
        }
        form.classList.add('hidden');
        status.classList.remove('hidden');
      } catch (e: any) {
        err.textContent = e.message;
        err.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send sign-in link';
      }
    });
  </script>
</BaseLayout>
