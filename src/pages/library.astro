---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="LIBRARY" currentPage="">
  <div class="max-w-4xl mx-auto">
    <header class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="font-mono text-xs text-secondary uppercase tracking-widest">Your account</span>
        <h1 class="font-headline font-bold text-5xl md:text-7xl text-primary uppercase tracking-tighter leading-none mt-2">LIBRARY</h1>
        <p id="lib-email" class="font-mono text-[11px] text-white/50 mt-4"></p>
      </div>
      <button id="logout-btn" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">
        Sign out
      </button>
    </header>

    <!-- Shared profile strip — same row, same order, on every
         account-facing page. See community/me.astro for why. -->
    <nav aria-label="Profile sections" class="flex flex-wrap gap-2 mb-12">
      <a href="/community/me" data-astro-reload class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">Profile</a>
      <span aria-current="page" class="font-mono text-[10px] uppercase tracking-widest border border-primary bg-primary/10 text-primary px-4 py-2 rounded-full">Orders &amp; receipts</span>
      <a href="/account" data-astro-reload class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">Sign-in details</a>
      <a href="/community" data-astro-reload class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">Community</a>
    </nav>

    <div id="lib-loading" class="font-mono text-[11px] text-white/40">Loading your library…</div>
    <div id="lib-empty" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed">
        No purchases yet. Browse the <a href="/store" class="text-secondary underline">store</a> — your library populates the moment you buy something.
      </p>
    </div>
    <div id="lib-content" class="hidden space-y-12"></div>
  </div>

  <script>
    import { libraryHtml, hasAnything } from '../scripts/library-view';

    const loading = document.getElementById('lib-loading')!;
    const empty = document.getElementById('lib-empty')!;
    const content = document.getElementById('lib-content')!;
    const emailEl = document.getElementById('lib-email')!;
    const logoutBtn = document.getElementById('logout-btn')!;

    fetch('/api/library', { credentials: 'include' })
      .then(async r => {
        if (r.status === 401) {
          location.href = '/login?redirect=' + encodeURIComponent('/library');
          return null;
        }
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      })
      .then((data: any) => {
        if (!data) return;
        loading.classList.add('hidden');
        emailEl.textContent = String(data.email || '');

        if (!hasAnything(data)) {
          empty.classList.remove('hidden');
          return;
        }
        content.classList.remove('hidden');
        // Music, then digital products, then the receipts. Shared with
        // /community/me so the two can never describe ownership differently.
        content.innerHTML = libraryHtml(data, { withOrderHistory: true });
      })
      .catch(e => {
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        empty.querySelector('p')!.textContent = 'Could not load library: ' + e.message;
      });

    logoutBtn.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      location.href = '/login';
    });
  </script>
</BaseLayout>
