---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiscordInvite from '../components/DiscordInvite.astro';

// EXEMPTED FROM THE CLIENT ROUTER, along with /login and /signup — see the
// note on login.astro for the full reasoning.
---

<BaseLayout title="ACCOUNT" currentPage="">
  <div class="max-w-md">
    <!-- Shown only after /api/auth/me confirms a live session (same pattern
         as login.astro's signed-in panel and community/*.astro's signin
         panel). Never assume signed-in until that check resolves. -->
    <div id="acct-loading" class="font-mono text-[11px] text-white/40">Loading…</div>

    <div id="acct-signin" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
        Sign in to manage your sign-in details.
      </p>
      <a id="acct-signin-link" href="/login?redirect=/account" data-astro-reload class="inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
        Sign in
      </a>
    </div>

    <div id="acct-content" class="hidden">
      <header class="mb-16">
        <h1 class="font-headline font-bold text-6xl md:text-8xl text-primary uppercase tracking-tighter leading-none break-words">SIGN-IN DETAILS</h1>
        <p class="font-mono text-[11px] text-white/50 mt-4 leading-relaxed">
          Signed in as <span id="acct-email" class="text-white/80"></span>
        </p>
      </header>

      <!-- Shared profile strip — same row, same order, on every
           account-facing page. See community/me.astro for why. -->
      <nav aria-label="Profile sections" class="flex flex-wrap gap-2 mb-12">
        <a href="/community/me" data-astro-reload class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">Profile</a>
        <a href="/library" data-astro-reload class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">Orders &amp; receipts</a>
        <span aria-current="page" class="font-mono text-[10px] uppercase tracking-widest border border-primary bg-primary/10 text-primary px-4 py-2 rounded-full">Sign-in details</span>
        <a href="/community" data-astro-reload class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">Community</a>
      </nav>

      <!-- Verification is informational only right now — it never gates
           sign-in, downloads, or anything else. See functions/api/auth/verify-email.ts. -->
      <div id="acct-verify-panel" class="hidden mb-10 p-6 border border-white/10">
        <p class="font-mono text-[11px] text-white/50">
          Email verification: <span id="acct-verify-status" class="text-white/80"></span>
        </p>
        <button
          type="button"
          id="acct-verify-resend-btn"
          class="hidden mt-4 px-6 py-3 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
        >
          Resend verification email
        </button>
        <p id="acct-verify-msg" role="status" class="hidden mt-4 font-mono text-[11px] text-white/50 leading-relaxed"></p>
      </div>

      <!-- No password set yet: first-time setup. -->
      <div id="acct-setup-panel" class="hidden">
        <p class="font-mono text-[11px] text-white/50 mb-6 leading-relaxed">
          Your account has no username or password yet — you can only sign in
          with a mailed link right now. Set one up so you can sign in directly
          any time.
        </p>
        <form id="acct-setup-form" class="space-y-4" novalidate>
          <div>
            <label for="su-username" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Username</label>
            <input
              id="su-username"
              type="text"
              name="username"
              required
              autocomplete="username"
              placeholder="lowercase, 3-24 characters"
              aria-describedby="su-username-hint"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
            <p id="su-username-hint" class="font-mono text-[10px] text-white/30 mt-2">a-z, 0-9, underscore, hyphen only</p>
          </div>
          <div>
            <label for="su-password" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Password</label>
            <input
              id="su-password"
              type="password"
              name="password"
              required
              autocomplete="new-password"
              minlength="10"
              maxlength="256"
              placeholder="at least 10 characters"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
          </div>
          <div>
            <label for="su-confirm" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Confirm password</label>
            <input
              id="su-confirm"
              type="password"
              name="confirm"
              required
              autocomplete="new-password"
              minlength="10"
              maxlength="256"
              placeholder="type it again"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
          </div>
          <button
            type="submit"
            id="su-submit-btn"
            class="w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
          >
            Set up sign-in
          </button>
        </form>
        <div id="su-error" role="alert" aria-live="assertive" class="hidden mt-6 p-6 border border-red-500/30 bg-red-500/5 font-mono text-[11px] text-red-300"></div>
        <div id="su-success" role="status" class="hidden mt-6 p-6 border border-secondary/30 bg-secondary/5 font-mono text-[11px] text-white/70 leading-relaxed"></div>
      </div>

      <!-- Password already set: change/update form, requires current password. -->
      <div id="acct-update-panel" class="hidden">
        <p class="font-mono text-[11px] text-white/50 mb-6 leading-relaxed">
          Signed in as <span id="acct-current-username" class="text-white/80"></span>. Update your
          username or password below.
        </p>
        <form id="acct-update-form" class="space-y-4" novalidate>
          <div>
            <label for="up-current-password" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Current password</label>
            <input
              id="up-current-password"
              type="password"
              name="current_password"
              required
              autocomplete="current-password"
              placeholder="••••••••••"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
          </div>
          <div>
            <label for="up-username" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Username</label>
            <input
              id="up-username"
              type="text"
              name="username"
              required
              autocomplete="username"
              placeholder="lowercase, 3-24 characters"
              aria-describedby="up-username-hint"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
            <p id="up-username-hint" class="font-mono text-[10px] text-white/30 mt-2">a-z, 0-9, underscore, hyphen only</p>
          </div>
          <div>
            <label for="up-password" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">New password</label>
            <input
              id="up-password"
              type="password"
              name="password"
              required
              autocomplete="new-password"
              minlength="10"
              maxlength="256"
              placeholder="at least 10 characters"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
          </div>
          <div>
            <label for="up-confirm" class="block font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2">Confirm new password</label>
            <input
              id="up-confirm"
              type="password"
              name="confirm"
              required
              autocomplete="new-password"
              minlength="10"
              maxlength="256"
              placeholder="type it again"
              class="w-full px-4 py-4 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-base text-primary"
            >
          </div>
          <button
            type="submit"
            id="up-submit-btn"
            class="w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
          >
            Update sign-in details
          </button>
        </form>
        <div id="up-error" role="alert" aria-live="assertive" class="hidden mt-6 p-6 border border-red-500/30 bg-red-500/5 font-mono text-[11px] text-red-300"></div>
        <div id="up-success" role="status" class="hidden mt-6 p-6 border border-secondary/30 bg-secondary/5 font-mono text-[11px] text-white/70 leading-relaxed"></div>
      </div>

      <!-- Discord link. The code is issued by the bot (/link in Discord) and
           redeemed here — see functions/api/community/link-discord.ts for why
           the handshake runs in this direction. -->
      <div id="acct-discord-panel" class="hidden mt-10 p-6 border border-white/10">
        <p class="font-mono text-[11px] text-white/50 mb-6 leading-relaxed">
          <span id="acct-discord-blurb"></span>
        </p>

        <!-- Shown only to an unlinked fan. Without this the panel names the
             Discord and gives no way to reach it — see DiscordInvite.astro. -->
        <div id="acct-discord-join" class="hidden mb-6">
          <DiscordInvite />
        </div>

        <form id="acct-discord-form" class="hidden space-y-4" novalidate>
          <div>
            <label for="acct-discord-code" class="block font-mono text-[11px] tracking-widest uppercase text-white/40 mb-2">
              Link code
            </label>
            <input
              type="text"
              id="acct-discord-code"
              name="code"
              autocomplete="off"
              spellcheck="false"
              maxlength="16"
              placeholder="ABCD2345"
              class="w-full px-4 py-3 bg-transparent border border-white/20 font-mono text-[13px] tracking-[0.2em] uppercase text-white/90 focus:border-secondary focus:outline-none"
            />
          </div>
          <button
            type="submit"
            id="acct-discord-btn"
            class="px-6 py-3 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30"
          >
            Link Discord
          </button>
        </form>

        <button
          type="button"
          id="acct-discord-unlink-btn"
          class="hidden px-6 py-3 border border-white/20 font-mono text-[11px] tracking-widest uppercase text-white/60 hover:border-red-500/40 hover:text-red-300 transition-colors disabled:opacity-30"
        >
          Unlink
        </button>

        <p id="acct-discord-msg" role="status" class="hidden mt-4 font-mono text-[11px] leading-relaxed"></p>
      </div>
    </div>
  </div>

  <script>
    import { decideAuthStateFromFetch } from '../scripts/auth-state.js';
    import { clientValidate, describeSetPasswordError } from '../scripts/account-setup.js';

    // Every dynamic value below is rendered via textContent, never
    // innerHTML, so no esc() helper is needed on this page — kept as a
    // house-style note for future edits: reach for textContent first.

    const loading = document.getElementById('acct-loading')!;
    const signin = document.getElementById('acct-signin')!;
    const signinLink = document.getElementById('acct-signin-link') as HTMLAnchorElement;
    const content = document.getElementById('acct-content')!;
    const emailEl = document.getElementById('acct-email')!;
    const setupPanel = document.getElementById('acct-setup-panel')!;
    const updatePanel = document.getElementById('acct-update-panel')!;
    const currentUsernameEl = document.getElementById('acct-current-username')!;
    const verifyPanel = document.getElementById('acct-verify-panel')!;
    const verifyStatus = document.getElementById('acct-verify-status')!;
    const verifyBtn = document.getElementById('acct-verify-resend-btn') as HTMLButtonElement;
    const verifyMsg = document.getElementById('acct-verify-msg')!;

    const redirectTarget = '/account';
    signinLink.href = '/login?redirect=' + encodeURIComponent(redirectTarget);

    // Query params set by GET /api/auth/verify-email's redirect (see that
    // file) — read once on load, not re-checked after the resend button is
    // used, matching how a one-time redirect flag should behave.
    const acctParams = new URLSearchParams(window.location.search);
    const justVerified = acctParams.get('verified') === '1';
    const verifyLinkExpired = acctParams.get('verify_expired') === '1';

    // Which panel to show is a matter of "does a password already exist",
    // not something /api/auth/me tells us — that endpoint only confirms the
    // session. /api/auth/status reads the same customer record set-password
    // writes and reports that one field directly. (Community's profile
    // handle is NOT usable for this — every fan gets one, password or not.)
    // If the call fails for any reason, fail toward the safer "first-time
    // setup" copy — worst case a customer with a password already set sees
    // the setup form's extra "current password" step missing on THIS
    // attempt, and the server rejects it (401) rather than silently
    // succeeding, so there is no security gap, just an extra round trip.
    async function loadAccountState(): Promise<{ hasPassword: boolean; username: string | null; emailVerified: boolean }> {
      try {
        const r = await fetch('/api/auth/status', { credentials: 'include' });
        if (!r.ok) return { hasPassword: false, username: null, emailVerified: false };
        const data = await r.json();
        return { hasPassword: !!data.has_password, username: data.username || null, emailVerified: !!data.email_verified };
      } catch {
        return { hasPassword: false, username: null, emailVerified: false };
      }
    }

    decideAuthStateFromFetch(fetch('/api/auth/me', { credentials: 'include' })).then(async ({ state, email }) => {
      loading.classList.add('hidden');
      if (state !== 'signed-in' || !email) {
        // 'signed-out' and 'unknown' both fail toward the sign-in prompt —
        // never show the form to a visitor we can't confirm is signed in.
        signin.classList.remove('hidden');
        return;
      }

      emailEl.textContent = email;
      content.classList.remove('hidden');

      const { hasPassword, username, emailVerified } = await loadAccountState();
      if (hasPassword) {
        currentUsernameEl.textContent = username ? '@' + username : email;
        updatePanel.classList.remove('hidden');
        (document.getElementById('up-username') as HTMLInputElement).value = username || '';
      } else {
        setupPanel.classList.remove('hidden');
      }

      // Fire-and-forget: the Discord panel reveals itself when /me answers,
      // and must never hold up the password/verification panels above it.
      loadDiscordState();

      verifyPanel.classList.remove('hidden');
      if (emailVerified) {
        verifyStatus.textContent = 'Verified';
        verifyBtn.classList.add('hidden');
        if (justVerified) {
          verifyMsg.textContent = 'Your email is now verified.';
          verifyMsg.classList.remove('hidden');
        }
      } else {
        verifyStatus.textContent = 'Not verified';
        verifyBtn.classList.remove('hidden');
        if (verifyLinkExpired) {
          verifyMsg.textContent = 'That verification link expired or was already used — send a fresh one below.';
          verifyMsg.classList.remove('hidden');
        }
      }
    });

    verifyBtn.addEventListener('click', async () => {
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Sending…';
      verifyMsg.classList.add('hidden');
      try {
        const r = await fetch('/api/auth/resend-verification', { method: 'POST', credentials: 'include' });
        const data = await r.json().catch(() => ({}));
        if (r.ok) {
          verifyMsg.textContent = data.already_verified
            ? 'Already verified.'
            : 'Verification email sent — check your inbox.';
        } else if (r.status === 429) {
          verifyMsg.textContent = 'Please wait a bit before requesting another link.';
        } else {
          verifyMsg.textContent = 'Something went wrong — try again shortly.';
        }
      } catch {
        verifyMsg.textContent = 'Something went wrong — try again shortly.';
      } finally {
        verifyMsg.classList.remove('hidden');
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Resend verification email';
      }
    });

    function wireForm(opts: {
      form: HTMLFormElement;
      btn: HTMLButtonElement;
      btnLabel: string;
      errBox: HTMLElement;
      successBox: HTMLElement;
      includeCurrentPassword: boolean;
      successMessage: (username: string) => string;
    }) {
      const { form, btn, btnLabel, errBox, successBox, includeCurrentPassword, successMessage } = opts;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errBox.classList.add('hidden');
        successBox.classList.add('hidden');

        const fd = new FormData(form);
        const username = String(fd.get('username') || '').trim().toLowerCase();
        const password = String(fd.get('password') || '');
        const confirm = String(fd.get('confirm') || '');
        const currentPassword = includeCurrentPassword ? String(fd.get('current_password') || '') : '';

        const validationError = clientValidate({ username, password, confirm });
        if (validationError) {
          errBox.textContent = validationError;
          errBox.classList.remove('hidden');
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Saving…';

        try {
          const body: Record<string, string> = { username, password, confirm };
          if (includeCurrentPassword) body.current_password = currentPassword;

          const r = await fetch('/api/auth/set-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(body),
          });
          const data = await r.json().catch(() => ({}));
          if (!r.ok) {
            throw new Error(describeSetPasswordError(r.status, data));
          }

          successBox.textContent = successMessage(username);
          successBox.classList.remove('hidden');
          currentUsernameEl.textContent = '@' + username;
          (document.getElementById('up-username') as HTMLInputElement)!.value = username;
          form.reset();
          setupPanel.classList.add('hidden');
          updatePanel.classList.remove('hidden');
          (document.getElementById('up-username') as HTMLInputElement)!.value = username;
        } catch (e: any) {
          errBox.textContent = e.message;
          errBox.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = btnLabel;
        }
      });
    }

    wireForm({
      form: document.getElementById('acct-setup-form') as HTMLFormElement,
      btn: document.getElementById('su-submit-btn') as HTMLButtonElement,
      btnLabel: 'Set up sign-in',
      errBox: document.getElementById('su-error')!,
      successBox: document.getElementById('su-success')!,
      includeCurrentPassword: false,
      successMessage: (username) => `You're all set — you can now sign in with the username "${username}" or your email, plus this password.`,
    });

    wireForm({
      form: document.getElementById('acct-update-form') as HTMLFormElement,
      btn: document.getElementById('up-submit-btn') as HTMLButtonElement,
      btnLabel: 'Update sign-in details',
      errBox: document.getElementById('up-error')!,
      successBox: document.getElementById('up-success')!,
      includeCurrentPassword: true,
      successMessage: (username) => `Saved — sign in with "${username}" or your email, plus your new password. You've been signed out everywhere else.`,
    });

    /* --- Discord link ------------------------------------------------ */

    const discordPanel = document.getElementById('acct-discord-panel')!;
    const discordBlurb = document.getElementById('acct-discord-blurb')!;
    const discordForm = document.getElementById('acct-discord-form') as HTMLFormElement;
    const discordJoin = document.getElementById('acct-discord-join')!;
    const discordCode = document.getElementById('acct-discord-code') as HTMLInputElement;
    const discordBtn = document.getElementById('acct-discord-btn') as HTMLButtonElement;
    const discordUnlink = document.getElementById('acct-discord-unlink-btn') as HTMLButtonElement;
    const discordMsg = document.getElementById('acct-discord-msg')!;

    function discordSay(text: string, ok: boolean) {
      discordMsg.textContent = text;
      discordMsg.className = ok
        ? 'mt-4 font-mono text-[11px] leading-relaxed text-white/60'
        : 'mt-4 font-mono text-[11px] leading-relaxed text-red-300';
    }

    // Which half of the panel to show. Driven by GET /api/community/me's
    // discord_linked flag rather than a separate request — /me is already
    // fetched by every community page and adding a second endpoint just to
    // ask "am I linked?" would cost a subrequest on the free plan for a
    // fact /me already knows.
    function renderDiscord(linked: boolean) {
      discordPanel.classList.remove('hidden');
      discordBlurb.textContent = linked
        ? 'Your Discord account is linked. What you do in the server feeds the same creature this profile shows.'
        : 'Run /link in the Morphics Discord to get a code, then paste it here. Once linked, what you do in the server feeds the same creature this profile shows.';
      discordForm.classList.toggle('hidden', linked);
      discordJoin.classList.toggle('hidden', linked);
      discordUnlink.classList.toggle('hidden', !linked);
    }

    async function loadDiscordState() {
      try {
        const r = await fetch('/api/community/me', { credentials: 'include' });
        if (!r.ok) return;              // no fan profile yet — leave hidden
        const data = await r.json();
        renderDiscord(!!data?.profile?.discord_linked);
      } catch { /* panel stays hidden; nothing here is load-bearing */ }
    }

    discordForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      discordMsg.classList.remove('hidden');
      discordBtn.disabled = true;
      discordBtn.textContent = 'Linking…';
      try {
        const r = await fetch('/api/community/link-discord', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: discordCode.value }),
        });
        const data = await r.json().catch(() => ({}));
        if (r.ok) {
          discordSay('Linked. Your rank in Discord now follows this profile.', true);
          discordCode.value = '';
          renderDiscord(true);
        } else if (data.error === 'already_linked') {
          discordSay('This profile already has a Discord account linked.', false);
        } else if (data.error === 'discord_account_already_linked') {
          discordSay('That Discord account is linked to a different profile.', false);
        } else if (r.status === 429) {
          discordSay('Too many attempts. Try again in a few minutes.', false);
        } else {
          // Covers unknown AND expired codes — the API deliberately does not
          // distinguish them, so neither does this.
          discordSay('That code is not valid, or it expired. Run /link again for a fresh one.', false);
        }
      } catch {
        discordSay('Could not reach the server. Try again in a moment.', false);
      } finally {
        discordBtn.disabled = false;
        discordBtn.textContent = 'Link Discord';
      }
    });

    discordUnlink.addEventListener('click', async () => {
      discordMsg.classList.remove('hidden');
      discordUnlink.disabled = true;
      try {
        const r = await fetch('/api/community/link-discord', {
          method: 'DELETE', credentials: 'include',
        });
        if (r.ok) {
          discordSay('Unlinked. EP earned in Discord no longer counts, but your creature keeps the stage it reached.', true);
          renderDiscord(false);
        } else {
          discordSay('Could not unlink just now. Try again in a moment.', false);
        }
      } catch {
        discordSay('Could not reach the server. Try again in a moment.', false);
      } finally {
        discordUnlink.disabled = false;
      }
    });
  </script>
</BaseLayout>
