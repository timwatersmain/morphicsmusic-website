---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="THANK YOU" currentPage="">
  <div class="max-w-2xl mx-auto text-center pt-12">
    <span class="font-mono text-xs text-secondary uppercase tracking-widest">Order received</span>
    <h1 class="font-headline font-bold text-5xl md:text-7xl text-primary uppercase tracking-tighter leading-none mt-4 mb-8">
      THANK YOU
    </h1>
    <div class="space-y-6 text-on-surface-variant font-body leading-relaxed max-w-lg mx-auto">
      <p>Your support keeps Morphics running. Every purchase goes directly to making more music and visuals.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8 text-left">
        <div class="border border-white/10 p-6">
          <div class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Digital</div>
          <p class="font-mono text-[11px] text-white/60 leading-relaxed">Your download is ready below. A copy of the link is emailed to you as well.</p>
        </div>
        <div class="border border-white/10 p-6">
          <div class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">Merch</div>
          <p class="font-mono text-[11px] text-white/60 leading-relaxed">Made-to-order via Printful. Tracking will arrive in your email.</p>
        </div>
      </div>
      <div id="dl-panel" class="hidden text-left border border-secondary/30 bg-secondary/5 p-6 mt-8">
        <div class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-4">
          Your downloads
        </div>
        <div id="dl-list" class="space-y-2"></div>
        <p class="font-mono text-[10px] text-white/40 mt-4 leading-relaxed">
          This link stays valid for 7 days. Signed-in customers can re-download
          any time from <a href="/library" class="text-secondary underline">your library</a>.
        </p>
      </div>

      <div id="dl-pending" class="hidden font-mono text-[11px] text-white/40 mt-8">
        Preparing your download…
      </div>

      <div class="pt-8 flex justify-center gap-4">
        <a href="/store" class="px-6 py-3 border border-primary/20 hover:border-primary/60 hover:bg-primary/5 font-mono text-[10px] tracking-widest uppercase text-primary rounded-full">
          Back to store
        </a>
        <a href="/" class="px-6 py-3 border border-white/10 hover:border-white/30 font-mono text-[10px] tracking-widest uppercase text-white/60 rounded-full">
          Home
        </a>
      </div>
    </div>
  </div>

  <script>
    // Hand the buyer their files straight away. The session id in the URL is
    // unguessable and the server checks with Stripe that it was actually paid,
    // so this cannot be used to fish for someone else's download.
    const sid = new URLSearchParams(location.search).get('session_id');
    const panel = document.getElementById('dl-panel')!;
    const list = document.getElementById('dl-list')!;
    const pending = document.getElementById('dl-pending')!;

    if (sid) {
      pending.classList.remove('hidden');
      fetch(`/api/order?session_id=${encodeURIComponent(sid)}`)
        .then(r => r.json())
        .then(d => {
          pending.classList.add('hidden');
          if (!d?.paid || !d?.items?.length) return;
          const rows: string[] = [];
          for (const item of d.items) {
            for (const f of (item.files || [])) {
              const href = `/api/download?token=${encodeURIComponent(d.token)}&key=${encodeURIComponent(f.key)}`;
              rows.push(
                `<a href="${href}" class="flex items-center justify-between gap-4 border border-white/10 hover:border-secondary/50 px-4 py-3 group rounded-full">
                   <span class="font-mono text-[11px] text-white/80 truncate">${item.title} — ${f.filename}</span>
                   <span class="font-mono text-[10px] tracking-widest uppercase text-secondary whitespace-nowrap">Download</span>
                 </a>`,
              );
            }
          }
          if (!rows.length) return;
          list.innerHTML = rows.join('');
          panel.classList.remove('hidden');
        })
        .catch(() => pending.classList.add('hidden'));
    }
  </script>
</BaseLayout>
