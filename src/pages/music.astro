---
import BaseLayout from '../layouts/BaseLayout.astro';
import Artwork from '../components/Artwork.astro';
import catalog from '../data/music-catalog.json';
import previews from '../data/previews.json';

// slug → first preview key + the title of the track that key actually plays
// (so the player bar names the track, e.g. "Synaptic Acid", not the release).
const firstPreviewBySlug: Record<string, string> = {};
const firstTrackTitleBySlug: Record<string, string> = {};
const firstTrackNumBySlug: Record<string, number> = {};
for (const r of catalog.releases) {
  const first = ((previews as any).previews?.[r.slug] || [])[0];
  if (!first?.key) continue;
  firstPreviewBySlug[r.slug] = first.key;
  const t = (r.tracks || []).find((tr: any) => tr.track_number === first.track_number);
  firstTrackTitleBySlug[r.slug] = t?.title || r.title;
  firstTrackNumBySlug[r.slug] = first.track_number || 1;
}

const isBuyable = (r: any) =>
  !!r.has_masters && (!r.release_date || new Date(r.release_date) <= new Date());

const releases = catalog.releases.map(r => ({
  ...r,
  artwork: r.artwork || null,
  date: r.release_date || '',
  genre: r.genre || [],
  minPriceDollars: ((r.min_price_cents || 0) / 100).toFixed(0),
}));

const latest = [...releases]
  .filter(r => r.date)
  .sort((a, b) => b.date.localeCompare(a.date))[0];

// Discography type filter (Singles / EPs / Albums). Only show a tab when at
// least one release of that type exists.
const typeCounts = releases.reduce((m: Record<string, number>, r) => {
  m[r.type] = (m[r.type] || 0) + 1;
  return m;
}, {});
const discogFilters = [
  { label: 'All', value: 'all', count: releases.length },
  { label: 'Singles', value: 'single', count: typeCounts.single || 0 },
  { label: 'EPs', value: 'ep', count: typeCounts.ep || 0 },
  { label: 'Albums', value: 'album', count: typeCounts.album || 0 },
].filter(f => f.value === 'all' || f.count > 0);
---

<BaseLayout title="MUSIC" currentPage="/music">
  <header class="mb-20">
    <h1 class="text-6xl md:text-8xl font-headline font-bold text-primary tracking-tighter leading-none">
      MUSIC
    </h1>
  </header>

  <!-- Latest Release -->
  {latest && (
    <div class="mb-20 max-w-4xl">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="font-mono text-xs text-secondary uppercase">Latest Release</span>
        <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
      </div>
      <div class="bg-surface-container-low border border-white/5 p-6 md:flex md:gap-6 md:items-center">
        <div class="relative group shrink-0 w-full md:w-48 mb-4 md:mb-0">
          <a href={`/store/music/${latest.slug}`} class="block aspect-square overflow-hidden">
            {latest.artwork ? (
              <Artwork
                src={latest.artwork}
                alt={latest.title}
                sizes="(max-width: 767px) 100vw, 192px"
                priority
                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-white/[0.03] border border-white/5">
                <span class="font-mono text-[9px] text-white/20 tracking-widest uppercase">No artwork</span>
              </div>
            )}
          </a>
          {firstPreviewBySlug[latest.slug] && (
            <button
              type="button"
              data-preview-key={firstPreviewBySlug[latest.slug]}
              data-preview-title={firstTrackTitleBySlug[latest.slug]}
              data-preview-sub={latest.title}
              data-preview-art={latest.artwork}
              data-cart-slug={latest.slug}
              data-cart-title={latest.title}
              data-cart-type={latest.type}
              data-cart-count={latest.track_count}
              data-cart-cents={latest.min_price_cents}
              data-cart-buyable={isBuyable(latest) ? '1' : '0'}
              data-track-num={firstTrackNumBySlug[latest.slug]}
              aria-label={`Play preview of ${firstTrackTitleBySlug[latest.slug]}`}
              class="preview-btn absolute bottom-2 right-2 w-11 h-11 flex items-center justify-center bg-primary/90 text-on-primary hover:bg-secondary hover:text-on-secondary backdrop-blur-sm transition-colors shadow-lg"
            >
              <span class="material-symbols-outlined text-2xl leading-none">play_arrow</span>
            </button>
          )}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline gap-3 mb-1">
            <a href={`/store/music/${latest.slug}`} class="font-headline text-2xl md:text-3xl text-primary hover:text-secondary transition-colors uppercase tracking-tight truncate">{latest.title}</a>
            <span class="font-mono text-[9px] text-secondary shrink-0">{latest.type.toUpperCase()}</span>
          </div>
          <div class="font-mono text-[10px] text-white/30 mb-3">{latest.date}</div>
          <div class="flex flex-wrap gap-1 mb-5">
            {latest.genre.map(g => (
              <span class="px-1.5 py-0.5 bg-white/5 text-[8px] font-mono text-primary border border-primary/10">#{g.toUpperCase()}</span>
            ))}
          </div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="release-add-btn flex-1 py-3 border border-primary/30 hover:bg-primary hover:text-on-primary font-mono text-[10px] tracking-widest transition-all uppercase text-center text-primary disabled:opacity-30 disabled:cursor-not-allowed"
              data-slug={latest.slug}
              data-title={latest.title}
              data-image={latest.artwork}
              data-min-cents={latest.min_price_cents}
              data-track-count={latest.track_count}
              data-type={latest.type}
              data-live-label={`Add ${latest.title} to cart · $${latest.minPriceDollars}+`}
              disabled={!latest.has_masters || (!!latest.release_date && new Date(latest.release_date) > new Date())}
            >
              {!latest.has_masters
                ? 'Coming soon'
                : (!!latest.release_date && new Date(latest.release_date) > new Date())
                  ? 'Coming soon'
                  : `Add ${latest.title} to cart · $${latest.minPriceDollars}+`}
            </button>
            {latest.release_date && new Date(latest.release_date) > new Date() && (
              <div class="release-countdown flex-1 text-center font-mono text-[9px] text-secondary uppercase tracking-widest" data-release-date={latest.release_date}>
                <span class="countdown-label">Releases {latest.release_date}</span>
              </div>
            )}
            <a href={`/store/music/${latest.slug}`} class="px-4 py-3 font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest transition-colors">
              Name your price &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="flex items-baseline gap-4 mb-6">
    <span class="font-mono text-xs text-secondary uppercase">Discography</span>
    <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
  </div>

  <div class="flex flex-wrap gap-2 mb-8" id="discog-filters" role="tablist" aria-label="Filter discography by type">
    {discogFilters.map(f => (
      <button
        type="button"
        class="discog-filter font-mono text-[10px] tracking-widest uppercase px-3 py-1.5 border transition-colors border-primary/20 text-primary hover:border-secondary hover:text-secondary"
        data-filter={f.value}
        aria-pressed={f.value === 'all' ? 'true' : 'false'}
      >
        {f.label} <span class="opacity-40 ml-0.5">{f.count}</span>
      </button>
    ))}
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4" id="discog-grid">
    {releases.map(release => (
      <div class="discog-card group relative bg-surface-container-low border border-white/5 transition-all duration-500 hover:border-secondary/30 terminal-glow" data-type={release.type}>
        <div class="relative overflow-hidden aspect-square">
          <a href={`/store/music/${release.slug}`} class="block w-full h-full">
            {release.artwork ? (
              <Artwork
                src={release.artwork}
                alt={release.title}
                sizes="(max-width: 767px) 50vw, (max-width: 1023px) 25vw, 17vw"
                class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-white/[0.03] to-white/[0.01] border-b border-white/5">
                <span class="font-mono text-[9px] text-white/20 tracking-widest uppercase">No artwork</span>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60 pointer-events-none"></div>
          </a>
          {firstPreviewBySlug[release.slug] && (
            <button
              type="button"
              data-preview-key={firstPreviewBySlug[release.slug]}
              data-preview-title={firstTrackTitleBySlug[release.slug]}
              data-preview-sub={release.title}
              data-preview-art={release.artwork}
              data-cart-slug={release.slug}
              data-cart-title={release.title}
              data-cart-type={release.type}
              data-cart-count={release.track_count}
              data-cart-cents={release.min_price_cents}
              data-cart-buyable={isBuyable(release) ? '1' : '0'}
              data-track-num={firstTrackNumBySlug[release.slug]}
              aria-label={`Play preview of ${firstTrackTitleBySlug[release.slug]}`}
              class="preview-btn absolute bottom-2 right-2 w-9 h-9 flex items-center justify-center bg-primary/90 text-on-primary hover:bg-secondary hover:text-on-secondary backdrop-blur-sm transition-all shadow-lg opacity-0 group-hover:opacity-100 focus:opacity-100"
            >
              <span class="material-symbols-outlined text-xl leading-none">play_arrow</span>
            </button>
          )}
        </div>
        <div class="p-4">
          <div class="flex items-baseline justify-between gap-2 mb-1">
            <a href={`/store/music/${release.slug}`} class="font-headline text-base text-primary group-hover:text-secondary transition-colors uppercase tracking-tight truncate">{release.title}</a>
            <span class="font-mono text-[8px] text-secondary shrink-0">{release.type.toUpperCase()}</span>
          </div>
          <div class="font-mono text-[9px] text-white/30 mb-3">{release.date}</div>
          <div class="flex flex-wrap gap-1 mb-4">
            {release.genre.map(g => (
              <span class="px-1.5 py-0.5 bg-white/5 text-[8px] font-mono text-primary border border-primary/10">#{g.toUpperCase()}</span>
            ))}
          </div>
          <button
            type="button"
            class="release-add-btn w-full py-2 border border-primary/20 hover:bg-primary hover:text-on-primary font-mono text-[9px] tracking-widest transition-all uppercase text-center text-primary disabled:opacity-30 disabled:cursor-not-allowed"
            data-slug={release.slug}
            data-title={release.title}
            data-image={release.artwork}
            data-min-cents={release.min_price_cents}
            data-track-count={release.track_count}
            data-type={release.type}
            data-live-label={`Add to cart · $${release.minPriceDollars}+`}
            disabled={!release.has_masters || (!!release.release_date && new Date(release.release_date) > new Date())}
          >
            {!release.has_masters
              ? 'Coming soon'
              : (!!release.release_date && new Date(release.release_date) > new Date())
                ? 'Coming soon'
                : `Add to cart · $${release.minPriceDollars}+`}
          </button>
          {release.release_date && new Date(release.release_date) > new Date() && (
            <div class="release-countdown mt-2 text-center font-mono text-[9px] text-secondary uppercase tracking-widest" data-release-date={release.release_date}>
              <span class="countdown-label">Releases {release.release_date}</span>
            </div>
          )}
          <a href={`/store/music/${release.slug}`} class="block text-center mt-2 font-mono text-[8px] text-white/30 hover:text-secondary uppercase tracking-widest transition-colors">
            Name your price &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>

  <script>
    import '../scripts/release-countdown.js';
    import '../scripts/cart.js';
    import '../scripts/preview-player.js';

    // Discography type filter (Singles / EPs / Albums).
    const ACTIVE = ['border-primary', 'bg-primary', 'text-on-primary'];
    const INACTIVE = ['border-primary/20', 'text-primary', 'hover:border-secondary', 'hover:text-secondary'];
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.discog-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.discog-card'));

    function applyFilter(value: string) {
      cards.forEach(card => {
        const show = value === 'all' || card.dataset.type === value;
        card.style.display = show ? '' : 'none';
      });
      filterBtns.forEach(btn => {
        const on = btn.dataset.filter === value;
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.remove(...ACTIVE, ...INACTIVE);
        btn.classList.add(...(on ? ACTIVE : INACTIVE));
      });
    }

    filterBtns.forEach(btn => btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'all')));
    applyFilter('all');

    document.querySelectorAll<HTMLButtonElement>('.release-add-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const minCents = parseInt(btn.dataset.minCents || '0', 10);
        const trackCount = parseInt(btn.dataset.trackCount || '0', 10);
        const type = btn.dataset.type || '';
        (window as any).morphicsCart.add({
          type: 'music',
          sku: `music:${btn.dataset.slug}`,
          title: btn.dataset.title,
          subtitle: `${type.toUpperCase()} · ${trackCount} track${trackCount === 1 ? '' : 's'} · digital`,
          image: btn.dataset.image,
          unit_amount: minCents,
          qty: 1,
          metadata: { release_slug: btn.dataset.slug },
        });
        const orig = btn.textContent;
        btn.textContent = '✓ Added';
        btn.classList.add('bg-secondary', 'text-on-secondary');
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove('bg-secondary', 'text-on-secondary');
        }, 1600);
      });
    });
  </script>

</BaseLayout>
