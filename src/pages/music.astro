---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../data/music-catalog.json';
import bandcamp from '../data/bandcamp-latest.json';

const releases = catalog.releases.map(r => ({
  ...r,
  artwork: r.artwork || null,
  date: r.release_date || '',
  genre: r.genre || [],
  minPriceDollars: ((r.min_price_cents || 0) / 100).toFixed(0),
}));

const latest = [...releases]
  .filter(r => r.date)
  .sort((a, b) => b.date.localeCompare(a.date))[0];
---

<BaseLayout title="MUSIC" currentPage="/music">
  <header class="mb-20">
    <h1 class="text-6xl md:text-8xl font-headline font-bold text-primary tracking-tighter leading-none mb-6">
      MUSIC
    </h1>
    <p class="max-w-xl text-on-surface-variant font-body leading-relaxed">
      Albums, EPs, and singles. Available on all platforms.
    </p>
  </header>

  <!-- Latest Release -->
  {latest && (
    <div class="mb-20 max-w-4xl">
      <div class="flex items-baseline gap-4 mb-6">
        <span class="font-mono text-xs text-secondary uppercase">Latest Release</span>
        <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
      </div>
      <div class="bg-surface-container-low border border-white/5 p-6">
        <iframe
          style="border: 0; width: 100%; height: 120px;"
          src={bandcamp.embedUrl}
          seamless
        >
          <a href={bandcamp.pageUrl}>{bandcamp.title} on Bandcamp</a>
        </iframe>
        <div class="flex items-center gap-3 mt-4">
          <button
            type="button"
            class="release-add-btn flex-1 py-3 border border-primary/30 hover:bg-primary hover:text-on-primary font-mono text-[10px] tracking-widest transition-all uppercase text-center text-primary disabled:opacity-30 disabled:cursor-not-allowed"
            data-slug={latest.slug}
            data-title={latest.title}
            data-image={latest.artwork}
            data-min-cents={latest.min_price_cents}
            data-track-count={latest.track_count}
            data-type={latest.type}
            disabled={!latest.has_masters}
          >
            {latest.has_masters ? `Add ${latest.title} to cart · $${latest.minPriceDollars}+` : 'Coming soon'}
          </button>
          <a href={`/store/music/${latest.slug}`} class="px-4 py-3 font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest transition-colors">
            Name your price &rarr;
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="flex items-baseline gap-4 mb-8">
    <span class="font-mono text-xs text-secondary uppercase">Discography</span>
    <div class="h-[1px] flex-1 bg-outline-variant/30"></div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
    {releases.map(release => (
      <div class="group relative bg-surface-container-low border border-white/5 transition-all duration-500 hover:border-secondary/30 terminal-glow">
        <a href={`/store/music/${release.slug}`} class="block relative overflow-hidden aspect-square">
          {release.artwork ? (
            <img
              src={release.artwork}
              alt={release.title}
              class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 group-hover:opacity-100 transition-all duration-700"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-white/[0.03] to-white/[0.01] border-b border-white/5">
              <span class="font-mono text-[9px] text-white/20 tracking-widest uppercase">No artwork</span>
            </div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent opacity-60 pointer-events-none"></div>
        </a>
        <div class="p-4">
          <div class="flex items-baseline justify-between gap-2 mb-1">
            <a href={`/store/music/${release.slug}`} class="font-headline text-base text-primary group-hover:text-secondary transition-colors uppercase tracking-tight truncate">{release.title}</a>
            <span class="font-mono text-[8px] text-secondary shrink-0">{release.type.toUpperCase()}</span>
          </div>
          <div class="font-mono text-[9px] text-white/30 mb-3">{release.date}</div>
          <div class="flex flex-wrap gap-1 mb-4">
            {release.genre.map(g => (
              <span class="px-1.5 py-0.5 bg-white/5 text-[8px] font-mono text-primary border border-primary/10">#{g.toUpperCase()}</span>
            ))}
          </div>
          <button
            type="button"
            class="release-add-btn w-full py-2 border border-primary/20 hover:bg-primary hover:text-on-primary font-mono text-[9px] tracking-widest transition-all uppercase text-center text-primary disabled:opacity-30 disabled:cursor-not-allowed"
            data-slug={release.slug}
            data-title={release.title}
            data-image={release.artwork}
            data-min-cents={release.min_price_cents}
            data-track-count={release.track_count}
            data-type={release.type}
            disabled={!release.has_masters}
          >
            {release.has_masters ? `Add to cart · $${release.minPriceDollars}+` : 'Coming soon'}
          </button>
          <a href={`/store/music/${release.slug}`} class="block text-center mt-2 font-mono text-[8px] text-white/30 hover:text-secondary uppercase tracking-widest transition-colors">
            Name your price &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>

  <script>
    import '../scripts/cart.js';
    document.querySelectorAll<HTMLButtonElement>('.release-add-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const minCents = parseInt(btn.dataset.minCents || '0', 10);
        const trackCount = parseInt(btn.dataset.trackCount || '0', 10);
        const type = btn.dataset.type || '';
        (window as any).morphicsCart.add({
          type: 'music',
          sku: `music:${btn.dataset.slug}`,
          title: btn.dataset.title,
          subtitle: `${type.toUpperCase()} · ${trackCount} track${trackCount === 1 ? '' : 's'} · digital`,
          image: btn.dataset.image,
          unit_amount: minCents,
          qty: 1,
          metadata: { release_slug: btn.dataset.slug },
        });
        const orig = btn.textContent;
        btn.textContent = '✓ Added';
        btn.classList.add('bg-secondary', 'text-on-secondary');
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove('bg-secondary', 'text-on-secondary');
        }, 1600);
      });
    });
  </script>

</BaseLayout>
