---
// Responsive image for anything under public/images/. Emits the WebP variants
// generated by scripts/generate-image-variants.mjs, falling back to the
// original file for browsers without WebP (and for images that have no
// variants yet, where it degrades to exactly the plain <img> it replaced).
//
// The variant list is resolved from disk at BUILD time rather than assumed, so
// a master too small to produce a given width never emits a 404'ing srcset
// entry — the generator skips upscales, and this skips them in lockstep.
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// Every width the generator can emit. The component probes the ladder and uses
// whatever actually exists for THIS file, rather than trusting a caller-supplied
// list — passing widths that a directory does not generate silently produced an
// empty srcset and fell back to the multi-megabyte master, which is exactly the
// bug this replaces.
const LADDER = [400, 480, 800, 960, 1200, 1600, 2400];

interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  /** Above the fold: load eagerly and hint high priority. Default is lazy. */
  priority?: boolean;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  class: className,
  sizes = '(max-width: 767px) 50vw, (max-width: 1023px) 25vw, 17vw',
  widths = LADDER,
  priority = false,
  loading,
} = Astro.props;

// Astro builds from the project root, and a compiled component's own
// import.meta.dirname points into the build output rather than at this file.
const PUBLIC = join(process.cwd(), 'public');
const dot = src.lastIndexOf('.');
const stem = dot > 0 ? src.slice(0, dot) : src;

const available = widths.filter((w) => existsSync(join(PUBLIC, `${stem}-${w}.webp`)));
const srcset = available.map((w) => `${stem}-${w}.webp ${w}w`).join(', ');
// Mid variant as the <img> src so a browser ignoring srcset still avoids the
// multi-megabyte master.
const fallback = available.length ? `${stem}-${available[Math.min(1, available.length - 1)]}.webp` : src;
---

{available.length ? (
  <picture>
    <source type="image/webp" srcset={srcset} sizes={sizes} />
    <img
      src={fallback}
      alt={alt}
      class={className}
      loading={loading ?? (priority ? 'eager' : 'lazy')}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading ?? (priority ? 'eager' : 'lazy')}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
)}
