---
// Circular framed avatar. Release art is square cover art; the crop and ring
// are what make a leaderboard read as people rather than as a discography.
//
// This is now a thin wrapper around src/scripts/avatar.js's avatarHtml() —
// the SAME function the three community pages' client scripts call to build
// this markup for fans fetched over the wire. It used to be the other way
// round: this component was a written spec that the client copies had to be
// kept in sync with by hand ("reviewed and accepted" duplication). Now there
// is one renderer; this component just calls it, so drift is structurally
// impossible rather than merely policed by comments.
import { avatarHtml } from '../scripts/avatar.js';

interface Props {
  avatar?: {
    name?: string;
    art_path?: string | null;
    style?: string | null;
    colourway?: string | null;
    artwork_key?: string | null;
  } | null;
  // Server-derived glyph letter — see the `glyph` field the API attaches
  // to every avatar object (functions/_lib/community/glyph.ts). Ignored
  // for legacy (style-less) avatars.
  glyphLetter?: string;
  size?: number;
  locked?: boolean;
  rarity?: number;
}
const { avatar = null, glyphLetter = 'm', size = 84, locked = false, rarity } = Astro.props;
const html = avatarHtml(avatar, glyphLetter, size, { locked, rarity });
---
<Fragment set:html={html} />
