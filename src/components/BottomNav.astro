---
const { currentPage = '' } = Astro.props;

const navItems = [
  { label: 'MUSIC', href: '/sonics', icon: 'graphic_eq' },
  { label: 'VISUALS', href: '/visuals', icon: 'grid_view' },
  { label: 'STORE', href: '/store', icon: 'storefront' },
  { label: 'SOCIAL', href: '/signal', icon: 'sensors' },
  { label: 'PLAYER', href: '/player', icon: 'play_circle' },
];
---

<nav class="fixed bottom-0 w-full flex justify-around items-center h-16 px-4 bg-[#0A0A0A]/90 backdrop-blur-xl border-t border-primary/10 shadow-[0_-10px_40px_rgba(0,0,0,0.8)] z-50 lg:hidden">
  {navItems.map(item => (
    <a
      href={item.href}
      class:list={[
        "flex flex-col items-center justify-center transition-colors",
        currentPage === item.href
          ? "text-primary scale-110 drop-shadow-[0_0_5px_#DBFCFF]"
          : "text-white/20 hover:text-secondary"
      ]}
    >
      <span class="material-symbols-outlined">{item.icon}</span>
      <span class="font-mono text-[8px] uppercase mt-1">{item.label}</span>
    </a>
  ))}
</nav>
