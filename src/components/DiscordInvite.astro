---
// The one place the Discord invite and its pitch live.
//
// Before this existed the invite appeared exactly once on the whole site — a
// bare URL string in social.astro, one icon in a row of social icons — and
// /account told people to "run /link in the Morphics Discord" without linking
// to it, naming a place and giving no way to reach it.
//
// Single source for the URL on purpose: pasting it into four pages would mean
// four places to update, and a stale invite fails SILENTLY. Nobody reports a
// link that quietly doesn't work; they just don't join.
//
// INVITE_URL is verified permanent (max_age=0, created against #rules, 76 uses
// at time of writing). Discord invites expire after 7 days by DEFAULT, so if
// this is ever regenerated, create the replacement with "never expire" or the
// site sprouts four dead links at once.
export const INVITE_URL = 'https://discord.gg/n2yaJMbTeD';

interface Props {
  /** 'card' is a standalone block; 'inline' sits inside an existing panel. */
  variant?: 'card' | 'inline';
  /** Overrides the default pitch where a page needs its own framing. */
  headline?: string;
  class?: string;
}

const { variant = 'card', headline, class: className = '' } = Astro.props;

// Leads with the payoff rather than the ask. "Join our Discord" is a request;
// this is a reason. Kept SHORT on purpose: the earlier copy explained the
// whole cross-platform mechanic in two sentences, which made a side note read
// like a feature announcement and took more space than the button it wraps.
// Nobody needs the mechanic to decide whether to join — they need the reason.
const DEFAULT_HEADLINE = 'Extra perks in Discord';
const BODY = 'Hanging out in the server levels up the same creature.';
---

{variant === 'card' ? (
  <aside class={`p-5 border border-white/10 rounded-[var(--radius-lg)] ${className}`}>
    <p class="font-mono text-[10px] uppercase tracking-widest text-secondary mb-2">
      {headline || DEFAULT_HEADLINE}
    </p>
    <p class="font-mono text-[11px] text-white/60 leading-relaxed mb-4">{BODY}</p>
    <a
      href={INVITE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors"
    >
      Join the Discord
    </a>
    <p class="font-mono text-[10px] text-white/40 mt-3 leading-relaxed">
      Once you're in, run <span class="text-white/70">/link</span> and paste the code on your account page.
    </p>
  </aside>
) : (
  <a
    href={INVITE_URL}
    target="_blank"
    rel="noopener noreferrer"
    class={`inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors ${className}`}
  >
    Join the Discord
  </a>
)}
