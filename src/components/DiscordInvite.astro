---
// The one place the Discord invite and its pitch live.
//
// Before this existed the invite appeared exactly once on the whole site — a
// bare URL string in social.astro, one icon in a row of social icons — and
// /account told people to "run /link in the Morphics Discord" without linking
// to it, naming a place and giving no way to reach it.
//
// Single source for the URL on purpose: pasting it into four pages would mean
// four places to update, and a stale invite fails SILENTLY. Nobody reports a
// link that quietly doesn't work; they just don't join.
//
// INVITE_URL is verified permanent (max_age=0, created against #rules, 76 uses
// at time of writing). Discord invites expire after 7 days by DEFAULT, so if
// this is ever regenerated, create the replacement with "never expire" or the
// site sprouts four dead links at once.
export const INVITE_URL = 'https://discord.gg/n2yaJMbTeD';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/* Deliberately just a link. This block used to be a card: headline, a
    sentence explaining that server activity feeds the same creature, and a
    footnote about running /link. All of that is better explained IN the
    Discord, where someone has already opted in and has the context to care —
    on the site it was a paragraph of mechanics sitting above the content
    people actually came for, and it took more room than the page's own
    header.

    Owner's call, 19 Aug 2026: keep the site's job to "here is the door" and
    let the server do the explaining. */}
<a
  href={INVITE_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-block font-mono text-[10px] uppercase tracking-widest text-white/40 hover:text-secondary border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full transition-colors ${className}`}
>
  Join the Discord
</a>
