---
const { currentPage = '' } = Astro.props;

const navItems = [
  { label: 'MUSIC',     href: '/music',     icon: 'graphic_eq' },
  { label: 'VISUALS',   href: '/visuals',   icon: 'grid_view' },
  { label: 'STORE',     href: '/store',     icon: 'storefront' },
  { label: 'SOCIAL',    href: '/social',    icon: 'sensors' },
  // "COMMUNITY" overlaps its neighbors at 320px in the tiny mobile label
  // size (text-[8px]) that five items force here — mobileLabel shortens it
  // for that row only. The route and desktop label are unchanged.
  { label: 'COMMUNITY', href: '/community', icon: 'diversity_3', mobileLabel: 'FANS' },
];
---

<header id="site-header" class="fixed top-0 w-full z-50 bg-[#0A0A0A]/85 backdrop-blur-2xl grid grid-cols-[auto_1fr_auto] items-center gap-3 px-4 md:px-8 py-3 md:py-6">
  <a href="/" class="flex-shrink-0 hover:scale-105 transition-all duration-[400ms]">
    <!-- The animated emblem is 956KB: 300 lossy frames at 30fps, and that size
         is inherent to the animation — re-encoding it smaller, with lossy alpha
         or with frame differencing, all came out no better than the original.
         At 956KB it was ~70% of the landing page's bytes and, on a slow
         connection, starved the wordmark: LCP 12s.
         So the mark paints immediately from its own first frame (6.6KB) and the
         animation is fetched only once the page has finished loading, then
         swapped in. Nothing about the emblem's appearance changes; the motion
         simply starts a beat later instead of the logo arriving late. Under
         prefers-reduced-motion the still is the final state. -->
    <img
      id="nav-emblem"
      data-no-round
      src="/images/logos/emblem-still.webp"
      data-anim="/images/logos/emblem-anim-30.webp"
      alt="Morphics"
      width="192"
      height="192"
      decoding="async"
      class="h-10 w-10 md:h-12 md:w-12 object-contain"
    />
  </a>

  <!-- Centered main nav. Mobile keeps cart inline at the right end of the
       row; desktop uses a true centered layout (grid middle column) with
       cart + sign-in living in the right cluster for balance. -->
  <nav class="flex items-center justify-around md:justify-center md:gap-14">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          "flex flex-col md:flex-row items-center md:gap-2 hover:text-primary hover:md:scale-105 transition-all duration-[400ms]",
          currentPage === item.href
            ? "text-primary drop-shadow-[0_0_5px_#00F0FF]"
            : "text-primary/50"
        ]}
      >
        <span class="material-symbols-outlined text-[22px] md:text-base leading-none">{item.icon}</span>
        <span class="md:hidden font-headline uppercase tracking-[0.2em] text-[8px] mt-1 leading-none">{item.mobileLabel || item.label}</span>
        <span class="hidden md:inline font-headline uppercase tracking-[0.2em] text-[0.75rem] leading-none">{item.label}</span>
      </a>
    ))}
    <!-- Mobile cart (inline with nav row). Desktop variant lives in the
         right cluster below so the centered nav stays balanced. -->
    <button
      type="button"
      data-cart-open
      aria-label="Open cart"
      class="md:hidden relative flex flex-col items-center text-primary/50 hover:text-primary transition-all duration-[400ms]"
    >
      <span class="material-symbols-outlined text-[22px] leading-none">shopping_bag</span>
      <span class="font-headline uppercase tracking-[0.2em] text-[8px] mt-1 leading-none">Cart</span>
      <span class="cart-badge hidden absolute -top-1 -right-2 min-w-[16px] h-[16px] px-1 bg-secondary text-on-secondary text-[9px] font-mono font-bold rounded-full items-center justify-center">0</span>
    </button>
  </nav>

  <!-- Desktop right cluster: Cart + Sign in. Hidden on mobile because
       the mobile cart sits inline in the nav row above. -->
  <div class="hidden md:flex items-center gap-6 flex-shrink-0">
    <button
      id="cart-button"
      type="button"
      data-cart-open
      aria-label="Open cart"
      class="relative flex flex-row items-center gap-2 text-primary/50 hover:text-primary hover:scale-105 transition-all duration-[400ms]"
    >
      <span class="material-symbols-outlined text-base leading-none">shopping_bag</span>
      <span class="font-headline uppercase tracking-[0.2em] text-[0.75rem] leading-none">Cart</span>
      <span id="cart-badge" class="cart-badge hidden absolute -top-1 -right-2 min-w-[16px] h-[16px] px-1 bg-secondary text-on-secondary text-[9px] font-mono font-bold rounded-full items-center justify-center">0</span>
    </button>
    <!-- href/label default to a neutral "Account" state, not "Sign in" — we
         cannot assert signed-out until the server definitively confirms it
         (see the script below and src/scripts/auth-state.js). -->
    <a id="account-link" href="/login" class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-white/40 hover:text-secondary transition-colors">
      <span class="material-symbols-outlined text-base">person</span>
      <span id="account-link-label">Account</span>
    </a>
  </div>
</header>

<script>
  import { decideAuthStateFromFetch } from '../scripts/auth-state.js';

  // Cart trigger wiring — kept out of inline onclick= so script-src can
  // drop 'unsafe-inline'. Both the mobile and desktop buttons carry the
  // [data-cart-open] hook and dispatch the same custom event the drawer
  // already listens for.
  document.querySelectorAll<HTMLButtonElement>('[data-cart-open]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('cart:open'));
    });
  });

  // Pull the animated emblem in only once everything else has landed, so its
  // ~1MB never competes with content for bandwidth. Decoded off-document first
  // so the swap cannot flash.
  const emblem = document.getElementById('nav-emblem') as HTMLImageElement | null;
  if (emblem && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () => {
      const anim = emblem.dataset.anim;
      if (!anim) return;
      const pre = new Image();
      pre.onload = () => { emblem.src = anim; };
      pre.src = anim;
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }

  const CACHE_KEY = 'morphics_auth_cache_v1';
  const accountLink = document.getElementById('account-link') as HTMLAnchorElement | null;
  const accountLabel = document.getElementById('account-link-label');

  function paint(state: 'signed-in' | 'signed-out' | 'unknown', email: string | null) {
    if (!accountLink || !accountLabel) return;
    if (state === 'signed-in') {
      accountLink.href = '/library';
      accountLabel.textContent = 'Library';
    } else if (state === 'signed-out') {
      accountLink.href = '/login';
      accountLabel.textContent = 'Sign in';
    } else {
      // Neutral: we don't know yet (or the check failed). Never assert
      // "Sign in" here — a valid 30-day session could still be sitting in
      // the browser. /login itself will sort out signed-in vs signed-out
      // on click, so pointing there is a safe, recoverable default.
      accountLink.href = '/login';
      accountLabel.textContent = 'Account';
    }
  }

  // Paint from the last known state on frame 1 so there is no "Sign in"
  // flash while the network round-trip to /api/auth/me is in flight.
  // localStorage can throw in Safari private mode — never let that break
  // the nav.
  try {
    const cached = localStorage.getItem(CACHE_KEY);
    if (cached) {
      const parsed = JSON.parse(cached);
      if (parsed && (parsed.state === 'signed-in' || parsed.state === 'signed-out')) {
        paint(parsed.state, parsed.email ?? null);
      }
    }
  } catch {}

  decideAuthStateFromFetch(fetch('/api/auth/me', { credentials: 'include' })).then(({ state, email }) => {
    paint(state, email);
    // Only a definitive answer is worth caching — caching 'unknown' would
    // let a stale rate-limit/error response poison the next page load's
    // first frame.
    if (state === 'signed-in' || state === 'signed-out') {
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ state, email }));
      } catch {}
    }
  });
</script>

