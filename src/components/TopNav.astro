---
const { currentPage = '' } = Astro.props;

const navItems = [
  { label: 'MUSIC', href: '/sonics' },
  { label: 'VISUALS', href: '/visuals' },
  { label: 'STORE', href: '/store' },
  { label: 'SOCIAL', href: '/signal' },
  { label: 'PLAYER', href: '/player' },
];
---

<header class="fixed top-0 w-full z-50 bg-[#0A0A0A]/80 backdrop-blur-2xl flex justify-between items-center px-8 py-6">
  <a href="/">
    <img src="/images/logos/morphics-text-white.png" alt="MORPHICS" class="h-6 w-auto" />
  </a>
  <nav class="hidden md:flex space-x-12">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          "font-headline uppercase tracking-[0.2em] text-[0.75rem] hover:text-primary hover:scale-105 transition-all duration-[400ms]",
          currentPage === item.href
            ? "text-primary drop-shadow-[0_0_5px_#00F0FF] border-b border-primary/30"
            : "text-primary/50"
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <div class="flex items-center space-x-4">
    <a href="/" class="hover:scale-105 transition-all duration-[400ms]">
      <img src="/images/logos/emblem-circle.png" alt="Morphics" class="h-12 w-12 object-contain" />
    </a>
  </div>
</header>
