---
const { currentPage = '' } = Astro.props;

const navItems = [
  { label: 'MUSIC', href: '/sonics' },
  { label: 'VISUALS', href: '/visuals' },
  { label: 'STORE', href: '/store' },
  { label: 'SOCIAL', href: '/social' },
  { label: 'PLAYER', href: '/player' },
];
---

<header class="fixed top-0 w-full z-50 bg-[#0A0A0A]/80 backdrop-blur-2xl flex justify-between items-center px-8 py-6">
  <a href="/">
    <img src="/images/logos/morphics-text-white.png" alt="MORPHICS" class="h-6 w-auto" />
  </a>
  <nav class="hidden md:flex space-x-12">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          "font-headline uppercase tracking-[0.2em] text-[0.75rem] hover:text-primary hover:scale-105 transition-all duration-[400ms]",
          currentPage === item.href
            ? "text-primary drop-shadow-[0_0_5px_#00F0FF] border-b border-primary/30"
            : "text-primary/50"
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <div class="flex items-center space-x-4">
    <a id="account-link" href="/login" class="hidden md:inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest text-white/40 hover:text-secondary transition-colors">
      <span class="material-symbols-outlined text-base">person</span>
      <span id="account-link-label">Sign in</span>
    </a>
    <a href="/" class="hover:scale-105 transition-all duration-[400ms]">
      <img src="/images/logos/emblem-circle.png" alt="Morphics" class="h-12 w-12 object-contain" />
    </a>
  </div>
</header>

<script>
  // If a session cookie is valid, the link points to /library and shows the
  // word "Library" instead of "Sign in".
  fetch('/api/auth/me', { credentials: 'include' })
    .then(r => r.json())
    .then((data: any) => {
      if (data && data.email) {
        const a = document.getElementById('account-link') as HTMLAnchorElement;
        const lbl = document.getElementById('account-link-label')!;
        a.href = '/library';
        lbl.textContent = 'Library';
      }
    })
    .catch(() => {});
</script>
