---
// Persistent Bandcamp-style player bar. Lives at the bottom of every page so
// the current preview is always visible and controllable. Driven entirely by
// src/scripts/preview-player.js (one shared <audio> element, one track at a
// time). Hidden until the first track is played, then stays put.
---

<!-- transition:persist is the whole point of this change: the bar (and the
     <audio> element preview-player.js creates and holds in module state)
     must survive navigation so a preview keeps playing as fans move around
     the site. preview-player.js's wireBar() binds its listeners directly to
     these elements exactly once; persisting them is what keeps those
     bindings — and playback — alive across every swap. -->
<div id="player-bar" class="player-bar is-hidden" aria-hidden="true" transition:persist>
  <div class="pb-inner">
    <div class="pb-meta">
      <a id="pb-art-link" class="pb-art-link" aria-label="Go to release">
        <img id="pb-art" class="pb-art" alt="" />
      </a>
      <div class="pb-text">
        <a id="pb-title" class="pb-title">—</a>
        <a id="pb-sub" class="pb-sub">PREVIEW</a>
      </div>
    </div>

    <button id="pb-prev" class="pb-skip" type="button" aria-label="Previous track" disabled>
      <span class="material-symbols-outlined">skip_previous</span>
    </button>

    <button id="pb-toggle" class="pb-toggle" type="button" aria-label="Play / pause">
      <span class="material-symbols-outlined">play_arrow</span>
    </button>

    <button id="pb-next" class="pb-skip" type="button" aria-label="Next track" disabled>
      <span class="material-symbols-outlined">skip_next</span>
    </button>

    <span id="pb-cur" class="pb-time">0:00</span>
    <div id="pb-wave-wrap" class="pb-wave-wrap" role="slider" aria-label="Seek" tabindex="0">
      <canvas id="pb-wave" class="pb-wave"></canvas>
    </div>
    <span id="pb-dur" class="pb-time">0:00</span>

    <div class="pb-volume">
      <button id="pb-mute" class="pb-mute" type="button" aria-label="Mute / unmute">
        <span class="material-symbols-outlined">volume_up</span>
      </button>
      <input id="pb-vol" class="pb-vol" type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
    </div>

    <button id="pb-cart" class="pb-cart" type="button" aria-label="Add to cart" hidden>
      <span class="material-symbols-outlined">add_shopping_cart</span>
      <span id="pb-cart-label" class="pb-cart-label">Add</span>
    </button>

    <button id="pb-close" class="pb-close" type="button" aria-label="Close player">
      <span class="material-symbols-outlined">close</span>
    </button>
  </div>
</div>

<style is:global>
  .player-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid rgba(125, 255, 179, 0.18);
    transition: transform 360ms cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
  }
  .player-bar.is-hidden {
    transform: translateY(110%);
    pointer-events: none;
  }

  .pb-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.6rem 1rem;
    height: 72px;
  }

  .pb-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 220px;
    min-width: 0;
    flex-shrink: 0;
  }
  .pb-art-link { display: block; flex-shrink: 0; line-height: 0; }
  .pb-art-link[href] { cursor: pointer; }
  .pb-art {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #1c1b1b;
    transition: border-color 160ms ease;
  }
  .pb-art-link[href]:hover .pb-art { border-color: rgba(125, 255, 179, 0.6); }
  .pb-text { min-width: 0; }
  .pb-title {
    display: block;
    font-family: "Rubik", sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: #dbfcff;
    font-size: 0.82rem;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .pb-title[href] { cursor: pointer; }
  .pb-title[href]:hover { color: #7dffb3; text-decoration: underline; text-underline-offset: 3px; }
  .pb-sub {
    display: block;
    font-family: "Geist Mono", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(125, 255, 179, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .pb-sub[href] { cursor: pointer; }
  .pb-sub[href]:hover { color: #7dffb3; text-decoration: underline; text-underline-offset: 2px; }

  .pb-toggle {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #dbfcff;
    color: #00363a;
    border: none;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease;
  }
  .pb-toggle:hover { background: #7dffb3; color: #003d1a; }
  .pb-toggle .material-symbols-outlined { font-size: 28px; line-height: 1; }
  .pb-toggle.is-loading .material-symbols-outlined { animation: pb-spin 900ms linear infinite; }
  @keyframes pb-spin { to { transform: rotate(360deg); } }

  .pb-skip {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    border: none;
    cursor: pointer;
    transition: color 160ms ease;
  }
  .pb-skip:hover:not(:disabled) { color: #7dffb3; }
  .pb-skip .material-symbols-outlined { font-size: 22px; }
  .pb-skip:disabled {
    color: rgba(255, 255, 255, 0.18);
    cursor: default;
  }
  .pb-skip:focus-visible { outline: 1px solid rgba(125, 255, 179, 0.5); outline-offset: 2px; }

  .pb-time {
    font-family: "Geist Mono", monospace;
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
    width: 34px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .pb-wave-wrap {
    flex: 1;
    height: 44px;
    min-width: 0;
    cursor: pointer;
    touch-action: none;
  }
  .pb-wave-wrap:focus-visible { outline: 1px solid rgba(125, 255, 179, 0.5); }
  .pb-wave { display: block; width: 100%; height: 100%; }

  .pb-volume {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .pb-mute {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    border: none;
    cursor: pointer;
    transition: color 160ms ease;
  }
  .pb-mute:hover { color: #7dffb3; }
  .pb-mute .material-symbols-outlined { font-size: 20px; }
  .pb-vol {
    -webkit-appearance: none;
    appearance: none;
    width: 72px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
    accent-color: #7dffb3;
    cursor: pointer;
    outline: none;
  }
  .pb-vol::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #7dffb3;
    border: none;
    cursor: pointer;
    transition: transform 120ms ease;
  }
  .pb-vol::-webkit-slider-thumb:hover { transform: scale(1.2); }
  .pb-vol::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #7dffb3;
    border: none;
    cursor: pointer;
  }
  .pb-vol::-moz-range-track {
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
  }
  .pb-vol:focus-visible { outline: 1px solid rgba(125, 255, 179, 0.5); outline-offset: 4px; }

  .pb-cart {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    height: 40px;
    padding: 0 0.9rem;
    background: transparent;
    border: 1px solid rgba(125, 255, 179, 0.35);
    color: #7dffb3;
    font-family: "Geist Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .pb-cart:hover { background: #7dffb3; color: #003d1a; }
  .pb-cart.is-added { background: #7dffb3; color: #003d1a; border-color: #7dffb3; }
  .pb-cart .material-symbols-outlined { font-size: 18px; }

  .pb-close {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: color 160ms ease;
  }
  .pb-close:hover { color: #7dffb3; }
  .pb-close .material-symbols-outlined { font-size: 20px; }

  @media (max-width: 640px) {
    .pb-meta { width: auto; flex: 1 1 0; }
    .pb-time { display: none; }
    .pb-wave-wrap { flex: 2 1 0; }
    .pb-inner { gap: 0.6rem; padding: 0.5rem 0.75rem; }
    .pb-cart { padding: 0 0.6rem; }
    .pb-cart-label { display: none; }
    .pb-vol { display: none; }
  }
</style>
