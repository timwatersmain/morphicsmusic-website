---
/**
 * The fan directory, extracted from src/pages/community/index.astro so that
 * /social can carry it without the markup or its script existing twice.
 *
 * Mounted in exactly ONE place per page: the script binds by element id
 * (dir-list, dir-more, ...), so a second instance on the same page would have
 * both scripts fighting over the first instance's nodes.
 *
 * The page heading that used to sit here went with the page. On /social this
 * is a section under a section heading, so the component renders only the
 * directory itself plus its own action cluster.
 */
---

  <div class="max-w-4xl">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <!-- The Discord invite used to sit here too. It lives on the profile page
           (community/me) instead — /social already links out to Discord from
           the platform grid at the foot, so a second invite in the middle of
           the directory was the same door offered twice on one page. -->
      <!-- Filled once the first page lands; the element is present from the
           start so the header does not jump when the number arrives. -->
      <div id="dir-total" class="font-mono text-[11px] text-secondary uppercase tracking-widest"></div>
      <!-- Hidden until the directory confirms a session. "Your profile" and
           the sign-up panel are the two halves of one answer, so they are
           driven by the SAME signal — the directory's own 200 vs 401 — rather
           than one being always-on and the other conditional. That is what let
           them appear together: a signed-out visitor was told to sign up AND
           offered a profile they do not have. -->
      <div id="dir-profile-link" class="hidden flex-wrap items-center gap-3">
        <a href="/community/me" class="font-mono text-[10px] text-white/40 hover:text-secondary uppercase tracking-widest border border-white/10 hover:border-secondary/30 px-4 py-2 rounded-full">
          Your profile
        </a>
      </div>
    </header>

    <div id="dir-loading" class="font-mono text-[11px] text-white/40">Loading the community…</div>

    <div id="dir-signin" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed mb-4">
        Sign in or sign up to join &amp; connect with the Morphics community.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/signup" data-astro-reload class="inline-block px-6 py-3 rounded-full bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors">
          Sign up
        </a>
        <!-- Secondary treatment: most people landing here already have an
             account, but the wall only grows if new ones are the loud option. -->
        <a href={`/login?redirect=${encodeURIComponent('/community')}`} data-astro-reload class="inline-block px-6 py-3 rounded-full border border-white/20 text-primary font-mono text-[11px] tracking-widest uppercase hover:border-secondary/40 hover:text-secondary transition-colors">
          Sign in
        </a>
      </div>
    </div>

    <div id="dir-empty" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p class="font-mono text-[11px] text-white/40 leading-relaxed">No fans on the wall yet — be the first.</p>
    </div>

    <div id="dir-error" class="hidden p-8 border border-white/10 rounded-[var(--radius-lg)] text-center">
      <p id="dir-error-msg" class="font-mono text-[11px] text-white/40 leading-relaxed"></p>
    </div>

    <div id="dir-content" class="hidden">
      <ul id="dir-list" class="divide-y divide-white/5 border-y border-white/5"></ul>
      <!-- Pages, not an ever-growing list. With the wall ordered by who was
           here most recently, "load more" would keep appending to a list whose
           top half has already gone stale — a page you can leave and come back
           to is the honest shape for that. -->
      <nav id="dir-pager" class="hidden mt-6 flex flex-wrap items-center justify-center gap-2" aria-label="Community pages"></nav>
    </div>
  </div>

  <script>
    import { creatureAvatarHtml } from '../scripts/sprites/creature-avatar.js';
    import { initCreatureCanvases } from '../scripts/sprites/renderer.js';
    import { STAGE_LABELS, rankLabelFor } from '../scripts/community/xp-progress';

    // Wrapped for astro:page-load — see music.astro's doc comment. This page
    // fetches fresh directory data on every arrival, so it must actually
    // re-run rather than execute once per session.
    document.addEventListener('astro:page-load', () => {
    const loading = document.getElementById('dir-loading')!;
    const signin = document.getElementById('dir-signin')!;
    const empty = document.getElementById('dir-empty')!;
    const errorBox = document.getElementById('dir-error')!;
    const errorMsg = document.getElementById('dir-error-msg')!;
    const content = document.getElementById('dir-content')!;
    const list = document.getElementById('dir-list')!;
    const pager = document.getElementById('dir-pager')!;
    const totalEl = document.getElementById('dir-total')!;
    const profileLink = document.getElementById('dir-profile-link')!;

    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));


    // STAGE_LABELS now comes from src/scripts/community/xp-progress.ts, which
    // itself imports it from the EP module — one source of stage names
    // shared with /community/me's rank section, so the two can't drift.
    // Takes the handle as well as the stage so the artist's row reads
    // "Morphics" here exactly as it does on his profile — see rankLabelFor.
    function stageLabel(stage: string, handle?: string) {
      return rankLabelFor(stage as any, handle);
    }
    function fmtDate(unix: number) {
      return new Date(unix * 1000).toLocaleDateString(undefined, { year: 'numeric', month: 'long' });
    }

    let page = 0;
    let total = 0;
    // 15 a page. The endpoint still caps at 40, so this is comfortably inside
    // it and stays one request per page.
    const limit = 15;

    // 32px, down from 40. The sprite art is natively 32x32 and the renderer
    // only ever draws at integer scale, so 40 was a 32px sprite centred in a
    // 40px frame — the extra 8px was empty ring, not more creature. At 32 the
    // art fills the frame exactly and every row loses 8px of height for free.
    const WALL_SIZE = 32;

    function renderFans(fans: any[], append: boolean) {
      const html = fans.map(f => `
        <li class="flex items-center gap-3 py-2">
          <span class="font-mono text-[10px] text-white/30 w-6 text-right shrink-0">${esc(f.position)}</span>
          ${creatureAvatarHtml(f.creature, WALL_SIZE)}
          <a href="/community/u/${encodeURIComponent(f.handle)}" class="flex-1 min-w-0 truncate font-headline text-base text-primary uppercase tracking-tight hover:text-secondary transition-colors">
            ${esc(f.display_name || f.handle)}
          </a>
          <!-- On ONE line with the name now, not stacked under it. The stacked
               form spent a whole second line on a joined-date almost nobody
               reads, which was most of the row's height. Dropped entirely
               below sm, where there is no room for it and the name matters
               more. -->
          <span class="hidden sm:block shrink-0 whitespace-nowrap font-mono text-[10px] text-white/30 uppercase tracking-widest w-36 text-right">${esc(fmtDate(f.fan_since))}</span>
          <span class="shrink-0 whitespace-nowrap font-mono text-[10px] text-secondary uppercase tracking-widest w-24 text-right">${esc(stageLabel(f.creature && f.creature.stage, f.handle))}</span>
        </li>
      `).join('');
      if (append) list.innerHTML += html;
      else list.innerHTML = html;
      initCreatureCanvases(list);
    }

    function renderPager() {
      const pages = Math.max(1, Math.ceil(total / limit));
      if (pages <= 1) { pager.classList.add('hidden'); return; }
      pager.classList.remove('hidden');

      // A window around the current page rather than every page number: at 50
      // members that is 4 buttons, at 5,000 it would be 334 and would wrap
      // into a wall of its own.
      const span = 2;
      const nums: (number | '…')[] = [];
      for (let i = 0; i < pages; i++) {
        if (i === 0 || i === pages - 1 || Math.abs(i - page) <= span) nums.push(i);
        else if (nums[nums.length - 1] !== '…') nums.push('…');
      }

      const btn = (label: string, target: number | null, current = false) => {
        if (target === null) return `<span class="px-2 font-mono text-[10px] text-white/20">${label}</span>`;
        const base = 'font-mono text-[10px] uppercase tracking-widest px-3 py-2 rounded-full border transition-colors';
        return current
          ? `<span aria-current="page" class="${base} border-primary bg-primary/10 text-primary">${label}</span>`
          : `<button type="button" data-page="${target}" class="${base} border-white/10 text-white/40 hover:text-secondary hover:border-secondary/30">${label}</button>`;
      };

      pager.innerHTML = [
        btn('Prev', page > 0 ? page - 1 : null),
        ...nums.map(n => (n === '…' ? btn('…', null) : btn(String(n + 1), n, n === page))),
        btn('Next', page < pages - 1 ? page + 1 : null),
      ].join('');

      pager.querySelectorAll<HTMLButtonElement>('button[data-page]').forEach(b => {
        b.addEventListener('click', () => {
          page = Number(b.dataset.page);
          load();
          // Back to the top of the list, not the top of the document — a page
          // change that leaves you looking at the pager you just clicked
          // reads as nothing having happened.
          list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    }

    function load() {
      fetch(`/api/community/directory?limit=${limit}&offset=${page * limit}`, { credentials: 'include' })
        .then(async r => {
          if (r.status === 401) {
            loading.classList.add('hidden');
            signin.classList.remove('hidden');
            // Belt and braces: it starts hidden, but a second load must not
            // leave it on from a previous signed-in render.
            profileLink.classList.add('hidden');
            return null;
          }
          if (!r.ok) throw new Error(await r.text());
          return r.json();
        })
        .then((data: any) => {
          if (!data) return;
          loading.classList.add('hidden');
          // A 200 IS the proof of a session — the endpoint requires one.
          signin.classList.add('hidden');
          profileLink.classList.remove('hidden');
          profileLink.classList.add('flex');

          total = typeof data.total === 'number' ? data.total : (data.fans || []).length;
          totalEl.textContent = total ? `${total} member${total === 1 ? '' : 's'}` : '';

          if (!data.fans || !data.fans.length) {
            content.classList.add('hidden');
            empty.classList.remove('hidden');
            return;
          }

          empty.classList.add('hidden');
          content.classList.remove('hidden');
          renderFans(data.fans, false);
          renderPager();
        })
        .catch(e => {
          loading.classList.add('hidden');
          errorBox.classList.remove('hidden');
          errorMsg.textContent = 'Could not load the community: ' + e.message;
        });
    }

    load();
    }); // end astro:page-load
  </script>
