---
// Slide-out cart drawer. The trigger button lives in TopNav.astro so the
// nav row reads as one cohesive bar; this file just renders the drawer.
---

<!-- transition:persist: same reasoning as ParticleBackground/PlayerBar — the
     drawer's own script (cart.js's DOM wiring below) only ever runs once
     per session under the client router, so the elements it bound
     (closeBtn, backdrop, itemsEl...) must stay the SAME nodes forever or
     those listeners go dead on the very first navigation. The trigger
     button lives in TopNav (re-rendered per page) and talks to this drawer
     only through the document-level 'cart:open' custom event, so it never
     needs a direct reference to survive. -->
<div
  id="cart-drawer"
  class="cart-drawer"
  aria-hidden="true"
  transition:persist
>
  <div id="cart-backdrop" class="cart-backdrop"></div>
  <aside class="cart-panel" id="cart-panel">
    <header class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-xs text-secondary uppercase">Cart</span>
        <span id="cart-count-text" class="font-mono text-[10px] text-white/40"></span>
      </div>
      <button id="cart-close" class="text-white/60 hover:text-primary" aria-label="Close cart">
        <span class="material-symbols-outlined">close</span>
      </button>
    </header>

    <div id="cart-items" class="flex-1 overflow-y-auto px-6 py-4 space-y-4"></div>

    <footer class="border-t border-white/10 px-6 py-5 space-y-4">
      <div class="flex items-baseline justify-between">
        <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Subtotal</span>
        <span id="cart-subtotal" class="font-headline text-2xl text-primary">$0.00</span>
      </div>
      <p class="font-mono text-[10px] text-white/40 leading-relaxed">
        Shipping calculated at checkout · Digital downloads delivered by email
      </p>
      <!-- The free-song token, offered at the LAST moment it is useful. The
           release page offers it too; someone who added to the cart and only
           then remembered they had one would otherwise have to navigate back.
           Hidden unless the cart holds music AND the server confirms an
           unspent token. -->
      <div id="cart-free-token" class="hidden p-3 border border-secondary/25 bg-secondary/[0.06] rounded-[var(--radius)]">
        <div class="font-mono text-[10px] text-secondary uppercase tracking-widest mb-2">You have a free track</div>
        <div class="flex flex-wrap gap-2">
          <label class="sr-only" for="cart-ft-track">Free track</label>
          <select id="cart-ft-track" class="flex-1 min-w-[10rem] px-2 py-2 bg-surface-container-low border border-white/10 focus:border-secondary outline-none font-mono text-[10px] text-primary rounded-[var(--radius)]"></select>
          <button type="button" id="cart-ft-redeem" class="px-3 py-2 border border-secondary/40 bg-secondary/10 hover:bg-secondary hover:text-on-secondary text-secondary font-mono text-[9px] tracking-widest uppercase rounded-full transition-colors">
            Get it free
          </button>
        </div>
        <p id="cart-ft-msg" class="font-mono text-[9px] text-white/40 mt-2 min-h-[0.9rem]" role="status" aria-live="polite"></p>
      </div>

      <button
        id="cart-checkout"
        class="block w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
        disabled
      >
        Checkout
      </button>
    </footer>
  </aside>
</div>

<style is:global>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
  }
  .cart-drawer.is-open { pointer-events: auto; }

  .cart-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 280ms ease;
  }
  .cart-drawer.is-open .cart-backdrop { opacity: 1; }

  .cart-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 100%;
    max-width: 28rem;
    background: var(--color-surface-container-low, #131319);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    /* Leading edge only — the other three sit flush against the viewport, so
       rounding them would just reveal the page behind in a thin sliver. */
    border-top-left-radius: var(--radius-2xl);
    border-bottom-left-radius: var(--radius-2xl);
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
    display: flex;
    flex-direction: column;
  }
  .cart-drawer.is-open .cart-panel { transform: translateX(0); }
</style>

<script>
  import '../scripts/cart.js';

  const drawer = document.getElementById('cart-drawer')!;
  const panel = document.getElementById('cart-panel')!;
  const backdrop = document.getElementById('cart-backdrop')!;
  const button = document.getElementById('cart-button')!;
  const closeBtn = document.getElementById('cart-close')!;
  const checkoutBtn = document.getElementById('cart-checkout') as HTMLButtonElement;
  const itemsEl = document.getElementById('cart-items')!;
  const subtotalEl = document.getElementById('cart-subtotal')!;
  // Both the mobile (inline) and desktop (right-cluster) cart buttons carry
  // a .cart-badge — update every match so they stay in sync.
  const badges = document.querySelectorAll<HTMLElement>('.cart-badge');
  const countText = document.getElementById('cart-count-text')!;

  const cart = (window as any).morphicsCart;

  function fmt(cents: number) {
    return '$' + (cents / 100).toFixed(2);
  }

  function open() {
    drawer.setAttribute('aria-hidden', 'false');
    drawer.classList.add('is-open');
  }
  function close() {
    drawer.setAttribute('aria-hidden', 'true');
    drawer.classList.remove('is-open');
  }

  // The button has an inline onclick that dispatches cart:open — relying on
  // the document-level listener below means even if module init races the
  // first click, the bubbled event reopens the drawer correctly.
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  // ── free-song token ──────────────────────────────────────────────────
  // Re-checked every time the drawer opens rather than once at load: the
  // token can be spent from a release page in the same session, and a stale
  // "you have one" here would send the fan into a refusal.
  const ftBox = document.getElementById('cart-free-token');
  const ftSelect = document.getElementById('cart-ft-track') as HTMLSelectElement | null;
  const ftBtn = document.getElementById('cart-ft-redeem') as HTMLButtonElement | null;
  const ftMsg = document.getElementById('cart-ft-msg');
  let ftArmed = false;

  function refreshFreeToken() {
    if (!ftBox || !ftSelect || !ftBtn || !ftMsg) return;
    const slugs = [...new Set(cart.items()
      .filter((i: any) => i.type === 'music' && i.metadata?.release_slug)
      .map((i: any) => i.metadata.release_slug as string))];
    if (!slugs.length) { ftBox.classList.add('hidden'); return; }

    fetch(`/api/free-token?slug=${encodeURIComponent(slugs.join(','))}`, { credentials: 'include' })
      .then(r => (r.ok ? r.json() : null))
      .then(d => {
        if (!d?.available || !d.tracks?.length) { ftBox.classList.add('hidden'); return; }
        // Prefixed with the release only when the cart holds more than one,
        // so a single-release cart does not repeat the title on every option.
        const many = slugs.length > 1;
        ftSelect.innerHTML = d.tracks.map((t: any) => {
          const label = many ? `${t.release} — ${t.label}` : t.label;
          return `<option value="${String(t.key).replace(/"/g, '&quot;')}">${String(label).replace(/</g, '&lt;')}</option>`;
        }).join('');
        ftArmed = false;
        ftBtn.disabled = false;
        ftBtn.textContent = 'Get it free';
        ftMsg.textContent = '';
        ftBox.classList.remove('hidden');
      })
      .catch(() => { ftBox.classList.add('hidden'); });
  }

  ftBtn?.addEventListener('click', async () => {
    if (!ftSelect || !ftMsg || !ftBtn) return;
    // Two-step, same as the release page. One track EVER behind a single
    // click is how it gets spent by accident.
    if (!ftArmed) {
      ftArmed = true;
      ftBtn.textContent = 'Tap again';
      ftMsg.textContent = 'Uses your one free track, permanently.';
      setTimeout(() => {
        if (!ftArmed) return;
        ftArmed = false;
        ftBtn.textContent = 'Get it free';
        ftMsg.textContent = '';
      }, 6000);
      return;
    }
    ftArmed = false;
    ftBtn.disabled = true;
    ftBtn.textContent = 'Claiming…';
    try {
      const res = await fetch('/api/free-token', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: ftSelect.value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        ftBtn.disabled = false;
        ftBtn.textContent = 'Get it free';
        ftMsg.textContent = data?.error === 'already spent'
          ? 'Already used your free track.'
          : data?.error === 'no token'
            ? 'Verify your email first.'
            : 'Could not claim that one.';
        return;
      }
      ftBtn.textContent = '✓ Yours';
      ftMsg.innerHTML = 'In <a href="/library" class="text-secondary underline">your library</a>. The cart is unchanged.';
    } catch {
      ftBtn.disabled = false;
      ftBtn.textContent = 'Get it free';
      ftMsg.textContent = 'Network error — try again.';
    }
  });

  document.addEventListener('cart:open', () => { open(); refreshFreeToken(); });
  console.log('[cart] wired:', { button: !!button, drawer: !!drawer, panel: !!panel });

  function render() {
    const items = cart.items();
    const count = cart.count();
    badges.forEach(b => {
      b.classList.toggle('hidden', count === 0);
      b.textContent = String(count);
    });
    countText.textContent = count === 0 ? 'Empty' : `${count} item${count === 1 ? '' : 's'}`;
    checkoutBtn.disabled = count === 0;
    subtotalEl.textContent = fmt(cart.subtotal());

    if (items.length === 0) {
      itemsEl.innerHTML = `
        <div class="flex flex-col items-center justify-center text-center py-16 text-white/30">
          <span class="material-symbols-outlined text-4xl mb-3">inventory_2</span>
          <p class="font-mono text-[11px] uppercase tracking-widest">Your cart is empty</p>
        </div>`;
      return;
    }

    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    const safeImg = (s: any) => {
      const v = String(s ?? '');
      return /^(https?:|\/)/.test(v) ? v : '';
    };
    itemsEl.innerHTML = items.map((i: any) => `
      <div class="flex gap-4 pb-4 border-b border-white/5 last:border-0">
        <img src="${esc(safeImg(i.image))}" alt="" class="w-16 h-16 object-cover bg-white/5 grayscale" />
        <div class="flex-1 min-w-0">
          <div class="font-headline text-sm text-primary uppercase tracking-tight truncate">${esc(i.title)}</div>
          ${i.subtitle ? `<div class="font-mono text-[10px] text-white/40 mt-0.5">${esc(i.subtitle)}</div>` : ''}
          <div class="flex items-center justify-between mt-2">
            <div class="flex items-center gap-2">
              <button data-qty-down="${esc(i.sku)}" class="w-6 h-6 border border-white/10 hover:border-primary/40 text-white/60 hover:text-primary text-xs">−</button>
              <span class="font-mono text-xs text-primary w-6 text-center">${esc(i.qty)}</span>
              <button data-qty-up="${esc(i.sku)}" class="w-6 h-6 border border-white/10 hover:border-primary/40 text-white/60 hover:text-primary text-xs">+</button>
            </div>
            <div class="font-mono text-xs text-secondary">${esc(fmt(i.unit_amount * i.qty))}</div>
          </div>
        </div>
        <button data-remove="${esc(i.sku)}" class="text-white/30 hover:text-red-400 self-start" aria-label="Remove">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
    `).join('');
  }

  itemsEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest('button');
    if (!btn) return;
    const up = btn.getAttribute('data-qty-up');
    const down = btn.getAttribute('data-qty-down');
    const rm = btn.getAttribute('data-remove');
    if (up) {
      const it = cart.items().find((x: any) => x.sku === up);
      if (it) cart.setQty(up, it.qty + 1);
    } else if (down) {
      const it = cart.items().find((x: any) => x.sku === down);
      if (it) cart.setQty(down, it.qty - 1);
    } else if (rm) {
      cart.remove(rm);
    }
  });

  checkoutBtn.addEventListener('click', () => cart.checkout());
  window.addEventListener('cart:updated', render);
  render();
</script>
