---
// Floating cart icon + slide-out drawer. Mount once in BaseLayout.
---

<button
  id="cart-button"
  class="fixed top-6 right-6 z-50 w-12 h-12 flex items-center justify-center bg-background/80 border border-white/10 backdrop-blur-md hover:border-secondary/40 transition-all group"
  aria-label="Open cart"
>
  <span class="material-symbols-outlined text-primary group-hover:text-secondary">shopping_bag</span>
  <span
    id="cart-badge"
    class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 bg-secondary text-on-secondary text-[10px] font-mono font-bold rounded-full flex items-center justify-center"
  >0</span>
</button>

<div
  id="cart-drawer"
  class="fixed inset-0 z-[60] pointer-events-none"
  aria-hidden="true"
>
  <div id="cart-backdrop" class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300"></div>
  <aside
    class="absolute top-0 right-0 h-full w-full max-w-md bg-surface-container-low border-l border-white/10 translate-x-full transition-transform duration-300 flex flex-col"
    id="cart-panel"
  >
    <header class="flex items-center justify-between px-6 py-5 border-b border-white/10">
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-xs text-secondary uppercase">Cart</span>
        <span id="cart-count-text" class="font-mono text-[10px] text-white/40"></span>
      </div>
      <button id="cart-close" class="text-white/60 hover:text-primary" aria-label="Close cart">
        <span class="material-symbols-outlined">close</span>
      </button>
    </header>

    <div id="cart-items" class="flex-1 overflow-y-auto px-6 py-4 space-y-4"></div>

    <footer class="border-t border-white/10 px-6 py-5 space-y-4">
      <div class="flex items-baseline justify-between">
        <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Subtotal</span>
        <span id="cart-subtotal" class="font-headline text-2xl text-primary">$0.00</span>
      </div>
      <p class="font-mono text-[10px] text-white/40 leading-relaxed">
        Shipping calculated at checkout · Digital downloads delivered by email
      </p>
      <button
        id="cart-checkout"
        class="block w-full py-4 bg-primary text-on-primary font-mono text-[11px] tracking-widest uppercase hover:bg-secondary hover:text-on-secondary transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
        disabled
      >
        Checkout
      </button>
    </footer>
  </aside>
</div>

<script>
  import '../scripts/cart.js';

  const drawer = document.getElementById('cart-drawer')!;
  const panel = document.getElementById('cart-panel')!;
  const backdrop = document.getElementById('cart-backdrop')!;
  const button = document.getElementById('cart-button')!;
  const closeBtn = document.getElementById('cart-close')!;
  const checkoutBtn = document.getElementById('cart-checkout') as HTMLButtonElement;
  const itemsEl = document.getElementById('cart-items')!;
  const subtotalEl = document.getElementById('cart-subtotal')!;
  const badge = document.getElementById('cart-badge')!;
  const countText = document.getElementById('cart-count-text')!;

  const cart = (window as any).morphicsCart;

  function fmt(cents: number) {
    return '$' + (cents / 100).toFixed(2);
  }

  function open() {
    drawer.setAttribute('aria-hidden', 'false');
    drawer.style.pointerEvents = 'auto';
    backdrop.style.opacity = '1';
    panel.style.transform = 'translateX(0)';
  }
  function close() {
    drawer.setAttribute('aria-hidden', 'true');
    drawer.style.pointerEvents = 'none';
    backdrop.style.opacity = '0';
    panel.style.transform = 'translateX(100%)';
  }

  button.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  document.addEventListener('cart:open', open);

  function render() {
    const items = cart.items();
    const count = cart.count();
    badge.classList.toggle('hidden', count === 0);
    badge.textContent = String(count);
    countText.textContent = count === 0 ? 'Empty' : `${count} item${count === 1 ? '' : 's'}`;
    checkoutBtn.disabled = count === 0;
    subtotalEl.textContent = fmt(cart.subtotal());

    if (items.length === 0) {
      itemsEl.innerHTML = `
        <div class="flex flex-col items-center justify-center text-center py-16 text-white/30">
          <span class="material-symbols-outlined text-4xl mb-3">inventory_2</span>
          <p class="font-mono text-[11px] uppercase tracking-widest">Your cart is empty</p>
        </div>`;
      return;
    }

    itemsEl.innerHTML = items.map((i: any) => `
      <div class="flex gap-4 pb-4 border-b border-white/5 last:border-0">
        <img src="${i.image || ''}" alt="" class="w-16 h-16 object-cover bg-white/5 grayscale" />
        <div class="flex-1 min-w-0">
          <div class="font-headline text-sm text-primary uppercase tracking-tight truncate">${i.title}</div>
          ${i.subtitle ? `<div class="font-mono text-[10px] text-white/40 mt-0.5">${i.subtitle}</div>` : ''}
          <div class="flex items-center justify-between mt-2">
            <div class="flex items-center gap-2">
              <button data-qty-down="${i.sku}" class="w-6 h-6 border border-white/10 hover:border-primary/40 text-white/60 hover:text-primary text-xs">−</button>
              <span class="font-mono text-xs text-primary w-6 text-center">${i.qty}</span>
              <button data-qty-up="${i.sku}" class="w-6 h-6 border border-white/10 hover:border-primary/40 text-white/60 hover:text-primary text-xs">+</button>
            </div>
            <div class="font-mono text-xs text-secondary">${fmt(i.unit_amount * i.qty)}</div>
          </div>
        </div>
        <button data-remove="${i.sku}" class="text-white/30 hover:text-red-400 self-start" aria-label="Remove">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
    `).join('');
  }

  itemsEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest('button');
    if (!btn) return;
    const up = btn.getAttribute('data-qty-up');
    const down = btn.getAttribute('data-qty-down');
    const rm = btn.getAttribute('data-remove');
    if (up) {
      const it = cart.items().find((x: any) => x.sku === up);
      if (it) cart.setQty(up, it.qty + 1);
    } else if (down) {
      const it = cart.items().find((x: any) => x.sku === down);
      if (it) cart.setQty(down, it.qty - 1);
    } else if (rm) {
      cart.remove(rm);
    }
  });

  checkoutBtn.addEventListener('click', () => cart.checkout());
  window.addEventListener('cart:updated', render);
  render();
</script>
