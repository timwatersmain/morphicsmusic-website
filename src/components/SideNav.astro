---
const { currentPage = '' } = Astro.props;

const navItems = [
  { label: 'SONICS', href: '/sonics', icon: 'graphic_eq' },
  { label: 'VISUALS', href: '/visuals', icon: 'grid_view' },
  { label: 'LABS', href: '/labs', icon: 'biotech' },
  { label: 'SIGNAL', href: '/signal', icon: 'sensors' },
];
---

<aside class="fixed left-0 top-0 h-screen w-64 hidden lg:flex flex-col border-r border-white/5 bg-[#131313] z-40">
  <div class="px-8 pt-24 mb-12">
    <div class="text-secondary font-bold text-lg font-headline tracking-tighter">NEURAL_OS</div>
    <div class="font-mono text-[10px] tracking-widest text-white/30 uppercase">VER 20.35.4</div>
  </div>
  <nav class="flex-1 space-y-1">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          "flex items-center gap-4 px-6 py-4 font-mono text-[10px] tracking-widest transition-all duration-[400ms]",
          currentPage === item.href
            ? "text-primary bg-gradient-to-r from-primary/10 to-transparent border-l-2 border-primary"
            : "text-white/30 hover:text-white/60 hover:bg-white/5"
        ]}
      >
        <span class="material-symbols-outlined">{item.icon}</span> {item.label}
      </a>
    ))}
  </nav>
  <div class="mt-auto p-6 space-y-4 border-t border-white/5">
    <div class="flex items-center gap-3 text-white/20 hover:text-primary transition-colors cursor-pointer font-mono text-[10px] tracking-widest uppercase">
      <span class="material-symbols-outlined text-sm">lock</span> ENCRYPT_SESSION
    </div>
    <div class="flex items-center gap-3 text-white/20 hover:text-primary transition-colors cursor-pointer font-mono text-[10px] tracking-widest uppercase">
      <span class="material-symbols-outlined text-sm">sync</span> SYNC_DATALAKE
    </div>
  </div>
</aside>
