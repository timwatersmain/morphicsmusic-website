---
// Mailing-list signup. Placed wherever someone has just decided they like
// something — the point of capture is the moment of interest, not a footer
// they scroll past.
//
// `source` is written onto the subscriber record so you can tell which
// placement actually earns signups. Give every instance a distinct one.
// `variant` changes the FRAME only — the row, the field, the button, the
// script and the endpoint are identical in all of them. That is the point:
// placement and prominence are a design decision that should not fork the
// behaviour, and a variant that reimplements the form is one that will drift.
type Variant = 'block' | 'panel' | 'band' | 'inline' | 'centred';

interface Props {
  source?: string;
  heading?: string;
  blurb?: string;
  title?: string;
  variant?: Variant;
  compact?: boolean;
}
const {
  source = 'site',
  heading = 'MONTHLY DISPATCH',
  title = 'One email a month',
  variant = 'block',
  blurb = 'New releases, what I\'m building, and where I\'m playing. Once a month. Nothing else.',
  compact = false,
} = Astro.props;
---

<div class:list={['subscribe-wrap', `subscribe-wrap--${variant}`]}>
  {variant !== 'inline' && !compact && (
    <div class="subscribe-copy">
      <div class="subscribe-kicker">{heading}</div>
      {(variant === 'panel' || variant === 'band' || variant === 'centred') && (
        <h3 class="subscribe-title">{variant === 'band' ? heading : title}</h3>
      )}
      <p class="subscribe-blurb">{blurb}</p>
    </div>
  )}

  <form class="subscribe-form" data-source={source} novalidate>
    <div class="subscribe-row">
      {variant === 'inline' && <span class="subscribe-inline-label">{heading}</span>}
      <label class="sr-only" for={`sub-email-${source}`}>Email address</label>
      <input
        id={`sub-email-${source}`}
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        required
        placeholder="you@example.com"
        class="subscribe-input"
      />
      {/* Honeypot: hidden from people, not from naive bots. aria-hidden and
          tabindex=-1 keep it out of the screen-reader and keyboard paths so it
          cannot trap a real person, and autocomplete=off stops a password
          manager helpfully filling it in and getting them silently dropped. */}
      <div class="subscribe-hp" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button type="submit" class="subscribe-btn">{variant === 'inline' ? '\u2192' : 'Subscribe'}</button>
    </div>
    {/* aria-live so the outcome is announced, not just painted — this is the
        only feedback the form gives. */}
    <p class="subscribe-msg" role="status" aria-live="polite"></p>
  </form>
</div>

<style>
  /* ── frames. Only the FRAME differs between variants. ─────────────── */
  .subscribe-kicker {
    font-family: var(--font-mono, monospace);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }
  .subscribe-title {
    font-family: var(--font-headline, sans-serif);
    text-transform: uppercase;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    line-height: 0.95;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    margin: 0 0 0.75rem;
  }
  .subscribe-blurb {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.4);
    max-width: 44ch;
    margin: 0;
  }
  .subscribe-copy { margin-bottom: 1.5rem; }

  /* B — a bordered panel. Reads as an offer rather than as page furniture. */
  .subscribe-wrap--panel {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    background: rgb(var(--glass-tint) / 0.45);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .subscribe-wrap--panel .subscribe-copy { margin-bottom: 0; flex: 1 1 18rem; }
  /* The row wraps at 14rem, so without a floor the field and button stack the
     moment the copy column takes its share. 22rem keeps them on one line and
     still collapses under the copy on a phone. */
  /* min-width belongs with the nowrap below, not here: 20rem is wider than
     the panel's whole inner width at 390px, so on its own it pushed the form
     out through the right edge. */
  .subscribe-wrap--panel .subscribe-form { flex: 0 1 26rem; min-width: 0; }
  /* The field must be allowed to SHRINK rather than push the button onto its
     own line. 14rem is the right basis when the row owns the page width and
     the wrong one inside a two-column panel. */
  .subscribe-wrap--panel .subscribe-input { flex: 1 1 9rem; }
  .subscribe-wrap--panel .subscribe-row { max-width: none; }
  /* nowrap only where there is room for it. Unscoped it forced the field and
     button onto one line at 390px too, and the button ran straight out
     through the panel's right edge. */
  @media (min-width: 640px) {
    .subscribe-wrap--panel .subscribe-form { min-width: 20rem; }
    .subscribe-wrap--panel .subscribe-row { flex-wrap: nowrap; }
  }

  /* C — rules top and bottom and nothing else. The most editorial: it borrows
     the page's own horizontal lines instead of adding another box. */
  .subscribe-wrap--band {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .subscribe-wrap--band .subscribe-copy { margin-bottom: 0; flex: 1 1 22rem; }
  .subscribe-wrap--band .subscribe-kicker { display: none; }
  .subscribe-wrap--band .subscribe-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 0.85; }
  .subscribe-wrap--band .subscribe-form { flex: 1 1 20rem; }

  /* D — one line. For a footer, or anywhere the page has said its piece and
     this is a postscript rather than an ask. */
  .subscribe-inline-label {
    align-self: center;
    font-family: var(--font-mono, monospace);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-secondary);
    white-space: nowrap;
    margin-right: 0.25rem;
  }
  .subscribe-wrap--inline .subscribe-row { max-width: 34rem; }
  .subscribe-wrap--inline .subscribe-btn { padding-inline: 1.1rem; font-size: 0.95rem; letter-spacing: 0; }

  /* E — centred, given room. Where it is the only thing being asked. */
  .subscribe-wrap--centred { text-align: center; padding-block: clamp(2rem, 5vw, 3.5rem); }
  .subscribe-wrap--centred .subscribe-blurb { margin-inline: auto; }
  .subscribe-wrap--centred .subscribe-row { margin-inline: auto; }

  .subscribe-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: stretch;
    max-width: 30rem;
  }

  .subscribe-input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.85rem 1rem;
    background: rgb(var(--glass-tint) / 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-primary);
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    border-radius: var(--radius);
    outline: none;
  }
  .subscribe-input:focus { border-color: var(--color-secondary); }
  .subscribe-input::placeholder { color: rgba(255, 255, 255, 0.25); }

  .subscribe-btn {
    padding: 0.85rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-secondary) 40%, transparent);
    background: color-mix(in srgb, var(--color-secondary) 10%, transparent);
    color: var(--color-secondary);
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 240ms, color 240ms;
  }
  .subscribe-btn:hover:not(:disabled) {
    background: var(--color-secondary);
    color: var(--color-on-secondary);
  }
  .subscribe-btn:disabled { opacity: 0.4; cursor: default; }

  /* Off-screen rather than display:none — a bot reading the DOM sees a normal
     field, which is the whole trick. */
  .subscribe-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .subscribe-msg {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.75rem;
    min-height: 1rem;
    color: var(--color-secondary);
  }
  .subscribe-msg[data-error] { color: #ff9a8a; }
</style>

<script>
  // astro:page-load, not top level: bundled scripts run once per session under
  // the client router, so a top-level binding would leave the form dead on
  // every page reached by soft navigation.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLFormElement>('.subscribe-form').forEach(form => {
      if (form.dataset.wired) return;
      form.dataset.wired = '1';

      const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      const hp = form.querySelector<HTMLInputElement>('input[name="website"]')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const msg = form.querySelector<HTMLParagraphElement>('.subscribe-msg')!;

      const say = (text: string, isError = false) => {
        msg.textContent = text;
        if (isError) msg.setAttribute('data-error', '');
        else msg.removeAttribute('data-error');
      };

      form.addEventListener('submit', async e => {
        e.preventDefault();
        const email = input.value.trim();
        // Checked here only to save a round trip on an obvious typo. The
        // server validates independently and does not trust this.
        if (!email || !/^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(email)) {
          say('That address looks wrong', true);
          input.focus();
          return;
        }

        btn.disabled = true;
        say('Subscribing…');
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email,
              source: form.dataset.source || 'site',
              website: hp.value,
            }),
          });
          if (res.status === 429) {
            say('Too many tries — wait a few minutes', true);
            btn.disabled = false;
            return;
          }
          if (!res.ok) {
            say('That address was rejected', true);
            btn.disabled = false;
            return;
          }
          // Intentionally identical whether or not they were already on the
          // list: the endpoint does not distinguish, so that a stranger cannot
          // use this form to test whether an address is subscribed.
          form.querySelector('.subscribe-row')?.setAttribute('hidden', '');
          say('Check your inbox — you\'re on the list');
        } catch {
          say('Network error — try again', true);
          btn.disabled = false;
        }
      });
    });
  });
</script>
